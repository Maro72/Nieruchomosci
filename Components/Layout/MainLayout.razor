@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore.Metadata.Internal

@using Mieszkaniec.Services
@using Mieszkaniec.Components.UI
@using MudBlazor
@using Color = MudBlazor.Color
@inject NavigationManager Navigation
@inject IDbConnectionService DbService
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider PositionClass="Defaults.Classes.Position.TopCenter" />
<MudPopoverProvider />

<MudLayout>
    @* ── GÓRNA BELKA ── *@
    <MudAppBar Elevation="0" Fixed="true" Dense="true" Style="background-color: #ffffff; color: #19324b; border-bottom: 1px solid #d8e4ef;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@DrawerToggle" />

        <MudText Typo="Typo.subtitle1" Class="ml-2 fw-bold" Style="color: #17324d;">
            BORYSZEW NIERUCHOMOŚCI<span class="text-primary">.</span>
        </MudText>

        @if (!string.IsNullOrEmpty(NazwaBiezacejStrony))
        {
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                     Size="Size.Small" Class="mx-1" Color="Color.Default" />
            <MudText Typo="Typo.body2" Class="fw-bold text-uppercase"
                     Style="letter-spacing: 1px; color: #637b91;">
                @NazwaBiezacejStrony
            </MudText>
        }

        <MudSpacer />

        <div class="d-flex align-items-center gap-4">

            @* --- BLOK ZALOGOWANEGO UŻYTKOWNIKA --- *@
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center pe-3 me-2" style="border-right: 1px solid #d8e4ef;">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Class="me-2 fw-bold text-white">
                            @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </MudAvatar>
                        <div class="d-flex flex-column justify-content-center">
                            <MudText Typo="Typo.body2" Class="fw-bold mb-0" Style="line-height: 1.1; color: #19324b;">
                                @context.User.Identity?.Name
                            </MudText>
                            <MudLink Href="/wyloguj" Typo="Typo.caption" Color="Color.Error" Underline="Underline.Hover">
                                Wyloguj się
                            </MudLink>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Class="me-3 fw-bold">
                        Zaloguj się
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>

            @* --- WSKAŹNIK STANU BAZY DANYCH --- *@
            <div class="d-flex align-items-center gap-2 me-3 px-3 py-1 rounded"
                 style="background-color: @(isOnline ? "rgba(34, 197, 94, 0.1)" : "rgba(239, 68, 68, 0.1)"); border: 1px solid @(isOnline ? "#22c55e" : "#ef4444");">
                <div style="width: 10px; height: 10px; border-radius: 50%; background-color: @(isOnline ? "#22c55e" : "#ef4444");"></div>
                <MudText Typo="Typo.body2"
                         Style="@($"color: {(isOnline ? "#16a34a" : "#dc2626")}; font-weight: 600;")">
                    MySql: @(isOnline ? "Połączono" : "Rozłączono")
                </MudText>
            </div>

        </div>
    </MudAppBar>

    @* ── MENU BOCZNE ── *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2"
               ClipMode="DrawerClipMode.Always"
               Variant="@DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    @* ── GŁÓWNA TREŚĆ ── *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="py-4 d-flex flex-column"
                      Style="min-height: calc(100vh - 48px);">
            <div class="flex-grow-1">
                @if (!isOnline)
                {
                    <div class="d-flex justify-content-center my-5">
                        <MudCard Class="p-5 shadow text-center border-danger" Style="max-width: 500px;">
                            <MudText Typo="Typo.h4" Color="Color.Error" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Large" Class="me-2" /> Brak połączenia
                            </MudText>
                            <MudText Typo="Typo.body1" Color="Color.Dark" Class="mb-2">
                                Aplikacja nie może nawiązać stabilnego połączenia z bazą danych MySQL.
                            </MudText>
                            <MudText Typo="Typo.body2" Class="small text-muted mb-4">
                                Upewnij się, że lokalny serwer bazy danych (np. XAMPP) jest uruchomiony, a parametry w pliku konfiguracyjnym są poprawne.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="SprawdzPolaczenieRecznie">
                                Ponów próbę połączenia
                            </MudButton>
                        </MudCard>
                    </div>
                }
                else
                {
                    @Body
                }
            </div>

            @* ── STOPKA ── *@
            <MudPaper Elevation="0" Class="mt-auto px-4 py-3 border-top bg-transparent">
                <div class="d-flex flex-wrap justify-content-between align-items-center w-100 gap-3">
                    <div class="d-flex align-items-center gap-3 border-end pe-4">
                        <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Zarządca</div>
                        <div class="small fw-bold text-nowrap">Boryszew Nieruchomości Sp. z o.o.</div>
                        <div class="small text-muted d-none d-lg-block text-nowrap" style="font-size: 0.8rem;">ul. Marii Curie-Skłodowskiej 73, Toruń</div>
                    </div>
                    <div class="d-flex align-items-center gap-2 border-end pe-4">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Primary" Size="Size.Small" />
                        <a href="tel:566561423" class="text-decoration-none fw-bold small text-nowrap" style="color: inherit;">
                            56 656 1423
                        </a>
                    </div>
                    <div class="d-flex align-items-center gap-4">
                        <div class="small text-danger text-uppercase fw-bold d-none d-sm-block" style="font-size: 0.7rem;">
                            Pogotowie Awaryjne
                        </div>
                        <div class="d-flex gap-3">
                            <a href="tel:502064516" class="text-danger fw-bold small text-decoration-none text-nowrap">
                                <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Class="me-1" /> 502 064 516
                            </a>
                            <a href="tel:533679336" class="text-danger fw-bold small text-decoration-none text-nowrap">
                                533 679 336
                            </a>
                        </div>
                    </div>
                </div>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string NazwaBiezacejStrony { get; set; } = "";
    private bool isOnline = true;

    private MudTheme _theme = new MudTheme()
    {
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px"
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#1e6fa8",
            PrimaryContrastText = "#ffffff",
            Background = "#f4f8fc",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#19324b",
            DrawerIcon = "#1e6fa8",
            TextPrimary = "#19324b",
            TextSecondary = "#637b91",
            Divider = "#d8e4ef"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        WyznaczNazweStrony();

        // Połączenie sprawdzamy TYLKO RAZ – przy uruchomieniu aplikacji
        isOnline = await DbService.CanConnectAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        WyznaczNazweStrony();
        InvokeAsync(StateHasChanged);
    }

    private void WyznaczNazweStrony()
    {
        var sciezka = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();

        if (sciezka.StartsWith("usterki")) NazwaBiezacejStrony = "Usterka";
        else if (sciezka.StartsWith("przeglady")) NazwaBiezacejStrony = "Przeglądy";
        else if (sciezka.StartsWith("slownik")) NazwaBiezacejStrony = "Terminy";
        else if (sciezka.StartsWith("obiekty") || sciezka.StartsWith("fbudynki") || sciezka.StartsWith("flubudynki")) NazwaBiezacejStrony = "Budynki";
        else if (sciezka.StartsWith("remonty")) NazwaBiezacejStrony = "Remonty";
        else if (sciezka.StartsWith("umowy")) NazwaBiezacejStrony = "Umowy";
        else NazwaBiezacejStrony = "";
    }

    private async Task SprawdzPolaczenieRecznie()
    {
        isOnline = await DbService.CanConnectAsync();
        StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}