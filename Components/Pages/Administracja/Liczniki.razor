@page "/administracja/liczniki"
@attribute [Authorize(Policy = "Liczniki.Odczyt")]
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@using Mieszkaniec.Components.Pages.Liczniki
@using Mieszkaniec.Components.UI
@using MudBlazor
@inject ILicznikService LicznikService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Administracja licznikami</PageTitle>

<div class="pa-4">
    @if (liczniki is null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <FGrid TItem="Licznik"
               Title="Administracja licznikami"
               Items="@liczniki.OrderBy(x => x.Obiekt?.Nazwa).ThenBy(x => x.NumerLicznika)"
               GridKey="@gridKey"
               CrudPolicy="Liczniki.Edycja"
               @bind-SelectedItem="wybranyLicznik"
               ShowToolbar="true"
               ShowSearch="true"
               OnAdd="DodajLicznik"
               OnEdit="EdytujLicznik">
            <ToolbarLeftContent>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-none d-md-block">
                    Liczniki wody, ciepła i energii oraz przypisane budynki.
                </MudText>
            </ToolbarLeftContent>
            <GridColumns>
                <PropertyColumn T="Licznik" TProperty="string" Property="x => x.NumerLicznika" Title="Numer licznika" />
                <TemplateColumn T="Licznik" Title="Budynek">
                    <CellTemplate Context="ctx">
                        @(ctx.Item.Obiekt?.Nazwa ?? "Nieprzypisany")
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="Licznik" TProperty="string" Property="x => x.Typ" Title="Typ" />
                <TemplateColumn T="Licznik" Title="Uwagi">
                    <CellTemplate Context="ctx">
                        @(string.IsNullOrWhiteSpace(ctx.Item.Uwagi) ? "-" : ctx.Item.Uwagi)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Licznik" Title="Status">
                    <CellTemplate Context="ctx">
                        <MudChip T="string" Size="Size.Small" Color="@(ctx.Item.CzyAktywny ? Color.Success : Color.Default)">
                            @(ctx.Item.CzyAktywny ? "Aktywny" : "Nieczynny")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </GridColumns>
        </FGrid>
    }
</div>

@code {
    private List<Licznik>? liczniki;
    private Licznik? wybranyLicznik;
    private int gridKey;

    protected override async Task OnInitializedAsync()
    {
        await OdswiezListe();
    }

    private async Task OdswiezListe()
    {
        liczniki = await LicznikService.PobierzWszystkieLicznikiAsync();
        wybranyLicznik = null;
        gridKey++;
    }

    private async Task DodajLicznik()
    {
        var dialog = await DialogService.ShowAsync<LicznikDialog>("Dodaj licznik");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Licznik licznik)
        {
            await LicznikService.DodajLicznikAsync(licznik);
            Snackbar.Add("Licznik został dodany.", Severity.Success);
            await OdswiezListe();
        }
    }

    private async Task EdytujLicznik(Licznik licznik)
    {
        var kopia = new Licznik
        {
            Id = licznik.Id,
            NumerLicznika = licznik.NumerLicznika,
            Typ = licznik.Typ,
            ObiektId = licznik.ObiektId,
            Obiekt = licznik.Obiekt,
            Uwagi = licznik.Uwagi,
            CzyAktywny = licznik.CzyAktywny,
            DataDodania = licznik.DataDodania
        };

        var dialog = await DialogService.ShowAsync<LicznikDialog>(
            "Edytuj licznik",
            new DialogParameters { ["Licznik"] = kopia });
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Licznik zaktualizowanyLicznik)
        {
            await LicznikService.AktualizujLicznikAsync(zaktualizowanyLicznik);
            Snackbar.Add("Licznik został zaktualizowany.", Severity.Success);
            await OdswiezListe();
        }
    }
}
