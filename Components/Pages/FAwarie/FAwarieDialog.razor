@namespace Mieszkaniec.Components.Pages.FAwarie
@using Mieszkaniec.Model.Entities
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using System.IO

<MudDialog @bind-Visible="IsVisible" Options="DialogOptions" Class="modern-dialog-window">
<TitleContent>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="pa-2">
        <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
            <MudIcon Icon="@Icons.Material.Filled.Build" />
        </MudAvatar>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">@(Model?.Id == 0 ? "Rejestracja Awarii" : "Edycja Zgłoszenia")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Szczegóły usterki i informacje konserwatora</MudText>
        </MudStack>
    </MudStack>
</TitleContent>
<DialogContent>
    @if (Model != null)
    {
        <EditForm Model="@Model" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2" Class="px-3 pb-2">

                @* --- ROW 1 --- *@
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="Model.ObiektId" Label="Nieruchomość / Budynek"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Model.CzyArchiwum"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Apartment">
                        <MudSelectItem T="int" Value="0">Wybierz budynek...</MudSelectItem>
                        @foreach (var ob in ListaObiektow)
                        {
                            <MudSelectItem T="int" Value="@ob.Id">@ob.Nazwa</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="Model.RodzajUsterkiId" Label="Kategoria usterki"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Model.CzyArchiwum"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Build">
                        <MudSelectItem T="int" Value="0">Wybierz kategorię...</MudSelectItem>
                        @foreach (var r in ListaRodzajow)
                        {
                            <MudSelectItem T="int" Value="@r.Id">@r.Nazwa</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* --- ROW 2 --- *@
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="Model.Status" Label="Status zgłoszenia"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Model.CzyArchiwum"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Assignment">
                        <MudSelectItem T="string" Value="@string.Empty">Wybierz status...</MudSelectItem>
                        @foreach (var st in OpcjeStatusow)
                        {
                            <MudSelectItem T="string" Value="@st">@st</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="Model.PriorytetUsterkiId" Label="Priorytet (SLA)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Model.CzyArchiwum"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PriorityHigh">
                        <MudSelectItem T="int" Value="0">Wybierz priorytet...</MudSelectItem>
                        @foreach (var p in ListaPriorytetow)
                        {
                            <MudSelectItem T="int" Value="@p.Id">@p.Nazwa</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="DataZgloszeniaMud" Label="Data wpłynięcia"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   DateFormat="dd.MM.yyyy" Editable="true"
                                   Disabled="@Model.CzyArchiwum"
                                   Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                </MudItem>

                @* --- ROW 3 --- *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.OsobaZglaszajaca" Label="Lokator / Osoba zgłaszająca"
                                  Placeholder="np. Jan Kowalski" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Disabled="@Model.CzyArchiwum"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                </MudItem>

                @* --- ROW 4 --- *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.OpisZgłoszenia" Label="Szczegóły problemu (opis mieszkańca)"
                                  Placeholder="Wpisz treść zgłoszenia..." Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Lines="2"
                                  Disabled="@Model.CzyArchiwum" />
                </MudItem>

                @* --- ROW 5 (REALIZACJA) --- *@
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" />
                            <MudText Typo="Typo.subtitle2">Realizacja i zamknięcie</MudText>
                        </MudStack>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudDatePicker @bind-Date="DataZakonczeniaMud" Label="Data usunięcia awarii"
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               DateFormat="dd.MM.yyyy" Editable="true" Clearable="true"
                                               Disabled="@Model.CzyArchiwum"
                                               Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EventAvailable" />
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="Model.UwagiKonserwatora"
                                              Label="Uwagi konserwatora / Zużyte materiały"
                                              Placeholder="Zapisz komentarz z naprawy..."
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Disabled="@Model.CzyArchiwum" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                @* --- ROW 6 (PLIKI) --- *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Dołącz protokół / skan (PDF, JPG)</MudText>
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnUploadFiles"
                                   Accept=".pdf,.jpg,.jpeg" Disabled="Model.CzyArchiwum" Class="w-100">
                        <CustomContent Context="uploadContext">
                            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.AttachFile"
                                       Disabled="@Model.CzyArchiwum"
                                       OnClick="@uploadContext.OpenFilePickerAsync">
                                Wybierz pliki
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                </MudItem>

                @if (Model.Zalaczniki != null && Model.Zalaczniki.Any())
                {
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @foreach (var z in Model.Zalaczniki)
                        {
                            @if (Model.CzyArchiwum)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile"
                                         Color="Color.Default" Variant="Variant.Outlined">
                                    @z.NazwaPliku
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile"
                                         Color="Color.Default" Variant="Variant.Outlined"
                                         OnClose="() => UsunZalacznik(z)">
                                    @z.NazwaPliku
                                </MudChip>
                            }
                        }
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    }
</DialogContent>
<DialogActions>
    <MudButton Variant="Variant.Text" Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">
        Anuluj
    </MudButton>
    @if (Model != null && !Model.CzyArchiwum)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="Save">
            Zapisz
        </MudButton>
    }
</DialogActions>
</MudDialog>

<style>
.modern-dialog-window .mud-dialog {
    border-radius: 12px !important;
}
</style>