@namespace Mieszkaniec.Components.Pages.FPrzeglady
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@using System.IO
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3 custom-dialog-header">
            <div class="p-2 rounded bg-light border text-success shadow-sm">
                <i class="bi bi-calendar2-check fs-4"></i>
            </div>
            <div>
                <h5 class="m-0 fw-bold text-dark">@(IsRealizeMode ? "Zamykanie i Realizacja Przeglądu" : (Model.Id == 0 ? "Planowanie Przeglądu" : "Edycja Terminu"))</h5>
                <small class="text-muted">Przypisanie i archiwizacja kontroli technicznej obiektu</small>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <div class="container-fluid px-1 pt-2 pb-1">
                <div class="row g-0">

                    @* 1. WYBÓR BUDYNKU *@
                    <div class="col-12 mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Wybierz Nieruchomość</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-building text-muted"></i></span>
                            <select class="form-select border-start-0" style="border-left: none;" @bind="Model.ObiektId" disabled="@IsRealizeMode" required>
                                <option value="0">Wybierz budynek...</option>
                                @foreach (var ob in ListaObiektow)
                                {
                                    <option value="@ob.Id">@ob.Nazwa</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* 2. WYBÓR TYPU *@
                    <div class="col-12 mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Typ Przeglądu (Reguła)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-sliders text-muted"></i></span>
                            <select class="form-select border-start-0" style="border-left: none;" @bind="Model.TerminDefinicjaId" disabled="@IsRealizeMode" required>
                                <option value="0">Wybierz typ z definicji...</option>
                                @foreach (var def in ListaDefinicji)
                                {
                                    <option value="@def.Id">@def.NazwaTypu</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* 3. DATA WYKONANIA *@
                    <div class="col-md-6 mb-3 pe-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Data Wykonania</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event text-muted"></i></span>
                            <input type="date" class="form-control border-start-0" style="border-left: none;" @bind="Model.DataWykonania" required />
                        </div>
                    </div>

                    @* 4. OCENA TECHNICZNA *@
                    <div class="col-md-6 mb-3 ps-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Ocena Techniczna</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-clipboard-check text-muted"></i></span>
                            <select class="form-select border-start-0" style="border-left: none;" @bind="Model.WynikOcena">
                                <option value="">Wybierz wynik...</option>
                                @foreach (var oc in OpcjeOceny)
                                {
                                    <option value="@oc">@oc</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* 5. INSPEKTOR / REPREZENTANT *@
                    <div class="col-12 mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Inżynier / Inspektor / Firma realizująca</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-badge text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" style="border-left: none;" @bind="Model.OsobaWykonujaca" placeholder="np. inż. Jan Kowalski" maxlength="255" />
                        </div>
                    </div>

                    @* 6. UPLOADER PLIKU PROTOKOŁU *@
                    <div class="col-12 mb-1">
                        <label class="form-label small fw-semibold text-secondary mb-1 d-block">Dołącz Protokół / Skan (PDF, JPG)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-file-earmark-arrow-up"></i></span>
                            <InputFile OnChange="@OnInputFileChange" class="form-control border-start-0" style="border-left: none; padding-top: 5px;" />
                        </div>
                        @if (!string.IsNullOrEmpty(WybranyPlikNazwa))
                        {
                            <div class="text-success small mt-1 fw-semibold d-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i> Przygotowano: @WybranyPlikNazwa (@WybranyPlikRozmiarKB KB)
                            </div>
                        }
                    </div>

                </div>
            </div>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-content-end gap-2 pe-4 pb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" Size="Size.Small" Class="border text-dark px-3" OnClick="Cancel">Anuluj</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Size="Size.Small" Class="px-4" OnClick="Submit">Zapisz</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Inject] protected IObiektService ObiektService { get; set; } = default!;
    [Inject] protected ITerminDefinicjaService DefiniceService { get; set; } = default!;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Przeglad Model { get; set; } = new();
    [Parameter] public bool IsRealizeMode { get; set; }

    protected List<Obiekt> ListaObiektow { get; set; } = new();
    protected List<TerminDefinicja> ListaDefinicji { get; set; } = new();
    protected List<string> OpcjeOceny { get; set; } = new() { "Pozytywny", "Pozytywny z uwagami", "Negatywny" };

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _wybranyPlik;
    protected string WybranyPlikNazwa = string.Empty;
    protected long WybranyPlikRozmiarKB = 0;

    protected override async Task OnInitializedAsync()
    {
        ListaObiektow = await ObiektService.GetAllActiveAsync();
        ListaDefinicji = await DefiniceService.GetAllActiveAsync();
    }

    private void OnInputFileChange(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _wybranyPlik = e.File;
        if (_wybranyPlik != null)
        {
            WybranyPlikNazwa = _wybranyPlik.Name;
            WybranyPlikRozmiarKB = _wybranyPlik.Size / 1024;
        }
    }

    private async Task Submit()
    {
        if (Model.ObiektId == 0 || Model.TerminDefinicjaId == 0) return;

        // Wyliczanie daty następnego przeglądu (zostaje bez zmian)
        var definicja = ListaDefinicji.FirstOrDefault(d => d.Id == Model.TerminDefinicjaId);
        if (definicja != null && definicja.CzestoscMiesiace.HasValue)
        {
            Model.DataNastepnego = Model.DataWykonania.AddMonths(definicja.CzestoscMiesiace.Value);
        }
        else
        {
            Model.DataNastepnego = Model.DataWykonania.AddYears(1);
        }

        // --- ZMIANA: NOWA ŚCIEŻKA ZAPISU DO KATALOGU SHARED ---
        if (_wybranyPlik != null)
        {
            try
            {
                // Budujemy ścieżkę wskazującą bezpośrednio na katalog Root/Shared/uploads
                var katalogSharedUploads = Path.Combine(Directory.GetCurrentDirectory(), "Shared", "uploads");

                if (!Directory.Exists(katalogSharedUploads))
                    Directory.CreateDirectory(katalogSharedUploads);

                var unikalnaNazwa = $"{Guid.NewGuid()}_{_wybranyPlik.Name}";
                var pelnaSciezka = Path.Combine(katalogSharedUploads, unikalnaNazwa);

                // Zapisujemy strumień fizycznie w nowej lokalizacji Shared
                await using var fs = new FileStream(pelnaSciezka, FileMode.Create);
                await _wybranyPlik.OpenReadStream(maxAllowedSize: 5242880).CopyToAsync(fs);

                var nowyZalacznik = new Zalacznik
                {
                    NazwaPliku = _wybranyPlik.Name,
                    SciezkaMagazyn = pelnaSciezka, // Ścieżka na dysku zaktualizuje się automatycznie
                    RozmiarKB = (int)WybranyPlikRozmiarKB,
                    DataDodania = DateTime.Now
                };
                Model.Zalaczniki.Add(nowyZalacznik);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Błąd fizycznego zapisu pliku w Shared: {ex.Message}");
            }
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}

<style>
    /* Dopasowanie systemowego krzyżyka zamykającego MudBlazor do jasnego nagłówka */
    ::deep .mud-dialog-title .mud-button-root {
        color: rgba(0, 0, 0, 0.54) !important;
        margin-top: 8px !important;
        margin-right: 8px !important;
    }

        ::deep .mud-dialog-title .mud-button-root:hover {
            color: rgba(0, 0, 0, 0.87) !important;
            background-color: rgba(0, 0, 0, 0.04) !important;
        }
</style>