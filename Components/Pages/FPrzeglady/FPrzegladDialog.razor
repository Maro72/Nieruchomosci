@namespace Mieszkaniec.Components.Pages.FPrzeglady
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<MudDialog Class="review-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="pa-2">
            <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(IsRealizeMode ? "Zamykanie i Realizacja Przeglądu" : (Model.Id == 0 ? "Planowanie Przeglądu" : "Edycja Terminu"))</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Przypisanie i archiwizacja kontroli technicznej obiektu</MudText>
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="Model">

            <MudGrid Spacing="2" Class="pt-2 pb-1">

                    @* 1. WYBÓR BUDYNKU *@
                    <MudItem xs="12">
                        <MudSelect T="int" @bind-Value="Model.ObiektId" Label="Wybierz nieruchomość"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsRealizeMode"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Apartment">
                            <MudSelectItem T="int" Value="0">Wybierz budynek...</MudSelectItem>
                            @foreach (var ob in ListaObiektow)
                            {
                                <MudSelectItem T="int" Value="@ob.Id">@ob.Nazwa</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @* 2. WYBÓR TYPU *@
                    <MudItem xs="12">
                        <MudSelect T="int" @bind-Value="Model.TerminDefinicjaId" Label="Typ przeglądu (reguła)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsRealizeMode"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tune">
                            <MudSelectItem T="int" Value="0">Wybierz typ z definicji...</MudSelectItem>
                            @foreach (var def in ListaDefinicji)
                            {
                                <MudSelectItem T="int" Value="@def.Id">@def.NazwaTypu</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @* 3. DATA WYKONANIA *@
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="DataWykonaniaPicker"
                                       Label="Data wykonania"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="dd.MM.yyyy"
                                       Editable="true"
                                       Required="true"
                                       RequiredError="Data wykonania jest wymagana"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                       Class="review-date-picker" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="Model.NumerProtokołu"
                                      Label="Nr protokołu"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="100"
                                      Placeholder="np. PROT/09/2026"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Description" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="Model.DataProtokołu"
                                       Label="Data protokołu"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="dd.MM.yyyy"
                                       Editable="true"
                                       Clearable="true"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Event"
                                       Class="review-date-picker" />
                    </MudItem>

                    @* 4. OCENA TECHNICZNA *@
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="Model.WynikOcena" Label="Ocena techniczna"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AssignmentTurnedIn">
                            <MudSelectItem T="string" Value="@string.Empty">Wybierz wynik...</MudSelectItem>
                            @foreach (var oc in OpcjeOceny)
                            {
                                <MudSelectItem T="string" Value="@oc">@oc</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @* 5. INSPEKTOR / REPREZENTANT *@
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.OsobaWykonujaca"
                                      Label="Inżynier / Inspektor / Firma realizująca"
                                      Placeholder="np. inż. Jan Kowalski"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="255"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.Uwagi"
                                      Label="Uwagi"
                                      Placeholder="Dodatkowe uwagi do przeglądu..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      AutoGrow="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Chat" />
                    </MudItem>

                    @* 6. UPLOADER PLIKU PROTOKOŁU *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Dołącz protokół / skan (PDF, JPG)</MudText>
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnInputFileChange" Accept=".pdf,.jpg,.jpeg">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.AttachFile">
                                    Wybierz plik
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (!string.IsNullOrEmpty(WybranyPlikNazwa))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                Przygotowano: @WybranyPlikNazwa (@WybranyPlikRozmiarKB KB)
                            </MudText>
                        }
                    </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="Submit">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] protected IObiektService ObiektService { get; set; } = default!;
    [Inject] protected ITerminDefinicjaService DefiniceService { get; set; } = default!;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Przeglad Model { get; set; } = new();
    [Parameter] public bool IsRealizeMode { get; set; }

    protected List<Obiekt> ListaObiektow { get; set; } = new();
    protected List<TerminDefinicja> ListaDefinicji { get; set; } = new();
    protected List<string> OpcjeOceny { get; set; } = new() { "Pozytywny", "Pozytywny z uwagami", "Negatywny" };

    private MudForm _form = default!;
    private IBrowserFile? _wybranyPlik;
    protected string WybranyPlikNazwa = string.Empty;
    protected long WybranyPlikRozmiarKB = 0;

    private DateTime? DataWykonaniaPicker
    {
        get => Model.DataWykonania;
        set
        {
            if (value.HasValue)
            {
                Model.DataWykonania = value.Value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ListaObiektow = await ObiektService.GetAllActiveAsync();
        ListaDefinicji = await DefiniceService.GetAllActiveAsync();
    }

    private Task OnInputFileChange(IBrowserFile file)
    {
        _wybranyPlik = file;
        if (_wybranyPlik != null)
        {
            WybranyPlikNazwa = _wybranyPlik.Name;
            WybranyPlikRozmiarKB = _wybranyPlik.Size / 1024;
        }

        return Task.CompletedTask;
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        if (Model.ObiektId == 0 || Model.TerminDefinicjaId == 0) return;

        // Wyliczanie daty następnego przeglądu (zostaje bez zmian)
        var definicja = ListaDefinicji.FirstOrDefault(d => d.Id == Model.TerminDefinicjaId);
        if (definicja != null && definicja.CzestoscMiesiace.HasValue)
        {
            Model.DataNastepnego = Model.DataWykonania.AddMonths(definicja.CzestoscMiesiace.Value);
        }
        else
        {
            Model.DataNastepnego = Model.DataWykonania.AddYears(1);
        }

        // --- ZMIANA: NOWA ŚCIEŻKA ZAPISU DO KATALOGU SHARED ---
        if (_wybranyPlik != null)
        {
            try
            {
                // Pliki przeglądów są serwowane z katalogu Shared/uploads pod adresem /uploads.
                var katalogSharedUploads = Path.Combine(Directory.GetCurrentDirectory(), "Shared", "uploads");

                if (!Directory.Exists(katalogSharedUploads))
                    Directory.CreateDirectory(katalogSharedUploads);

                var unikalnaNazwa = $"{Guid.NewGuid()}_{_wybranyPlik.Name}";
                var pelnaSciezka = Path.Combine(katalogSharedUploads, unikalnaNazwa);

                // Zapisujemy strumień fizycznie w nowej lokalizacji Shared
                await using var fs = new FileStream(pelnaSciezka, FileMode.Create);
                await _wybranyPlik.OpenReadStream(maxAllowedSize: 5242880).CopyToAsync(fs);

                var nowyZalacznik = new Zalacznik
                {
                    Przeglad = Model,
                    NazwaPliku = _wybranyPlik.Name,
                    SciezkaMagazyn = Path.Combine("uploads", unikalnaNazwa),
                    RozmiarKB = (int)WybranyPlikRozmiarKB,
                    DataDodania = DateTime.Now
                };
                Model.Zalaczniki.Add(nowyZalacznik);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Błąd fizycznego zapisu pliku w Shared: {ex.Message}");
            }
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}

<style>
    .review-date-picker {
        width: 100%;
    }

    /* Dopasowanie systemowego krzyżyka zamykającego MudBlazor do jasnego nagłówka */
    ::deep .mud-dialog-title .mud-button-root {
        color: rgba(0, 0, 0, 0.54) !important;
        margin-top: 8px !important;
        margin-right: 8px !important;
    }

        ::deep .mud-dialog-title .mud-button-root:hover {
            color: rgba(0, 0, 0, 0.87) !important;
            background-color: rgba(0, 0, 0, 0.04) !important;
        }
</style>