@page "/fprzeglady"
@attribute [Authorize(Policy = "OdczytBudynkow")]
@rendermode InteractiveServer
@namespace Mieszkaniec.Components.Pages.FPrzeglady
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Components.UI
@using MudBlazor

<div class="d-flex flex-column" style="height: calc(100vh - 64px); background-color: #f8fafc; overflow-y: auto;">

    @* ── NAGŁÓWEK MODUŁU ── *@
    <div class="px-4 pt-4 pb-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="bg-white shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center" style="color: #5a4bda;">
                <i class="bi bi-building-gear fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">Harmonogram Przeglądów Technicznych</h5>
                <small class="text-muted">Struktura przeglądów pogrupowana według budynków i obiektów</small>
            </div>
        </div>

        @* Przycisk Nowego Przeglądu i Eksportu (Wcześniej wbudowane w FGrid) *@
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-light border shadow-sm fw-bold px-3" @onclick="EksportujDoExcela">
                <i class="bi bi-file-earmark-excel text-success me-1"></i> Eksport Excel
            </button>
            <button type="button" class="btn btn-sm fw-bold px-3 text-white shadow-sm" style="background-color: #5a4bda;" @onclick="OpenCreateDialog">
                <i class="bi bi-plus-circle me-1"></i> Dodaj Przegląd
            </button>
        </div>
    </div>

    @* ── BELKA FILTRÓW I AKCJI EXTRA (ZINTEGROWANA W JEDEN PANEL) ── *@
    <MudPaper Class="mx-4 my-2 pa-3 border-light shadow-sm bg-white d-flex flex-wrap align-items-center justify-content-between gap-3" Elevation="0" Style="border-radius: 8px; border: 1px solid #e2e8f0;">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <MudSelect T="int?" Label="Budynek" Value="@FiltreObiektId" ValueChanged="OnObiektFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width: 180px; background-color: #f8f9fa;" Clearable="true">
                <MudSelectItem T="int?" Value="null">Wszystkie budynki</MudSelectItem>
                @foreach (var ob in ListaObiektow)
                {
                    <MudSelectItem T="int?" Value="@ob.Id">@ob.Nazwa</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Label="Typ Kontroli" Value="@FiltreDefinicjaId" ValueChanged="OnDefinicjaFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width: 180px; background-color: #f8f9fa;" Clearable="true">
                <MudSelectItem T="int?" Value="null">Wszystkie typy</MudSelectItem>
                @foreach (var def in ListaDefinicji)
                {
                    <MudSelectItem T="int?" Value="@def.Id">@def.NazwaTypu</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Label="Status Pilności" Value="@FiltreStatus" ValueChanged="OnStatusFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width: 160px; background-color: #f8f9fa;" Disabled="@PokazArchiwum" Clearable="true">
                <MudSelectItem T="string" Value="null">Wszystkie statusy</MudSelectItem>
                @foreach (var st in OpcjeStatusow)
                {
                    <MudSelectItem T="string" Value="@st">@st</MudSelectItem>
                }
            </MudSelect>

            @if (FiltreObiektId.HasValue || FiltreDefinicjaId.HasValue || !string.IsNullOrEmpty(FiltreStatus))
            {
                <button type="button" class="btn btn-sm text-danger fw-semibold d-flex align-items-center gap-1 border ms-1 px-2" @onclick="ResetujFiltry" style="height: 32px; border-radius: 4px; background-color: #fff5f5;">
                    <i class="bi bi-x-circle"></i> Wyczyść
                </button>
            }
        </div>

        <div class="d-flex align-items-center gap-3 py-1">
            <div class="d-flex align-items-center">
                <span class="small fw-bold me-2 @(!PokazArchiwum ? "text-primary" : "text-muted")" style="cursor:pointer; user-select:none; font-size: 0.85rem;" @onclick="() => PrzelaczWidokArchiwum(false)">Aktualne</span>
                <MudSwitch T="bool" Value="@PokazArchiwum" ValueChanged="PrzelaczWidokArchiwum" Color="Color.Primary" Dense="true" />
                <span class="small fw-bold ms-1 @(PokazArchiwum ? "text-primary" : "text-muted")" style="cursor:pointer; user-select:none; font-size: 0.85rem;" @onclick="() => PrzelaczWidokArchiwum(true)">Archiwalne</span>
            </div>

            <div style="width: 1px; height: 18px; background-color: #dee2e6;"></div>

            <button type="button" class="btn btn-sm btn-link text-secondary p-1 border-0 d-flex align-items-center justify-content-center rounded-circle hover-bg-light" @onclick="OdswiezDane" title="Odśwież listę bazy" style="width:32px; height:32px;">
                <i class="bi bi-arrow-clockwise fs-5"></i>
            </button>
        </div>
    </MudPaper>

    <div class="px-4 pt-1">
        <div class="status-summary" aria-label="Podsumowanie statusów przeglądów">
            <span class="status-summary-label">Szybki filtr:</span>
            <button type="button" class="status-chip status-chip-danger" @onclick="PokazPrzeterminowane">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>@LiczbaPrzeterminowanych</strong>
                <span>przeterminowanych</span>
            </button>
            <button type="button" class="status-chip status-chip-warning" @onclick="PokazZblizajaceSie">
                <i class="bi bi-clock-fill"></i>
                <strong>@LiczbaZblizajacychSie</strong>
                <span>zbliżających się</span>
            </button>
            <button type="button" class="status-chip status-chip-success" @onclick="PokazAktualne">
                <i class="bi bi-check-circle-fill"></i>
                <strong>@LiczbaAktualnych</strong>
                <span>aktualnych</span>
            </button>
            @if (!string.IsNullOrEmpty(FiltreStatus))
            {
                <button type="button" class="status-summary-clear" @onclick="ResetujFiltry">
                    <i class="bi bi-x-circle"></i> pokaż wszystkie
                </button>
            }
        </div>
    </div>

    @* ── WIDOK WŁAŚCIWY: GRUPOWANIE AKORDEONOWE PO BUDYNKACH ── *@
    <div class="px-4 pb-4 pt-2">
        @if (ListaPrzegladow == null || !ListaPrzegladow.Any())
        {
            <div class="text-center py-5 bg-white border rounded shadow-sm">
                <i class="bi bi-folder-x fs-1 text-muted d-block mb-2"></i>
                <span class="text-muted">Brak rekordów przeglądów spełniających wybrane kryteria.</span>
            </div>
        }
        else
        {
            <MudExpansionPanels @ref="PaneleBudynkow" MultiExpansion="true" Elevation="1" Rounded="true" Class="gap-2 d-flex flex-column">
                @* Wykorzystujemy potężne grupowanie LINQ bezpośrednio w pętli widoku *@
                @foreach (var grupaBudynku in ListaPrzegladow.GroupBy(p => p.ObiektId).OrderBy(g => g.First().Obiekt?.Nazwa))
                {
                    var obiekt = grupaBudynku.First().Obiekt;
                    var przegladyBudynku = grupaBudynku.ToList();

                    <MudExpansionPanel Style="border: 1px solid #e2e8f0; border-radius: 8px !important; overflow: hidden; background-color: #ffffff;">
                        <TitleContent>
                            <div class="d-flex align-items-center justify-content-between w-100 pe-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light p-2 rounded text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-building fs-5"></i>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold mb-0 text-dark" Style="font-size: 1rem;">
                                            Budynek: @(obiekt?.Nazwa ?? "Nieprzypisany kod obiektu")
                                        </MudText>
                                        <small class="text-muted" style="font-size: 0.78rem;">
                                            <i class="bi bi-geo-alt me-1"></i> @(obiekt?.Adres ?? "Brak określonego adresu")
                                        </small>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-secondary border px-2 py-1.5 rounded-pill" style="font-size: 0.78rem;">
                                        Wykaz pozycji: <b>@przegladyBudynku.Count</b>
                                    </span>
                                    @if (przegladyBudynku.Any(p => WyznaczStatusTekst(p) == "Przeterminowany"))
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1.5 rounded-pill shadow-sm" style="font-size: 0.75rem; font-weight: 600;">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Wymaga uwagi
                                        </span>
                                    }
                                </div>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @* Tabela wewnętrzna z przeglądami wybranego budynku *@
                            <div class="pt-1 pb-2 px-1">
                                <div class="table-responsive border rounded shadow-inner bg-white">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light text-secondary">
                                            <tr>
                                                <th class="ps-3" style="width: 150px; text-align: center;">Status</th>
                                                <th>Typ Przeglądu / Kontroli</th>
                                                <th style="text-align: center; width: 130px;">Ostatni Przegląd</th>
                                                <th style="text-align: center; width: 180px;">Następny Termin</th>
                                                <th style="text-align: center; width: 100px;">Załączniki</th>
                                                <th style="text-align: center; width: 120px;">Akcje</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in przegladyBudynku)
                                            {
                                                @* Wyróżnienie wiersza tła przy kliknięciu (WybranyPrzeglad) *@
                                                <tr class="@(WybranyPrzeglad?.Id == p.Id ? "table-primary hover-bg-light" : "")" @onclick="() => WybierzWiersz(p)" style="cursor: pointer;">
                                                    <td class="text-center ps-2">
                                                        <span class="custom-badge @WyznaczStatusKlasa(p)">
                                                            <i class="bi bi-circle-fill me-1.5" style="font-size: 0.38rem;"></i>
                                                            @WyznaczStatusTekst(p)
                                                        </span>
                                                    </td>
                                                    <td class="fw-medium text-dark">
                                                        @(p.TerminDefinicja?.NazwaTypu ?? "-")
                                                    </td>
                                                    <td class="text-center text-muted">
                                                        @p.DataWykonania.ToString("yyyy-MM-dd")
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="fw-bold text-dark">@p.DataNastepnego.ToString("yyyy-MM-dd")</span>
                                                        <small class="text-muted d-block" style="font-size: 0.73rem; font-weight: 500;">
                                                            @WyznaczDniTekst(p)
                                                        </small>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (p.Zalaczniki != null && p.Zalaczniki.Any())
                                                        {
                                                            <div @onclick:stopPropagation="true" class="d-flex justify-content-center">
                                                                <div class="badge bg-light text-danger border p-1.5 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm hover-primary"
                                                                     style="cursor: pointer; transition: 0.2s; border-radius: 6px;"
                                                                     title="Zobacz załączniki PDF"
                                                                     @onclick="() => PokazZalacznikiDialog(p.Zalaczniki)">
                                                                    <i class="bi bi-file-earmark-pdf-fill fs-6"></i>
                                                                    @if (p.Zalaczniki.Count > 1)
                                                                    {
                                                                        <span class="fw-bold ms-0.5" style="font-size: 0.8rem;">@p.Zalaczniki.Count</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center" @onclick:stopPropagation="true">
                                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                                            @* Przycisk Edycji *@
                                                            <button type="button" class="btn btn-sm p-1 text-primary hover-bg-light rounded" title="Edytuj parametry" @onclick="() => OpenEditDialog(p)">
                                                                <i class="bi bi-pencil-square fs-6"></i>
                                                            </button>

                                                            @* Przycisk Archiwizacji / Zrealizowania *@
                                                            @if (p.Status != "Wykonany")
                                                            {
                                                                <button type="button" class="btn btn-sm p-1 text-muted hover-primary rounded" title="Zrealizuj i archiwizuj" @onclick="() => OpenRealizeDialog(p)">
                                                                    <i class="bi bi-archive fs-6"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-check-all text-success fs-5" title="Zarchiwizowany"></i>
                                                            }

                                                            @* Przycisk Usuwania *@
                                                            <button type="button" class="btn btn-sm p-1 text-danger hover-bg-light rounded" title="Usuń trwale" @onclick="() => RequestDelete(p)">
                                                                <i class="bi bi-trash fs-6"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </div>
</div>

<PotwierdzenieDialog IsVisible="IsConfirmVisible" Title="@ConfirmTitle" Message="@ConfirmMessage" ThemeClass="@ConfirmTheme" IconClass="@ConfirmIcon" OnAnswer="HandleConfirmationAnswer" />

<style>
    .custom-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        font-size: 0.75rem;
        border-radius: 50px;
        text-transform: uppercase;
        vertical-align: middle;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .badge-sukces {
        background-color: #e2f6ed !important;
        color: #157347 !important;
        border: 1px solid #a3cfbb;
    }

    .badge-ostrzezenie {
        background-color: #fff3cd !important;
        color: #a16207 !important;
        border: 1px solid #ffe69c;
    }

    .badge-alarm {
        background-color: #f8d7da !important;
        color: #bb2d3b !important;
        border: 1px solid #f5c2c7;
    }

    .hover-primary:hover {
        color: #0d6efd !important;
    }

    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }

    .shadow-inner {
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
    }

    .status-summary {
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        color: #64748b;
        font-size: 0.78rem;
    }

    .status-summary-label {
        font-weight: 600;
        margin-right: 2px;
    }

    .status-chip,
    .status-summary-clear {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 28px;
        padding: 3px 9px;
        border: 1px solid;
        border-radius: 5px;
        background: #fff;
        font-size: 0.76rem;
        line-height: 1;
        cursor: pointer;
    }

    .status-chip:hover,
    .status-summary-clear:hover {
        filter: brightness(0.97);
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.1);
    }

    .status-chip-danger { color: #b02a37; border-color: #f5c2c7; background: #fff8f8; }
    .status-chip-warning { color: #997404; border-color: #ffe69c; background: #fffdf4; }
    .status-chip-success { color: #157347; border-color: #a3cfbb; background: #f7fcf9; }
    .status-summary-clear { color: #64748b; border-color: #cbd5e1; }

    @@media (max-width: 576px) {
        .status-summary-label {
            width: 100%;
        }
    }
</style>
