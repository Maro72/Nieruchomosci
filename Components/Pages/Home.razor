@page "/"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize]

<PageTitle>Boryszew Nieruchomości</PageTitle>

<div class="welcome-page">
    <!-- Dekoracyjne tło -->
    <div class="welcome-bg" aria-hidden="true">
        <div class="bg-orb bg-orb--1"></div>
        <div class="bg-orb bg-orb--2"></div>
        <div class="bg-orb bg-orb--3"></div>
        <div class="bg-grid"></div>
    </div>

    <!-- Treść powitalna -->
    <main class="welcome-hero">

        <!-- Logo / ikona -->
        <div class="welcome-logo">
            <div class="welcome-logo__ring welcome-logo__ring--outer"></div>
            <div class="welcome-logo__ring welcome-logo__ring--inner"></div>
            <div class="welcome-logo__icon">
                <MudIcon Icon="@Icons.Material.Filled.Domain" />
            </div>
        </div>

        <!-- Firma -->
        <p class="welcome-brand">BORYSZEW NIERUCHOMOŚCI</p>

        <!-- Nagłówek -->
        <h1 class="welcome-title">
            Witaj w systemie <span class="welcome-title__accent">zarządzania</span>
        </h1>

        <!-- Opis -->
        <p class="welcome-subtitle">
            Kompleksowa platforma do obsługi budynków, lokali,<br class="welcome-subtitle__br" />
          
        </p>

        <!-- Separator -->
        

    </main>
</div>
