@if (IsVisible)
{
    <div class="modal d-block confirmation-overlay" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirmation-dialog-title">
        <div class="modal-dialog modal-dialog-centered confirmation-dialog" role="document">
            <div class="modal-content confirmation-modal confirmation-modal--@ThemeClass">
                <div class="modal-header confirmation-modal__header">
                    <div class="confirmation-modal__heading">
                        <span class="confirmation-modal__icon">
                            <i class="bi @ResolvedIconClass" aria-hidden="true"></i>
                        </span>
                        <h5 id="confirmation-dialog-title" class="modal-title confirmation-modal__title">@Title</h5>
                    </div>
                    <button type="button" class="btn-close confirmation-modal__close" aria-label="Zamknij" @onclick="() => OnAnswer.InvokeAsync(false)"></button>
                </div>
                <div class="modal-body confirmation-modal__body">
                    <p class="confirmation-modal__message">@Message</p>
                </div>
                <div class="modal-footer confirmation-modal__footer">
                    <button type="button" class="btn confirmation-modal__cancel" @onclick="() => OnAnswer.InvokeAsync(false)">Anuluj</button>
                    <button type="button" class="btn confirmation-modal__confirm" @onclick="() => OnAnswer.InvokeAsync(true)">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show confirmation-backdrop"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Potwierdzenie";
    [Parameter] public string Message { get; set; } = "Czy na pewno chcesz wykonać tę operację?";

    [Parameter] public string ThemeClass { get; set; } = "primary";
    [Parameter] public string ConfirmText { get; set; } = "Tak, kontynuuj";
    [Parameter] public string IconClass { get; set; } = "e-warning";

    [Parameter] public EventCallback<bool> OnAnswer { get; set; }

    private string ResolvedIconClass => IconClass == "e-warning" ? "bi-exclamation-triangle-fill" : IconClass;
}