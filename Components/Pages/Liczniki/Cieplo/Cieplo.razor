        NipNabywcy = faktura.NipNabywcy,
        NumerKlienta = faktura.NumerKlienta,
        RodzajFaktury = faktura.RodzajFaktury,
        Waluta = faktura.Waluta,
        PrefiksVatSprzedawcy = faktura.PrefiksVatSprzedawcy,
        AdresSprzedawcy = faktura.AdresSprzedawcy,
