            $"Odczyt licznika „{odczyt.NumerLicznika}” został usunięty.",
            "Odczyt nie istnieje lub został już usunięty.");
    }

    private async Task PrzetworzFakturePdf(IBrowserFile? plik)
    {
        if (plik is null)
        {
            return;
        }

        trwaPrzetwarzanieFaktury = true;
        try
        {
            var faktura = await CieploService.ParsujFaktureAsync(plik);
            if (faktura is null)
            {
                Snackbar.Add("Nie udało się rozpoznać faktury automatycznie. Wypełnij ją ręcznie.", Severity.Warning);
                await DodajFakture();
                return;
            }

            Snackbar.Add("Wykryto fakturę. Zweryfikuj dane i zapisz.", Severity.Info);
            await OtworzDialogFaktury(faktura, "Zweryfikuj fakturę");
        }
        catch (Exception ex)
        {
            var bladOdczytu = ex;
            while (bladOdczytu.InnerException is not null)
            {
                bladOdczytu = bladOdczytu.InnerException;
            }

            Snackbar.Add($"Nie udało się automatycznie odczytać pliku ({bladOdczytu.Message}). Otwieram formularz do ręcznego uzupełnienia.", Severity.Warning);
            await DodajFakture();
        }
        finally
        {
            trwaPrzetwarzanieFaktury = false;
        }
    }

