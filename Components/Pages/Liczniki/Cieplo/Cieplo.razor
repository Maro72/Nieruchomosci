    private Task PotwierdzUsuniecieFaktury(PodsumowanieMiesiacaCiepla podsumowanie)
    {
        if (podsumowanie.Faktura is null)
        {
            Snackbar.Add("Ten okres nie ma przypisanej faktury do usunięcia.", Severity.Warning);
            return Task.CompletedTask;
        }

        var faktura = podsumowanie.Faktura;
        fakturaDoUsuniecia = faktura;
        trescUsunieciaFaktury = $"Czy na pewno usunąć fakturę „{faktura.NumerFaktury}”?";
        czyUsuwacFakture = true;
        return Task.CompletedTask;
    }

    private async Task PotwierdzonoUsuniecieFaktury(bool potwierdzono)
    {
        czyUsuwacFakture = false;
        var faktura = fakturaDoUsuniecia;
        fakturaDoUsuniecia = null;
        if (!potwierdzono || faktura is null)
        {
            return;
        }

        await Wykonaj(
            () => CieploService.UsunFaktureAsync(faktura.Id),
            $"Faktura „{faktura.NumerFaktury}” została usunięta.",
            "Faktura nie istnieje lub została już usunięta.");
    }

    private async Task Wykonaj(Func<Task> akcja, string komunikat)
    {
        try
        {
            await akcja();
            Snackbar.Add(komunikat, Severity.Success);
            await Odswiez();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Operacja nie powiodła się: {ex.Message}", Severity.Error);
        }
    }

    private async Task Wykonaj(Func<Task<bool>> akcja, string komunikat, string komunikatBraku)
    {
        try
        {
            if (!await akcja())
            {
                Snackbar.Add(komunikatBraku, Severity.Warning);
                return;
            }

            Snackbar.Add(komunikat, Severity.Success);
            await Odswiez();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Operacja nie powiodła się: {ex.Message}", Severity.Error);
        }
    }
