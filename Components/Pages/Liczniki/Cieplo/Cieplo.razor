    private Task PotwierdzUsuniecieOdczytu(OdczytCiepla odczyt)
    {
        odczytDoUsuniecia = odczyt;
        trescUsunieciaOdczytu = $"Czy na pewno usunąć odczyt licznika „{odczyt.NumerLicznika}” za {odczyt.Miesiac:D2}/{odczyt.Rok}?";
        czyUsuwacOdczyt = true;
        return Task.CompletedTask;
    }

    private async Task PotwierdzonoUsuniecieOdczytu(bool potwierdzono)
    {
        czyUsuwacOdczyt = false;
        var odczyt = odczytDoUsuniecia;
        odczytDoUsuniecia = null;
        if (!potwierdzono || odczyt is null)
