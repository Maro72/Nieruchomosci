@using Mieszkaniec.Model.Entities
@using MudBlazor

<style>
    .cd-faktura .mud-dialog-title { padding: 12px 20px; }
    .cd-faktura .mud-dialog-content { padding: 8px 20px; }
    .cd-faktura .mud-dialog-actions { padding: 10px 20px; }
    .cd-faktura .mud-grid-item { padding: 6px !important; }
    .cd-faktura .mud-input-control { margin: 0; min-width: 0; }
    .cd-faktura .mud-input.mud-input-outlined > .mud-input-slot { font-size: 0.9rem; padding: 6px 10px; }
    .cd-faktura .mud-input-label-outlined { font-size: 0.85rem; }
    .cd-faktura .mud-input-helper-text { display: none; }
    .cd-faktura .mud-table-cell { font-size: 0.85rem; padding: 5px 8px; }
    .cd-faktura .cd-sec { font-size: 0.78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--mud-palette-primary); font-weight: 600; }
    .cd-faktura .cd-num input { text-align: right; }
    .cd-faktura .mud-checkbox .mud-typography { font-size: 0.85rem; }
</style>

<MudDialog Options="DialogOptions" Class="cd-faktura" Style="max-height: 90vh; overflow-y: auto; width: min(100vw - 12px, 1180px); min-width: min(100vw - 12px, 1180px); max-width: calc(100vw - 12px);">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1"><b>@(Faktura.Id == 0 ? "Nowa faktura za ciepło" : "Edycja faktury za ciepło")</b></MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form">
            <div class="cd-sec mt-1">Dane dokumentu</div>
            <MudGrid Spacing="1">
                <MudItem xs="12"><MudTextField @bind-Value="Faktura.NumerFaktury" Label="Numer faktury" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Podaj numer faktury" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="Faktura.Waluta" Label="Waluta" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudDatePicker @bind-Date="DataWystawienia" Label="Data wystawienia" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudDatePicker @bind-Date="DataOd" Label="Dostawa od" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudDatePicker @bind-Date="DataDo" Label="Dostawa do" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" /></MudItem>
            </MudGrid>

            <div class="d-flex align-center justify-space-between mt-1">
                <div class="cd-sec">Pozycje faktury</div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="DodajPozycje">Dodaj pozycję</MudButton>
            </div>
            <div style="overflow-x:auto;">
                <MudSimpleTable Dense="true" Elevation="0" Outlined="true" Style="min-width:980px; width:100%; table-layout:fixed;">
                    <colgroup>
                        <col style="width:32px;" />
                        <col style="width:40%;" />
                        <col style="width:88px;" />
                        <col style="width:110px;" />
                        <col style="width:110px;" />
                        <col style="width:82px;" />
                        <col style="width:110px;" />
                        <col style="width:36px;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th style="width:32px;">Lp.</th>
                            <th>Nazwa towaru lub usługi</th>
                            <th>Miara</th>
                            <th style="width:110px; text-align:right;">Ilość</th>
                            <th style="width:110px; text-align:right;">Cena netto</th>
                            <th style="text-align:right;">VAT %</th>
                            <th style="width:110px; text-align:right;">Wartość netto</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Faktura.Pozycje)
                        {
                            <tr @key="p">
                                <td>@(Faktura.Pozycje.IndexOf(p) + 1)</td>
                                <td><MudTextField @bind-Value="p.NazwaTowaruUslugi" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="p.Jm" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                                <td><MudNumericField @bind-Value="p.Ilosc" @bind-Value:after="() => PrzeliczPozycje(p)" HideSpinButtons="true" Format="N6" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cd-num" /></td>
                                <td><MudNumericField @bind-Value="p.CenaNetto" @bind-Value:after="() => PrzeliczPozycje(p)" HideSpinButtons="true" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cd-num" /></td>
                                <td><MudNumericField @bind-Value="p.StawkaVat" @bind-Value:after="Przelicz" HideSpinButtons="true" Format="N0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cd-num" /></td>
                                <td><MudNumericField @bind-Value="p.WartoscNetto" @bind-Value:after="Przelicz" HideSpinButtons="true" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cd-num" /></td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => UsunPozycje(p))" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudGrid Spacing="2" Class="mt-1" AlignItems="AlignItems.Stretch">
                <MudItem xs="12" md="6">
                    <div class="cd-sec">Dodatkowe informacje</div>
                    <MudTextField @bind-Value="Faktura.DodatkoweInformacje" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="cd-sec">Podsumowanie stawek podatku</div>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead>
                            <tr><th>Stawka</th><th style="text-align:right;">Netto</th><th style="text-align:right;">Podatek</th><th style="text-align:right;">Brutto</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Faktura.PodsumowanieStawek())
                            {
                                <tr>
                                    <td>@s.Stawka.ToString("N0")%</td>
                                    <td style="text-align:right;">@s.Netto.ToString("N2")</td>
                                    <td style="text-align:right;">@s.Podatek.ToString("N2")</td>
                                    <td style="text-align:right;">@s.Brutto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <div class="d-flex justify-space-between align-baseline mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Kwota należności ogółem</MudText>
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>@Faktura.WartoscBrutto.ToString("N2") @Faktura.Waluta</b></MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">Zapisz fakturę</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public FakturaCiepla Faktura { get; set; } = new();

    private readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.False, FullWidth = true, CloseButton = true };

    private MudForm form = default!;

    private DateTime? DataWystawienia { get => Faktura.DataWystawienia; set { if (value.HasValue) Faktura.DataWystawienia = value.Value; } }
    private DateTime? DataOd { get => Faktura.DataOd; set { if (value.HasValue) Faktura.DataOd = value.Value; } }
    private DateTime? DataDo { get => Faktura.DataDo; set { if (value.HasValue) Faktura.DataDo = value.Value; } }

    protected override void OnParametersSet()
    {
        if (Faktura.Id == 0 && Faktura.Pozycje.Count == 0)
        {
            // Układ pozycji zgodny z fakturą ciepła (moc, opłata stała, woda, opłata zmienna).
            Faktura.Pozycje.Add(Nowa("Moc zamówiona co", "MW"));
            Faktura.Pozycje.Add(Nowa("Opłata stała za przesył co", "MW"));
            Faktura.Pozycje.Add(Nowa("Woda c.o.", "GJ"));
            Faktura.Pozycje.Add(Nowa("Opłata zmienna za przesył c.o.", "GJ"));
        }
    }

    private static PozycjaFakturyCiepla Nowa(string nazwa, string jm) =>
        new() { NazwaTowaruUslugi = nazwa, Jm = jm, StawkaVat = 23m };

    private void DodajPozycje()
    {
        Faktura.Pozycje.Add(Nowa(string.Empty, "GJ"));
        Przelicz();
    }

    private void UsunPozycje(PozycjaFakturyCiepla pozycja)
    {
        Faktura.Pozycje.Remove(pozycja);
        Przelicz();
    }

    private void Przelicz() => Faktura.AktualizujKwotyZPozycji();

    private void PrzeliczPozycje(PozycjaFakturyCiepla pozycja)
    {
        pozycja.PrzeliczNetto();
        Przelicz();
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!form.IsValid)
        {
            return;
        }

        Faktura.Rok = Faktura.DataDo.Year;
        Faktura.Miesiac = Faktura.DataDo.Month;
        Przelicz();
        MudDialog.Close(DialogResult.Ok(Faktura));
    }

    private void Cancel() => MudDialog.Cancel();
}
