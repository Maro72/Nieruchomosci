@using Mieszkaniec.Model.Dto
@using MudBlazor

<MudDialog Style="max-width: 1050px; width: 100%;">
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sprawdź wartości przed zapisaniem. Odczyty są pogrupowane według miesiąca.
        </MudText>

        <MudExpansionPanels MultiExpansion="true">
            @foreach (var grupa in GrupyMiesiecy)
            {
                <MudExpansionPanel Expanded="true" Class="mb-3 border rounded shadow-none" Style="border: 1px solid #e2e8f0; border-radius: 8px !important; overflow: hidden; background-color: #ffffff;">
                    <TitleContent>
                        <div class="d-flex align-items-center justify-content-between w-100 pe-3">
                            <div class="d-flex align-items-center gap-3">
                                <MudSelect T="int" 
                                           Value="@MiesiacDlaWyswietlenia(grupa.Key.Miesiac)" 
                                           ValueChanged="@(miesiac => ZmienMiesiac(grupa.ToList(), miesiac))" 
                                           Dense="true" 
                                           Margin="Margin.Dense" 
                                           Label="Miesiąc" 
                                           Style="min-width: 150px">
                                    @foreach (var miesiac in Miesiace)
                                    {
                                        <MudSelectItem T="int" Value="@miesiac.Numer">@miesiac.Nazwa</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@grupa.Key.Rok</MudText>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-secondary border px-2 py-1.5 rounded-pill">
                                    @grupa.Count(x => x.Importuj) z @grupa.Count() odczytów
                                </span>
                                <span class="badge bg-primary text-white px-2 py-1.5 rounded-pill">
                                    @grupa.Where(x => x.Importuj).Sum(x => x.IloscDoZafakturowania) m³
                                </span>
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="table-responsive border-top bg-white">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem; width: 100%; table-layout: fixed;">
                                <thead class="table-light text-secondary" style="font-size: 0.76rem; font-weight: 600;">
                                    <tr>
                                        <th style="width: 36px;" class="ps-2 pe-1 text-center">
                                            <input type="checkbox" 
                                                   class="form-check-input" 
                                                   checked="@CzyWszystkieZaznaczone(grupa)" 
                                                   @onchange="@(e => ZaznaczWszystkie(grupa, (bool)(e.Value ?? false)))" 
                                                   title="Zaznacz/odznacz wszystkie" />
                                        </th>
                                        <th style="width: 150px; white-space: nowrap;">Budynek</th>
                                        <th style="width: 115px; white-space: nowrap;">Nr licznika</th>
                                        <th class="text-end px-2" style="width: 125px; white-space: nowrap;">Stan początkowy</th>
                                        <th class="text-end px-2" style="width: 115px; white-space: nowrap;">Stan końcowy</th>
                                        <th class="text-end px-2" style="width: 90px; white-space: nowrap;">Zużycie</th>
                                        <th class="text-end px-2" style="width: 85px; white-space: nowrap;">Korekta</th>
                                        <th class="text-end px-2" style="width: 105px; white-space: nowrap;">Do faktury</th>
                                        <th class="ps-3 pe-2 text-start" style="width: 110px; white-space: nowrap;">Uwagi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var odczyt in grupa)
                                    {
                                        <tr class="@(odczyt.Importuj ? "" : "text-muted opacity-50")">
                                            <td class="ps-2 pe-1 text-center">
                                                <input type="checkbox" 
                                                       class="form-check-input" 
                                                       checked="@odczyt.Importuj" 
                                                       @onchange="@(e => { odczyt.Importuj = (bool)(e.Value ?? false); })" />
                                            </td>
                                            <td class="text-truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@odczyt.ObiektNazwa">
                                                @if (odczyt.ObiektId.HasValue && !string.IsNullOrWhiteSpace(odczyt.ObiektNazwa))
                                                {
                                                    <span>@odczyt.ObiektNazwa</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Nieprzypisany</span>
                                                }
                                            </td>
                                            <td style="white-space: nowrap;">
                                                <strong>@odczyt.NumerLicznika</strong>
                                            </td>
                                            <td class="text-end px-2">
                                                <input type="number" 
                                                       class="form-control form-control-sm text-end ms-auto" 
                                                       value="@odczyt.StanPoczatkowy" 
                                                       @onchange="@(e => OnStanPoczatkowyChanged(odczyt, e.Value))" 
                                                       disabled="@(!odczyt.Importuj)"
                                                       style="width: 85px; font-size: 0.82rem; padding: 2px 6px; height: 26px;" />
                                            </td>
                                            <td class="text-end px-2">
                                                <input type="number" 
                                                       class="form-control form-control-sm text-end ms-auto" 
                                                       value="@odczyt.StanKoncowy" 
                                                       @onchange="@(e => OnStanKoncowyChanged(odczyt, e.Value))" 
                                                       disabled="@(!odczyt.Importuj)"
                                                       style="width: 85px; font-size: 0.82rem; padding: 2px 6px; height: 26px;" />
                                            </td>
                                            <td class="text-end px-2">
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <input type="number" 
                                                           class="form-control form-control-sm text-end" 
                                                           value="@odczyt.Zuzycie" 
                                                           @onchange="@(e => OnZuzycieChanged(odczyt, e.Value))" 
                                                           disabled="@(!odczyt.Importuj)"
                                                           style="width: 55px; font-size: 0.82rem; padding: 2px 6px; height: 26px;" />
                                                    <span class="text-muted small" style="width: 18px;">m³</span>
                                                </div>
                                            </td>
                                            <td class="text-end px-2">
                                                <input type="number" 
                                                       class="form-control form-control-sm text-end ms-auto @(odczyt.Korekta < 0 ? "text-danger fw-bold" : "")" 
                                                       value="@odczyt.Korekta" 
                                                       @onchange="@(e => OnKorektaChanged(odczyt, e.Value))" 
                                                       disabled="@(!odczyt.Importuj)"
                                                       style="width: 65px; font-size: 0.82rem; padding: 2px 6px; height: 26px;" />
                                            </td>
                                            <td class="text-end px-2">
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <input type="number" 
                                                           class="form-control form-control-sm text-end text-primary fw-bold" 
                                                           value="@odczyt.IloscDoZafakturowania" 
                                                           @onchange="@(e => OnDoFakturyChanged(odczyt, e.Value))" 
                                                           disabled="@(!odczyt.Importuj)"
                                                           style="width: 58px; font-size: 0.82rem; padding: 2px 6px; height: 26px;" />
                                                    <span class="text-primary fw-bold small" style="width: 18px;">m³</span>
                                                </div>
                                            </td>
                                            <td class="ps-3 pe-2 text-start" style="white-space: nowrap;">
                                                @if (odczyt.NadmierneZuzycie)
                                                {
                                                    <span class="badge bg-danger">Nadmierne zużycie</span>
                                                }
                                                @if (odczyt.JestNowy)
                                                {
                                                    <span class="badge bg-info text-dark">Nowy licznik</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr class="fw-bold" style="font-size: 0.8rem;">
                                        <td colspan="5" class="ps-2">Razem (@grupa.Count(x => x.Importuj))</td>
                                        <td class="text-end pe-2">@grupa.Where(x => x.Importuj).Sum(x => x.Zuzycie) m³</td>
                                        <td class="text-end pe-2 text-danger">@grupa.Where(x => x.Importuj).Sum(x => x.Korekta ?? 0)</td>
                                        <td class="text-end pe-2 text-primary">@grupa.Where(x => x.Importuj).Sum(x => x.IloscDoZafakturowania) m³</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Anuluj">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Zapisz" Disabled="@(!Odczyty.Any(x => x.Importuj))">
            Zapisz odczyty (@Odczyty.Count(x => x.Importuj))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<OdczytZPdfDto> Odczyty { get; set; } = new();

    private static readonly (int Numer, string Nazwa)[] Miesiace =
    {
        (1, "Styczeń"), (2, "Luty"), (3, "Marzec"), (4, "Kwiecień"),
        (5, "Maj"), (6, "Czerwiec"), (7, "Lipiec"), (8, "Sierpień"),
        (9, "Wrzesień"), (10, "Październik"), (11, "Listopad"), (12, "Grudzień")
    };

    protected override void OnParametersSet()
    {
        var domyslnyMiesiac = DateTime.Now.Month;
        foreach (var odczyt in Odczyty)
        {
            if (odczyt.Miesiac is < 1 or > 12)
            {
                odczyt.Miesiac = domyslnyMiesiac;
            }
        }
    }

    private IEnumerable<IGrouping<(int Rok, int Miesiac), OdczytZPdfDto>> GrupyMiesiecy => Odczyty
        .GroupBy(KluczGrupy)
        .OrderBy(x => x.Key.Rok)
        .ThenBy(x => x.Key.Miesiac);

    private static (int Rok, int Miesiac) KluczGrupy(OdczytZPdfDto odczyt)
    {
        if (odczyt.Miesiac is < 1 or > 12)
        {
            odczyt.Miesiac = DateTime.Now.Month;
        }

        return (odczyt.Rok, odczyt.Miesiac);
    }

    private static int MiesiacDlaWyswietlenia(int miesiac) => Miesiace.Any(x => x.Numer == miesiac)
        ? miesiac
        : DateTime.Now.Month;

    private static string NazwaMiesiaca(int miesiac) => miesiac switch
    {
        1 => "Styczeń",
        2 => "Luty",
        3 => "Marzec",
        4 => "Kwiecień",
        5 => "Maj",
        6 => "Czerwiec",
        7 => "Lipiec",
        8 => "Sierpień",
        9 => "Wrzesień",
        10 => "Październik",
        11 => "Listopad",
        12 => "Grudzień",
        _ => NazwaMiesiaca(DateTime.Now.Month)
    };

    private static void ZmienMiesiac(List<OdczytZPdfDto> odczyty, int miesiac)
    {
        foreach (var odczyt in odczyty)
        {
            odczyt.Miesiac = miesiac;
        }
    }

    private bool CzyWszystkieZaznaczone(IEnumerable<OdczytZPdfDto> odczyty) => odczyty.All(x => x.Importuj);

    private void ZaznaczWszystkie(IEnumerable<OdczytZPdfDto> odczyty, bool zaznacz)
    {
        foreach (var odczyt in odczyty)
        {
            odczyt.Importuj = zaznacz;
        }
    }

    private void OnStanPoczatkowyChanged(OdczytZPdfDto odczyt, object? val)
    {
        if (int.TryParse(val?.ToString(), out int parsed))
        {
            odczyt.StanPoczatkowy = parsed;
            Przelicz(odczyt);
        }
    }

    private void OnStanKoncowyChanged(OdczytZPdfDto odczyt, object? val)
    {
        if (int.TryParse(val?.ToString(), out int parsed))
        {
            odczyt.StanKoncowy = parsed;
            Przelicz(odczyt);
        }
    }

    private void OnZuzycieChanged(OdczytZPdfDto odczyt, object? val)
    {
        if (int.TryParse(val?.ToString(), out int parsed))
        {
            odczyt.Zuzycie = parsed;
            odczyt.IloscDoZafakturowania = Math.Max(0, odczyt.Zuzycie + (odczyt.Korekta ?? 0));
        }
    }

    private void OnKorektaChanged(OdczytZPdfDto odczyt, object? val)
    {
        if (string.IsNullOrWhiteSpace(val?.ToString()))
        {
            odczyt.Korekta = null;
        }
        else if (int.TryParse(val.ToString(), out int parsed))
        {
            odczyt.Korekta = parsed;
        }
        odczyt.IloscDoZafakturowania = Math.Max(0, odczyt.Zuzycie + (odczyt.Korekta ?? 0));
    }

    private void OnDoFakturyChanged(OdczytZPdfDto odczyt, object? val)
    {
        if (int.TryParse(val?.ToString(), out int parsed))
        {
            odczyt.IloscDoZafakturowania = parsed;
        }
    }

    private void Przelicz(OdczytZPdfDto odczyt)
    {
        if (odczyt.StanKoncowy >= odczyt.StanPoczatkowy)
        {
            odczyt.Zuzycie = odczyt.StanKoncowy - odczyt.StanPoczatkowy;
        }
        odczyt.IloscDoZafakturowania = Math.Max(0, odczyt.Zuzycie + (odczyt.Korekta ?? 0));
    }

    private void Zapisz() => MudDialog.Close(DialogResult.Ok(Odczyty));
    private void Anuluj() => MudDialog.Cancel();
}