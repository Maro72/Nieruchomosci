    private async Task PrzetworzPlik(IBrowserFile file)
    {
        if (file != null)
        {
            trwaPrzetwarzanie = true;
            try
            {
                odczytyZPdf = await LicznikService.PrzetworzSkanAsync(file);
                if (odczytyZPdf.Count == 0) Snackbar.Add("Nie rozpoznano żadnych odczytów.", Severity.Warning);
                else
                {
                    Snackbar.Add($"Pomyślnie rozpoznano {odczytyZPdf.Count} odczytów.", Severity.Success);
                    await OtworzDialogOdczytow(odczytyZPdf);
                }
            }
            catch (Exception ex) { Snackbar.Add("Błąd: " + ex.Message, Severity.Error); }
            finally { trwaPrzetwarzanie = false; }
        }
    }

    private async Task OtworzDialogOdczytow(List<OdczytZPdfDto> odczyty)
    {
        var param = new DialogParameters { ["Odczyty"] = odczyty };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<OdczytyDialog>("Odczyty liczników", param, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is List<OdczytZPdfDto> zatwierdzoneOdczyty)
        {
            odczytyZPdf = zatwierdzoneOdczyty;
            await ZapiszOdczyty();
        }
        else
        {
            odczytyZPdf = null;
        }
    }

    private async Task PrzetworzFakturePdf(IBrowserFile file)
    {
        if (file != null)
        {
            trwaPrzetwarzanieFaktury = true;
            try
            {
                var wyekstrahowanaFaktura = await LicznikService.ParsujFaktureAsync(file);
                if (wyekstrahowanaFaktura == null)
                {
                    Snackbar.Add("Nie udało się rozpoznać faktury automatycznie. Wypełnij ją ręcznie.", Severity.Warning);
                    await OtworzDialogFaktura(); // Otwórz pusty dialog
                }
                else
                {
                    Snackbar.Add($"Wykryto fakturę. Zweryfikuj i zapisz.", Severity.Info);
                    await OtworzDialogFaktura(wyekstrahowanaFaktura);
                }
            }
            catch (Exception ex) { Snackbar.Add("Błąd: " + ex.Message, Severity.Error); }
            finally { trwaPrzetwarzanieFaktury = false; }
        }
    }

    private async Task ZapiszOdczyty()
    {
        if (odczytyZPdf == null || !odczytyZPdf.Any(x => !x.Ignoruj))
        {
            Snackbar.Add("Brak odczytów do zapisania.", Severity.Warning);
            return;
        }

        var bezBudynku = odczytyZPdf
            .Where(x => !x.Ignoruj && !x.ObiektId.HasValue)
            .Select(x => x.NumerLicznika)
            .Distinct()
            .ToList();

        if (bezBudynku.Any())
        {
            Snackbar.Add($"Nie można zapisać odczytów. Przypisz budynek dla liczników: {string.Join(", ", bezBudynku)}.", Severity.Warning);
            return;
        }

        try
        {
            await LicznikService.ZapiszOdczytyAsync(odczytyZPdf);
            Snackbar.Add("Odczyty zapisane do bazy danych.", Severity.Success);
            odczytyZPdf = null;
            await OdswiezDane();
        }
        catch (Exception ex) { Snackbar.Add("Błąd podczas zapisywania: " + ex.Message, Severity.Error); }
    }
}