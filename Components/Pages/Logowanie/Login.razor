@page "/login"
@using Mieszkaniec.Components.Layout
@layout EmptyLayout
@using MudBlazor
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Data.Common
@using Mieszkaniec.Model.Context
@using Mieszkaniec.Services.Interfaces
@using Mieszkaniec.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<MieszkaniecDbContext> DbContextFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbConfigService DbConfigService
@inject IDbConnectionService DbConnectionService

<div class="login-shell">
    <div class="login-stars" aria-hidden="true"></div>
    @if (!_isLoginReady)
    {
        @* Spinner jest widoczny do czasu uruchomienia interaktywnego formularza. *@
        <div class="login-loading" aria-live="polite" aria-label="Ładowanie formularza logowania">
            <MudProgressCircular Color="Color.Info" Size="Size.Large" Indeterminate="true" />
            <span>Ładowanie formularza logowania...</span>
        </div>
    }
    else
    {
    <main class="login-layout">
        <section class="login-presentation">
            <div class="login-eyebrow"><span class="login-eyebrow-dot"></span> BORYSZEW NIERUCHOMOŚCI</div>
            <h1>System<br /><span>Zarządzania Nieruchomościami</span></h1>
            <p class="login-lead">Jeden spójny system do obsługi budynków, przeglądów, usterek.</p>

            <div class="login-highlights">
                <div class="login-highlight"><MudIcon Icon="@Icons.Material.Filled.Domain" /><span><strong>Nieruchomości</strong><small>Pełna kontrola obiektów</small></span></div>
                <div class="login-highlight"><MudIcon Icon="@Icons.Material.Filled.EventNote" /><span><strong>Terminy</strong><small>Przeglądy zawsze na czas</small></span></div>
                <div class="login-highlight"><MudIcon Icon="@Icons.Material.Filled.Security" /><span><strong>Bezpieczeństwo</strong><small>Dane w jednym miejscu</small></span></div>
            </div>
        </section>

        <MudPaper Class="login-card" Elevation="0">
            <div class="login-card-heading">
                <div>
                    <MudText Typo="Typo.h4">@(_databaseReady ? "Zaloguj się" : "Konfiguracja połączenia")</MudText>
                    <MudText Typo="Typo.body2">
                        @(_databaseReady
                            ? "Wprowadź dane, aby otworzyć panel administracyjny"
                            : "Nie można połączyć się z bazą. Wpisz aktualne hasło, aby przywrócić połączenie.")
                    </MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.LockPerson" Class="login-card-icon" />
            </div>

            @if (!_databaseReady)
            {
                <form class="login-form" autocomplete="off" @onsubmit="ZapiszKonfiguracjeBazy" @onsubmit:preventDefault="true">
                    @if (!string.IsNullOrWhiteSpace(_databaseError))
                    {
                        <MudAlert Severity="Severity.Warning" Class="login-error" Elevation="0" Variant="Variant.Outlined">
                            @_databaseError
                        </MudAlert>
                    }

                    <label class="login-label" for="database-server">SERWER BAZY DANYCH</label>
                    <MudTextField id="database-server" @bind-Value="_connectionModel.Server"
                                  Variant="Variant.Outlined" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Dns"
                                  Class="login-input" />

                    <label class="login-label" for="database-port">PORT</label>
                    <MudNumericField id="database-port" T="uint" @bind-Value="_connectionModel.Port"
                                     Variant="Variant.Outlined" Required="true"
                                     Class="login-input" />

                    <label class="login-label" for="database-name">NAZWA BAZY DANYCH</label>
                    <MudTextField id="database-name" @bind-Value="_connectionModel.Database"
                                  Variant="Variant.Outlined" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Storage"
                                  Class="login-input" />

                    <label class="login-label" for="database-user">UŻYTKOWNIK BAZY</label>
                    <MudTextField id="database-user" @bind-Value="_connectionModel.User"
                                  Variant="Variant.Outlined" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                                  Class="login-input" />

                    <label class="login-label" for="database-password">HASŁO BAZY DANYCH</label>
                    <MudTextField id="database-password" @bind-Value="_connectionModel.Password"
                                  InputType="InputType.Password" Variant="Variant.Outlined"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.VpnKey"
                                  Class="login-input" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               FullWidth="true" ButtonType="ButtonType.Submit" Disabled="CzyLaduje"
                               Class="login-submit">
                        @if (CzyLaduje)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <span>Zapisz hasło i połącz</span>
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                        }
                    </MudButton>
                </form>
            }
            else
            {
            @* Formularz nie korzysta z podpowiedzi przeglądarki ani zapisanych danych logowania. *@
            <form class="login-form" autocomplete="off" @onsubmit="ZalogujSie" @onsubmit:preventDefault="true">
                <label class="login-label" for="login-user">LOGIN UŻYTKOWNIKA</label>
                <MudTextField id="login-user" @bind-Value="WpisanyLogin"
                              Placeholder="Wpisz nazwę użytkownika"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Login jest wymagany!"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              AdornmentColor="Color.Primary"
                              Class="login-input" />

                <label class="login-label" for="login-password">HASŁO DOSTĘPU</label>
                <MudTextField id="login-password" @bind-Value="WpisaneHaslo"
                              Placeholder="Wpisz hasło"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Hasło jest wymagane!"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.VpnKey"
                              AdornmentColor="Color.Primary"
                              Class="login-input" />

                @if (!string.IsNullOrEmpty(KomunikatBledu))
                {
                    <MudAlert Severity="Severity.Error" Class="login-error" Elevation="0" Variant="Variant.Outlined">
                        @KomunikatBledu
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           ButtonType="ButtonType.Submit"
                           Disabled="CzyLaduje"
                           Class="login-submit">
                    @if (CzyLaduje)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <span>Zaloguj się</span><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                    }
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" ButtonType="ButtonType.Button" OnClick="Zrezygnuj" Class="login-cancel">
                    Anuluj
                </MudButton>
            </form>
            }
            <div class="login-legal">Wersja oprogramowania 2.0.0 &middot; Wszystkie prawa zastrzeżone</div>
        </MudPaper>
    </main>
    }
</div>

@code {
    private string WpisanyLogin { get; set; } = string.Empty;
    private string WpisaneHaslo { get; set; } = string.Empty;
    private string KomunikatBledu { get; set; } = string.Empty;
    private bool CzyLaduje { get; set; } = false;
    private bool _isLoginReady;
    private bool _databaseReady;
    private string _databaseError = string.Empty;
    private DbConnectionModel _connectionModel = new();

    private async Task ZalogujSie()
    {
        CzyLaduje = true;
        KomunikatBledu = string.Empty;

        try
        {
            // Pobieramy użytkownika po loginie, a hasło weryfikujemy względem przechowywanego hasha.
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var uzytkownik = await dbContext.Uzytkownicy
                .FirstOrDefaultAsync(u => u.Login == WpisanyLogin);

            bool isValid = false;
            if (uzytkownik != null)
            {
                try
                {
                    isValid = BCrypt.Net.BCrypt.Verify(WpisaneHaslo, uzytkownik.HasloHash);
                }
                catch
                {
                    isValid = uzytkownik.HasloHash == WpisaneHaslo;
                }
            }

            if (uzytkownik != null && isValid)
            {
                if (uzytkownik.CzyAktywny)
                {
                    // Login remains available if the history-table migration has not been applied yet.
                    var authProvider = (Mieszkaniec.Services.MieszkaniecAuthStateProvider)AuthStateProvider;
                    await authProvider.ZalogujUzytkownika(uzytkownik.Login);

                    try
                    {
                        dbContext.HistoriaLogowan.Add(new Mieszkaniec.Model.Entities.HistoriaLogowania
                        {
                            Uzytkownik = uzytkownik.Login,
                            DataLogowania = DateTime.Now
                        });
                        await dbContext.SaveChangesAsync();
                    }
                    catch (Exception ex)
                    {
                        Console.Error.WriteLine($"Nie udało się zapisać historii logowania dla użytkownika '{uzytkownik.Login}': {ex.Message}");
                    }

                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    KomunikatBledu = "To konto zostało zablokowane.";
                }
            }
            else
            {
                KomunikatBledu = "Nieprawidłowy login lub hasło.";
            }
        }
        catch (Exception ex) when (ex is DbException || ex.InnerException is DbException)
        {
            _databaseReady = false;
            _databaseError = "Połączenie z bazą zostało przerwane. Sprawdź ustawienia i ponownie wpisz hasło.";
            Console.Error.WriteLine($"Błąd połączenia z bazą podczas logowania: {ex.Message}");
        }
        catch (Exception ex)
        {
            KomunikatBledu = "Wystąpił błąd podczas logowania. Spróbuj ponownie później.";
            Console.Error.WriteLine($"Błąd logowania: {ex.Message}");
        }
        finally
        {
            CzyLaduje = false;
        }
    }

    private async Task Zrezygnuj()
    {
        await JS.InvokeVoidAsync("window.close");
        NavigationManager.NavigateTo("about:blank");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _connectionModel = DbConfigService.PobierzAktualnaKonfiguracje();
            var wynik = await DbConfigService.TestujPolaczenieAsync(_connectionModel);
            _databaseReady = wynik.CzySukces;
            _databaseError = wynik.CzySukces
                ? string.Empty
                : OpisBleduPolaczenia(wynik.Wiadomosc);
            if (!wynik.CzySukces)
            {
                _connectionModel.Password = string.Empty;
            }

            // MudTextField nie przekazuje tych atrybutów w tej wersji MudBlazor.
            _isLoginReady = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("disableLoginAutocomplete");
        }
    }

    private async Task ZapiszKonfiguracjeBazy()
    {
        CzyLaduje = true;
        _databaseError = string.Empty;

        try
        {
            var wynik = await DbConfigService.TestujPolaczenieAsync(_connectionModel);
            if (!wynik.CzySukces)
            {
                _databaseError = OpisBleduPolaczenia(wynik.Wiadomosc);
                Console.Error.WriteLine($"Test połączenia z bazą nie powiódł się: {wynik.Wiadomosc}");
                return;
            }

            if (!await DbConfigService.ZapiszKonfiguracjeAsync(_connectionModel))
            {
                _databaseError = "Połączenie działa, ale zapis konfiguracji na serwerze się nie powiódł.";
                return;
            }

            if (!await DbConnectionService.CanConnectAsync())
            {
                _databaseError = "Hasło zapisano, ale aplikacja nadal nie może otworzyć połączenia z bazą. Sprawdź log serwera.";
                return;
            }

            _databaseReady = true;
            _databaseError = string.Empty;
            KomunikatBledu = string.Empty;
        }
        finally
        {
            CzyLaduje = false;
        }
    }

    private static string OpisBleduPolaczenia(string wiadomosc)
    {
        if (wiadomosc.Contains("Access denied", StringComparison.OrdinalIgnoreCase))
        {
            return "MySQL odrzucił logowanie. Sprawdź hasło oraz uprawnienia użytkownika dla tego serwera.";
        }

        if (wiadomosc.Contains("Unknown database", StringComparison.OrdinalIgnoreCase))
        {
            return "MySQL nie znalazł podanej bazy danych. Sprawdź jej nazwę.";
        }

        if (wiadomosc.Contains("Unable to connect", StringComparison.OrdinalIgnoreCase) ||
            wiadomosc.Contains("Connection refused", StringComparison.OrdinalIgnoreCase) ||
            wiadomosc.Contains("actively refused", StringComparison.OrdinalIgnoreCase))
        {
            return "Nie można osiągnąć serwera MySQL pod podanym adresem i portem. Sprawdź, czy serwer działa i czy adres jest poprawny.";
        }

        return $"Test połączenia nie powiódł się: {wiadomosc}";
    }
}

<style>
    .login-shell { position: fixed; inset: 0; z-index: 9999; overflow-y: auto; color: #e9f3ff; background: radial-gradient(circle at 19% 38%, rgba(35, 74, 181, .42), transparent 28%), radial-gradient(circle at 86% 72%, rgba(0, 154, 198, .28), transparent 32%), #030817; }
    .login-loading { position: relative; display: flex; min-height: 100%; align-items: center; justify-content: center; flex-direction: column; gap: 1rem; color: #aebbd0; font-size: .85rem; }
    .login-stars { position: fixed; inset: 0; pointer-events: none; opacity: .72; background-image: radial-gradient(circle, #35d5ff 0 1px, transparent 2px), radial-gradient(circle, #8c5cff 0 1px, transparent 2px), linear-gradient(130deg, transparent 48%, rgba(50, 130, 190, .16) 49%, transparent 50%); background-size: 165px 145px, 230px 190px, 330px 270px; background-position: 10px 10px, 70px 35px, 40px 0; }
    .login-layout { position: relative; display: grid; grid-template-columns: minmax(420px, 1fr) minmax(380px, 480px); align-items: center; gap: clamp(3rem, 9vw, 10rem); width: min(1100px, calc(100% - 3rem)); min-height: 100%; margin: 0 auto; padding: 4rem 0; }
    .login-presentation { max-width: 570px; }
    .login-eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px; border: 1px solid rgba(69, 219, 255, .32); border-radius: 20px; color: #45dfff; font-size: .7rem; font-weight: 800; letter-spacing: .1em; }
    .login-eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: #38d7ff; box-shadow: 0 0 12px #38d7ff; }
    .login-presentation h1 { margin: 1.5rem 0 .9rem; color: #f7fbff; font-size: clamp(1.65rem, 2.2vw, 8.40rem); line-height: 1.05; letter-spacing: -.02em; font-weight: 800; }
    .login-presentation h1 span { display: block; white-space: nowrap; overflow-wrap: anywhere; font-size: 1.5rem; color: #40dfff; background: linear-gradient(90deg, #40dfff, #8091ff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .login-lead { max-width: 450px; margin: 0; color: #aebbd0; font-size: .9rem; line-height: 1.55; }
    .login-highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 2rem; }
    .login-highlight { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 11px 10px; border: 1px solid rgba(123, 156, 212, .2); border-radius: 12px; background: rgba(15, 28, 66, .66); }
    .login-highlight .mud-icon-root { color: #54d9ff; }
    .login-highlight span { display: flex; flex-direction: column; gap: 2px; }
    .login-highlight strong { color: #eaf3ff; font-size: .68rem; white-space: nowrap; }
    .login-highlight small { color: #899ab8; font-size: .54rem; white-space: nowrap; }
    .login-card { width: 100%; padding: 1.9rem; border: 1px solid rgba(143, 171, 219, .28); border-radius: 20px; background: rgba(10, 22, 49, .82) !important; box-shadow: 0 24px 70px rgba(0, 0, 0, .38); backdrop-filter: blur(14px); }
    .login-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
    .login-card-heading .mud-typography-h4 { color: #f4f8ff; font-size: 1.65rem; font-weight: 800; }
    .login-card-heading .mud-typography-body2 { max-width: 270px; margin-top: 6px; color: #91a2c0; font-size: .8rem; line-height: 1.4; }
    .login-card-icon { color: #51d9ff; font-size: 2rem; }
    .login-label { display: block; margin: 0 0 7px; color: #afbdd5; font-size: .68rem; font-weight: 800; letter-spacing: .08em; }
    .login-input { margin-bottom: 1.2rem; }
    .login-card .mud-input-control { background: transparent !important; }
    .login-card .mud-input-outlined-border { border-color: rgba(139, 165, 211, .28) !important; }
    .login-card .mud-input-slot, .login-card .mud-input-slot::placeholder { color: #e8f2ff !important; }
    .login-card .mud-input-slot::placeholder { color: #6e7e9b !important; opacity: 1; }
    .login-card .mud-input-adornment .mud-icon-root { color: #6edfff !important; }
    .login-card .mud-input-control:hover .mud-input-outlined-border, .login-card .mud-input-control.mud-input-focused .mud-input-outlined-border { border-color: #36bff1 !important; }
    .login-error { margin: 0 0 1rem; }
    .login-submit { min-height: 44px; border-radius: 9px; color: white !important; font-size: .82rem; font-weight: 800; background: linear-gradient(100deg, #167cf0, #4d48df) !important; box-shadow: 0 8px 24px rgba(44, 112, 237, .3); }
    .login-submit .mud-button-label { display: inline-flex; align-items: center; justify-content: center; gap: 9px; }
    .login-cancel { display: block; margin: .5rem auto 0; color: #8394b3 !important; }
    .login-legal { margin-top: 1.25rem; color: #c4cad4; font-size: .62rem; line-height: 1.4; text-align: center; letter-spacing: .02em; }
    @@media (max-width: 820px) { .login-layout { grid-template-columns: 1fr; gap: 2rem; width: min(520px, calc(100% - 2rem)); padding: 2.5rem 0; } .login-presentation { text-align: center; } .login-eyebrow, .login-highlights { justify-content: center; } .login-lead { margin: auto; } .login-presentation h1 { font-size: clamp(1.7rem, 7vw, 2.2rem); } .login-presentation h1 span { white-space: normal; } }
    @@media (max-width: 520px) { .login-highlights { grid-template-columns: 1fr; max-width: 260px; margin-left: auto; margin-right: auto; } }
    @@media (max-width: 480px) { .login-card { padding: 1.5rem; border-radius: 16px; } .login-presentation h1 { margin-top: 1.2rem; } .login-highlights { display: none; } }
</style>