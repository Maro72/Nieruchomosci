@page "/login"
@using Mieszkaniec.Components.Layout
@layout EmptyLayout
@using MudBlazor
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Data.Common
@using Mieszkaniec.Model.Context
@using Microsoft.AspNetCore.Components.Authorization

@inject MieszkaniecDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

@* GŁÓWNY KONTENER - pozycjonowanie absolutne wymusza pełny ekran i ignoruje jakiekolwiek ukryte marginesy z layoutów *@
<MudContainer MaxWidth="MaxWidth.False"
              Class="login-shell"
              Style="min-height: 100vh; width: 100%; position: fixed; top: 0; left: 0; z-index: 9999; background-color: #f8fafc; display: flex; align-items: center; justify-content: center; padding: 1rem; overflow-y: auto;">
    
    @* WEWNĘTRZNY KONTENER - trzyma profesjonalną, sztywną szerokość dla formularza *@
    <MudContainer MaxWidth="MaxWidth.False" Class="login-form-container pa-0">
        <MudPaper Class="login-card pa-8 shadow-lg" Elevation="4" Style="border-radius: 16px; width: 100%; background: #ffffff;">
            
            <div class="d-flex flex-column align-center justify-center mb-8">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Style="width: 64px; height: 64px;" Class="mb-4 shadow-sm">
                    <MudIcon Icon="@Icons.Material.Filled.LockPerson" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #1e293b;">Logowanie do systemu</MudText>
                <MudText Typo="Typo.body2" Class="text-muted mt-1">Wprowadź swoje dane, aby kontynuować</MudText>
            </div>

            <form @onsubmit="ZalogujSie" @onsubmit:preventDefault="true">
                <MudTextField @bind-Value="WpisanyLogin" 
                              Label="Użytkownik (Login)" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="Login jest wymagany!"
                              Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              AdornmentColor="Color.Primary" />
                              
                <MudTextField @bind-Value="WpisaneHaslo" 
                              Label="Hasło" 
                              InputType="InputType.Password" 
                              Variant="Variant.Outlined" 
                              Required="true" 
                              RequiredError="Hasło jest wymagane!"
                              Class="mb-5"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.VpnKey"
                              AdornmentColor="Color.Primary" />

                @if (!string.IsNullOrEmpty(KomunikatBledu))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-5" Elevation="1" Variant="Variant.Filled">
                        @KomunikatBledu
                    </MudAlert>
                }

                <div class="d-flex gap-4">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Dark" 
                               Size="Size.Large" 
                               FullWidth="true" 
                               ButtonType="ButtonType.Button"
                               OnClick="Zrezygnuj">
                        Anuluj
                    </MudButton>

                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Large" 
                               FullWidth="true" 
                               ButtonType="ButtonType.Submit"
                               Disabled="CzyLaduje">
                        @if (CzyLaduje)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <span class="fw-bold">Zaloguj się</span>
                        }
                    </MudButton>
                </div>
            </form>
        </MudPaper>
    </MudContainer>
</MudContainer>

@code {
    private string WpisanyLogin { get; set; } = string.Empty;
    private string WpisaneHaslo { get; set; } = string.Empty;
    private string KomunikatBledu { get; set; } = string.Empty;
    private bool CzyLaduje { get; set; } = false;

    private async Task ZalogujSie()
    {
        CzyLaduje = true;
        KomunikatBledu = string.Empty;

        try
        {
            var uzytkownik = await DbContext.Uzytkownicy
                .FirstOrDefaultAsync(u => u.Login == WpisanyLogin);

            bool isValid = false;
            if (uzytkownik != null)
            {
                try
                {
                    isValid = BCrypt.Net.BCrypt.Verify(WpisaneHaslo, uzytkownik.HasloHash);
                }
                catch
                {
                    isValid = uzytkownik.HasloHash == WpisaneHaslo;
                }
            }

            if (uzytkownik != null && isValid)
            {
                if (uzytkownik.CzyAktywny)
                {
                    var authProvider = (Mieszkaniec.Services.MieszkaniecAuthStateProvider)AuthStateProvider;
                    await authProvider.ZalogujUzytkownika(uzytkownik.Login);

                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    KomunikatBledu = "To konto zostało zablokowane.";
                }
            }
            else
            {
                KomunikatBledu = "Nieprawidłowy login lub hasło.";
            }
        }
        catch (Exception ex) when (ex is DbException || ex.InnerException is DbException)
        {
            KomunikatBledu = "Nie można połączyć się z bazą danych. Sprawdź, czy serwer bazy danych jest uruchomiony.";
            Console.Error.WriteLine($"Błąd połączenia z bazą podczas logowania: {ex.Message}");
        }
        catch (Exception ex)
        {
            KomunikatBledu = "Wystąpił błąd podczas logowania. Spróbuj ponownie później.";
            Console.Error.WriteLine($"Błąd logowania: {ex.Message}");
        }
        finally
        {
            CzyLaduje = false;
        }
    }

    private async Task Zrezygnuj()
    {
        await JS.InvokeVoidAsync("window.close");
        NavigationManager.NavigateTo("about:blank");
    }
}

<style>
    .login-form-container {
        width: min(100%, 520px);
    }

    @@media (max-width: 576px) {
        .login-shell {
            align-items: flex-start !important;
            padding: 12px !important;
        }

        .login-card {
            padding: 24px !important;
        }
    }
</style>