@page "/wyloguj"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="d-flex flex-column justify-content-center align-items-center gap-3" style="height: 100vh;">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    <span>Wylogowywanie...</span>
</div>

@code {
    private bool _wylogowano;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _wylogowano)
            return;

        _wylogowano = true;
        try
        {
            if (AuthStateProvider is Mieszkaniec.Services.MieszkaniecAuthStateProvider authProvider)
                await authProvider.WylogujUzytkownika();
        }
        finally
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
