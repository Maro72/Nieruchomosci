    private string? _loadError;
    private bool _isLoading = true;
    private string BuildingTitle => _isH74 ? "H-74" : _selectedBuilding?.Nazwa ?? "L-75";

    // Geometria pozostaje przypisana do numerów lokali; dane o statusie pochodzą z Wynajmu.
