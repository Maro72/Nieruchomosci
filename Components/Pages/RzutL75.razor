    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        await LoadPlanForCurrentRouteAsync();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadPlanForCurrentRouteAsync();
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task LoadPlanForCurrentRouteAsync()
    {
        var requestedPlanIsH74 = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("rzut-h74", StringComparison.OrdinalIgnoreCase);
        if (_loadedPlanIsH74 == requestedPlanIsH74)
        {
            return;
        }

        _isH74 = requestedPlanIsH74;
        _loadedPlanIsH74 = requestedPlanIsH74;
        _isLoading = true;
        _loadError = null;
        _selectedBuilding = null;
        SelectedUnit = null;
        _units = [];
        _unmatchedMapNumbers = [];
        _unplacedRentalNumbers = [];

        try
        {
            await LoadFloorPlanDataAsync();
        }
        catch (DbException exception)
        {
            Logger.LogError(exception, "Nie udało się pobrać danych Wynajmu dla rzutu {Building}.", BuildingTitle);
            _loadError = "Nie udało się pobrać danych budynku i lokali z bazy. Spróbuj ponownie później.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private async Task LoadFloorPlanDataAsync()
    {
        _hasH74Part2Corridor = false;
        var buildings = await ObiektService.GetAllActiveAsync();
        var matchingBuildings = buildings
            .Where(building => _isH74 ? IsH74Building(building) : IsL75Building(building))
            .ToList();
        var expectedBuildingParts = _isH74 ? new[] { "1", "2" } : [""];
        var buildingsByPart = matchingBuildings
            .Select(building => (Building: building, Part: _isH74 ? GetH74Part(building) : ""))
            .Where(item => item.Part is not null)
            .GroupBy(item => item.Part!, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Select(item => item.Building).ToList(), StringComparer.Ordinal);

        if (expectedBuildingParts.Any(part => !buildingsByPart.TryGetValue(part, out var matches) || matches.Count != 1))
        {
            _loadError = _isH74
                ? $"Nie znaleziono dokładnie jednego aktywnego budynku dla każdej części H-74/1 i H-74/2. Dopasowania: {string.Join(", ", matchingBuildings.Select(building => $"{building.Nazwa} ({building.NumerEwidencyjny})"))}."
                : matchingBuildings.Count == 0
                    ? "Nie znaleziono aktywnego budynku L-75. Sprawdź nazwę lub numer ewidencyjny budynku."
                    : $"Znaleziono kilka aktywnych budynków pasujących do L-75: {string.Join(", ", matchingBuildings.Select(building => $"{building.Nazwa} (ID {building.Id})"))}.";
            return;
        }

        var selectedBuildings = expectedBuildingParts.Select(part => buildingsByPart[part][0]).ToList();
        _selectedBuilding = selectedBuildings[0];
        var rentalsByMapKey = new Dictionary<(string Part, string Number), LokalWynajem>();
        var allRentals = new List<(string Part, LokalWynajem Rental)>();

        foreach (var (building, part) in selectedBuildings.Select((building, index) => (building, expectedBuildingParts[index])))
        {
            var rentals = await LokalService.PobierzDlaObiektuAsync(building.Id);
            _hasH74Part2Corridor |= _isH74 && part == "2" &&
                rentals.Any(rental => rental.CzyCzescWspolna && rental.TypLokalu == "Korytarz");
            foreach (var rental in rentals)
            {
                allRentals.Add((part, rental));
            }
            foreach (var group in rentals.GroupBy(rental => NormalizeMapNumber(rental.NumerLokalu, part, _isH74), StringComparer.OrdinalIgnoreCase))
            {
                var matchingUnits = group.Where(rental => !rental.CzyCzescWspolna).ToList();
                var rentalToMap = matchingUnits.FirstOrDefault() ?? group.First();
                rentalsByMapKey.Add((part, NormalizeMapNumber(rentalToMap.NumerLokalu, part, _isH74)), rentalToMap);
            }
        }

        var mapAreas = _isH74 ? _h74MapAreas : _mapAreas;
        _units = mapAreas
            .Select(area => rentalsByMapKey.TryGetValue((area.BuildingPart, NormalizeMapNumber(area.Number, area.BuildingPart, _isH74)), out var rental)
                ? new Unit(GetMapAreaId(area), area.Number, area.BuildingPart, area.Points, rental)
                : new Unit(GetMapAreaId(area), area.Number, area.BuildingPart, area.Points, null))
            .ToList();

        var mappedNumbers = mapAreas
            .Select(area => (area.BuildingPart, NormalizeMapNumber(area.Number, area.BuildingPart, _isH74)))
            .ToHashSet();
        _unmatchedMapNumbers = _units
            .Where(unit => !unit.IsMapped)
            .Select(unit => _isH74 ? $"{unit.BuildingName} · {unit.Label}" : unit.Id)
            .ToList();
        _unplacedRentalNumbers = allRentals
            .Where(item => !(_isH74 && item.Part == "2" && item.Rental.CzyCzescWspolna && item.Rental.TypLokalu == "Korytarz"))
            .Where(item => !mappedNumbers.Contains((item.Part, NormalizeMapNumber(item.Rental.NumerLokalu, item.Part, _isH74))))
            .Select(item => _isH74 ? $"H-74/{item.Part} · {item.Rental.NumerLokalu}" : item.Rental.NumerLokalu)
            .OrderBy(number => number)
            .ToList();

    }

    private static bool IsL75Building(Obiekt building) =>
        NormalizeNumber(building.Nazwa).Contains("L75", StringComparison.OrdinalIgnoreCase) ||
        NormalizeNumber(building.NumerEwidencyjny).Contains("L75", StringComparison.OrdinalIgnoreCase);

    private static bool IsH74Building(Obiekt building) => GetH74Part(building) is not null;

    private static string? GetH74Part(Obiekt building)
    {
        var normalizedName = NormalizeNumber(building.Nazwa);
        var normalizedRegistryNumber = NormalizeNumber(building.NumerEwidencyjny);
        if (normalizedName.EndsWith("H741", StringComparison.OrdinalIgnoreCase) ||
            normalizedRegistryNumber.EndsWith("H741", StringComparison.OrdinalIgnoreCase))
        {
            return "1";
        }

        if (normalizedName.EndsWith("H742", StringComparison.OrdinalIgnoreCase) ||
            normalizedRegistryNumber.EndsWith("H742", StringComparison.OrdinalIgnoreCase))
        {
            return "2";
        }

        return null;
    }

    private static string NormalizeNumber(string? number) =>
        string.Concat((number ?? string.Empty).Where(char.IsLetterOrDigit)).ToUpperInvariant();

    private static string NormalizeMapNumber(string? number, string buildingPart, bool isH74)
    {
        if (!isH74)
        {
            return NormalizeNumber(number);
        }

        var value = number?.Trim() ?? string.Empty;
        var suffixSeparator = value.LastIndexOf('/');
        if (suffixSeparator >= 0)
        {
            var suffix = value[(suffixSeparator + 1)..].Trim();
            if (suffix is "1" or "2")
            {
                var roomNumber = value[..suffixSeparator];
                return suffix == buildingPart
                    ? NormalizeNumber(roomNumber)
                    : $"PART{suffix}_{NormalizeNumber(roomNumber)}";
            }
        }

        return NormalizeNumber(value);
    }

    private string GetMapAreaId(MapArea area) =>
        _isH74 ? $"H-74/{area.BuildingPart}/{area.Number}" : area.Number;

    private static string GetTooltip(Unit unit)
    {
        var status = GetStatusLabel(unit);
        if (!unit.IsMapped)
        {
            return $"Lokal {unit.Name} · brak dopasowanego rekordu w Wynajmie{(unit.BuildingName.Length > 0 ? $" dla budynku {unit.BuildingName}" : " dla budynku L-75")}.";
        }

        if (unit.IsCommonArea)
        {
            return $"{unit.BuildingName} {unit.Name} · {unit.Rental!.TypLokalu} · część wspólna\nPowierzchnia: {unit.Area:N2} m²";
        }

        var tenant = unit.IsRented ? unit.Tenant : unit.IsReserved ? "Rezerwacja w toku" : "Brak najemcy";
        var rent = unit.IsRented ? "Czynsz" : "Szacowany czynsz przy wynajmie";
        return $"{unit.BuildingName} {unit.Name} · {status} · {tenant}\nPowierzchnia całkowita: {unit.Area:N2} m²\nWynajęta: {unit.RentedArea:N2} m² · wolna: {unit.AvailableArea:N2} m²\nStawka: {unit.Rate:N2} zł/m²/mies.\n{rent}: {unit.MonthlyRent:N2} zł/mies.";
    }

    private static string GetUnitDisplayName(Unit unit) =>
        unit.BuildingName.Length == 0 ? unit.Name : $"{unit.BuildingName} · lokal {unit.Name}";

    private static string GetStatusClass(Unit unit) =>
        !unit.IsMapped ? "status-unmapped" : unit.IsCommonArea ? "status-common" : unit.IsReserved ? "status-reserved" : unit.IsPartiallyRented ? "status-partial" : unit.IsRented ? "status-rented" : "status-vacant";

    private static string GetStatusLabel(Unit unit) =>
        !unit.IsMapped ? "Brak danych" : unit.IsCommonArea ? unit.Rental!.TypLokalu : unit.IsReserved ? "Rezerwacja" : unit.IsPartiallyRented ? "Częściowo wynajęte" : unit.IsRented ? "Wynajęte" : "Wolne";

    private static string GetStatusColor(Unit unit) =>
        !unit.IsMapped ? "#7b8794" : unit.IsCommonArea ? "#5b4a9c" : unit.IsReserved ? "#b86a13" : unit.IsRented ? "#b83e45" : "#636b73";

    private static string GetStatusTint(Unit unit) =>
        !unit.IsMapped ? "#eef1f4" : unit.IsCommonArea ? "#eeeafb" : unit.IsReserved ? "#fff0dd" : unit.IsRented ? "#fde9e9" : "#eceff2";

    private static string GetFillColor(Unit unit) =>
        !unit.IsMapped ? "#eef1f4" : unit.IsCommonArea ? "#9384cf" : unit.IsReserved ? "#f3ad59" : unit.IsRented ? "#df7777" : "#d8dadd";

    private static string GetBaseFillColor(Unit unit) =>
        unit.IsPartiallyRented ? "#d8dadd" : GetFillColor(unit);

    private static string GetStrokeColor(Unit unit) =>
        !unit.IsMapped ? "#cbd2d9" : unit.IsCommonArea ? "#6c5ba8" : unit.IsReserved ? "#d17b1f" : unit.IsRented ? "#be4848" : "#ffffff";

    private void SetFilter(MapFilter filter) => _activeFilter = filter;

    private string GetFilterButtonStyle(MapFilter filter)
    {
        var isActive = _activeFilter == filter;
        var (border, background, color) = filter switch
        {
            MapFilter.Rented => ("#e6a2a2", isActive ? "#fff1f1" : "#ffffff", "#a33e43"),
            MapFilter.Vacant => ("#c5cbd0", isActive ? "#f0f2f3" : "#ffffff", "#535e68"),
            MapFilter.Reserved => ("#efc184", isActive ? "#fff5e7" : "#ffffff", "#a86517"),
            _ => ("#a8c2dc", isActive ? "#eef5fc" : "#ffffff", "#315f8c")
        };

        return $"display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:7px 12px;border:1px solid {border};border-radius:9px;background:{background};color:{color};font:inherit;font-size:13px;font-weight:{(isActive ? "700" : "500")};cursor:pointer;box-shadow:{(isActive ? "0 2px 7px rgba(30,48,70,.10)" : "none")};";
    }

    private string GetFilterClass(Unit unit) =>
        _activeFilter == MapFilter.All
            ? ""
            : !unit.IsMapped ? "status-muted" : IsInActiveFilter(unit) ? "status-highlighted" : "status-muted";

    private string GetFilterInlineStyle(Unit unit)
    {
        if (_activeFilter == MapFilter.All)
        {
            return string.Empty;
        }

        if (!unit.IsMapped || !IsInActiveFilter(unit))
        {
            return "opacity:.14;";
        }

        var (stroke, width) = _activeFilter switch
        {
            MapFilter.Rented => ("#a92e35", "4"),
            MapFilter.Vacant => ("#68727b", "4"),
            MapFilter.Reserved => ("#a95e0b", "4"),
            _ => ("#ffffff", "1.5")
        };

        return $"opacity:1;filter:saturate(1.25) brightness(1.04);stroke:{stroke};stroke-width:{width};";
    }

    private string GetLabelFilterInlineStyle(Unit unit) =>
        _activeFilter == MapFilter.All || (unit.IsMapped && IsInActiveFilter(unit)) ? "" : "opacity:.14;";

    private bool IsInActiveFilter(Unit unit) =>
        unit.IsMapped && _activeFilter switch
        {
            MapFilter.Rented => !unit.IsCommonArea && unit.IsRented,
            MapFilter.Vacant => !unit.IsCommonArea && unit.HasAvailableArea && !unit.IsReserved,
            MapFilter.Reserved => unit.IsReserved,
            _ => true
        };

    // Te metody obsługują otwieranie karty przez kliknięcie lub klawiaturę oraz jej zamknięcie.
    private void SelectUnit(Unit unit)
    {
        if (unit.IsMapped)
        {
            SelectedUnit = unit;
        }
    }
    private void ClearSelection() => SelectedUnit = null;

    private void HandleUnitKeyDown(KeyboardEventArgs args, Unit unit)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectUnit(unit);
        }
    }

    private static (string X, string Y) GetLabelPosition(string points)
    {
        var vertices = ParsePoints(points);

        // Środek ciężkości wielokąta umieszcza etykietę także w nieregularnych lokalach.
        var areaTwice = 0d;
        var xSum = 0d;
        var ySum = 0d;

        for (var index = 0; index < vertices.Length; index++)
        {
            var current = vertices[index];
            var next = vertices[(index + 1) % vertices.Length];
            var cross = current.X * next.Y - next.X * current.Y;
            areaTwice += cross;
            xSum += (current.X + next.X) * cross;
            ySum += (current.Y + next.Y) * cross;
        }

        if (Math.Abs(areaTwice) < 0.001)
        {
            // Dla zdegenerowanego wielokąta użyj średniej wierzchołków jako zapasowego położenia.
            return (
                vertices.Average(point => point.X).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
                vertices.Average(point => point.Y).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }

        return (
            (xSum / (3 * areaTwice)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            (ySum / (3 * areaTwice)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
    }

    private static PolygonSplit GetRentedSplit(Unit unit)
    {
        var vertices = ParsePoints(unit.Points);
        var minX = vertices.Min(point => point.X);
        var maxX = vertices.Max(point => point.X);
        var minY = vertices.Min(point => point.Y);
        var maxY = vertices.Max(point => point.Y);
        var targetArea = PolygonArea(vertices) * (double)(unit.RentedArea / unit.Area);
        var low = minY;
        var high = maxY;

        for (var iteration = 0; iteration < 48; iteration++)
        {
            var middle = (low + high) / 2;
            if (AreaAboveY(vertices, middle) < targetArea)
            {
                low = middle;
            }
            else
            {
                high = middle;
            }
        }

        var splitY = (low + high) / 2;
        return new PolygonSplit(minX, minY, maxX - minX, splitY - minY);
    }

    private static (double X, double Y)[] ParsePoints(string points) =>
        points.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(point => point.Split(','))
            .Select(point => (
                X: double.Parse(point[0], System.Globalization.CultureInfo.InvariantCulture),
                Y: double.Parse(point[1], System.Globalization.CultureInfo.InvariantCulture)))
            .ToArray();

    private static double AreaAboveY((double X, double Y)[] vertices, double y)
    {
        var clipped = new List<(double X, double Y)>();
        var previous = vertices[^1];
        var previousInside = previous.Y <= y;

        foreach (var current in vertices)
        {
            var currentInside = current.Y <= y;
            if (currentInside != previousInside)
            {
                var ratio = (y - previous.Y) / (current.Y - previous.Y);
                clipped.Add((previous.X + ratio * (current.X - previous.X), y));
            }

            if (currentInside)
            {
                clipped.Add(current);
            }

            previous = current;
            previousInside = currentInside;
        }

        return PolygonArea(clipped);
    }

    private static double PolygonArea(IReadOnlyList<(double X, double Y)> vertices)
    {
        if (vertices.Count < 3)
        {
            return 0;
        }

        var areaTwice = 0d;
        for (var index = 0; index < vertices.Count; index++)
        {
            var current = vertices[index];
            var next = vertices[(index + 1) % vertices.Count];
            areaTwice += current.X * next.Y - next.X * current.Y;
        }

        return Math.Abs(areaTwice) / 2;
    }

    private sealed record Unit(string Id, string Label, string BuildingPart, string Points, LokalWynajem? Rental)
    {
        public bool IsMapped => Rental is not null;
        public bool IsCommonArea => Rental?.CzyCzescWspolna == true;
        public string Name => Rental?.NumerLokalu ?? Label;
        public string BuildingName => BuildingPart.Length == 0 ? "" : $"H-74/{BuildingPart}";
        public string Tenant
        {
            get
            {
                var activeTenants = Rental?.HistoriaUmow
                    .Where(relation => relation.UmowaNajmu?.CzyAktywna == true)
                    .Select(relation => relation.UmowaNajmu?.Najemca?.NazwaFirmyOsoby)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                return activeTenants is { Count: > 0 }
                    ? string.Join(Environment.NewLine, activeTenants)
                    : Rental?.Najemca?.NazwaFirmyOsoby ?? "Brak najemcy";
            }
        }
        public decimal Area => Rental?.PowierzchniaM2 ?? 0;
        public decimal RentedArea => Math.Clamp(Rental?.PowierzchniaWynajetaM2 ?? 0, 0, Area);
        public decimal AvailableArea => IsCommonArea || IsReserved ? 0 : Math.Max(0, Area - RentedArea);
        public bool IsPartiallyRented => RentedArea > 0 && HasAvailableArea;
        public bool HasAvailableArea => AvailableArea > 0;
        public decimal Rate
        {
            get
            {
                if (Rental is null)
                {
                    return 0;
                }

                return RentedArea > 0
                    ? Rental.CzynszWynajetyMiesiecznie / RentedArea
                    : Rental.CenaZaM2;
            }
        }
        public decimal MonthlyRent => Rental is null
            ? 0
            : IsRented
                ? Rental.CzynszWynajetyMiesiecznie
                : Rental.PowierzchniaDostepnaM2 * Rental.CenaZaM2;
        public bool IsReserved => !IsCommonArea && Rental?.StatusAktualny == "Zarezerwowany";
        public bool IsRented => !IsCommonArea && (RentedArea > 0 || Rental?.StatusAktualny == "Wynajęty");
    }

    private sealed record PolygonSplit(double X, double Y, double Width, double Height);

    private sealed record MapArea(string Number, string Points, string BuildingPart = "");

    private enum MapFilter
    {
        All,
        Rented,
        Vacant,
        Reserved
    }
}
