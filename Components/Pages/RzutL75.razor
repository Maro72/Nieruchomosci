@page "/rzut-l75"
@attribute [Authorize(Policy = "Budynki.Odczyt")]
@using MudBlazor

<PageTitle>Rzut budynku L-75</PageTitle>

<div class="l75-page">
    <header class="l75-header">
        <div class="l75-title-block">
            <div class="l75-eyebrow"><span>Nieruchomości</span><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /><span>Budynki</span></div>
            <h1>Rzut budynku <span>L-75</span></h1>
            <p>Wybierz lokal na planie, aby sprawdzić szczegóły najmu i powierzchnię.</p>
        </div>
    
    </header>

    @* Liczniki statusów są jednocześnie przełącznikami podświetlania lokali na rzucie. *@
    <section class="l75-summary" aria-label="Wyróżnij lokale na rzucie">
        <span class="summary-prompt" style="display:block;margin:0 0 7px;color:#52657b;font-size:13px;font-weight:700;">Wyróżnij na rzucie</span>
        <div class="summary-filters" style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button" class="summary-filter filter-all @(_activeFilter == MapFilter.All ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.All)"
                    aria-pressed="@(_activeFilter == MapFilter.All)" @onclick="() => SetFilter(MapFilter.All)">
                <span>Wszystkie</span><strong>@_units.Count</strong>
            </button>
            <button type="button" class="summary-filter filter-rented @(_activeFilter == MapFilter.Rented ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Rented)"
                    aria-pressed="@(_activeFilter == MapFilter.Rented)" @onclick="() => SetFilter(MapFilter.Rented)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#df7777;"></i><span>Wynajęte</span><strong>@_units.Count(unit => unit.IsRented)</strong>
            </button>
            <button type="button" class="summary-filter filter-vacant @(_activeFilter == MapFilter.Vacant ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Vacant)"
                    aria-pressed="@(_activeFilter == MapFilter.Vacant)" @onclick="() => SetFilter(MapFilter.Vacant)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#b5bbc1;"></i><span>Wolne</span><strong>@_units.Count(unit => !unit.IsRented && !unit.IsReserved)</strong>
            </button>
            <button type="button" class="summary-filter filter-reserved @(_activeFilter == MapFilter.Reserved ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Reserved)"
                    aria-pressed="@(_activeFilter == MapFilter.Reserved)" @onclick="() => SetFilter(MapFilter.Reserved)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#f3ad59;"></i><span>Rezerwacje</span><strong>@_units.Count(unit => unit.IsReserved)</strong>
            </button>
        </div>
    </section>

    <section class="l75-workspace">
        <MudCard Class="l75-plan-card" Elevation="1" Outlined="true"
                 Style="width: min(100%, 900px); margin: 20px auto 0;">
            <MudCardContent Class="pa-3">
            
            <div class="l75-plan-scroll" style="overflow: hidden;">
                <div class="l75-plan" style="width: min(100%, 760px); margin: 0 auto; aspect-ratio: 1221 / 768;">
                    @* Współrzędne pól są zapisane w skali viewBox i stanowią przykładowy układ rzutu. *@
                    <svg viewBox="0 0 1221 768" role="group" aria-label="Klikalne pola budynku L-75"
                         style="display: block; width: 100%; height: auto;">
                        <polygon points="4,24 1197,24 1203,750 3,750"
                                 fill="#fff"
                                 stroke="none" />
                        @foreach (var unit in _units)
                        {
                            var labelPosition = GetLabelPosition(unit.Points);
                            <g class="map-unit @GetStatusClass(unit)">
                                <polygon points="@unit.Points"
                                         class="map-area @GetStatusClass(unit) @GetFilterClass(unit) @(SelectedUnit?.Id == unit.Id ? "map-selected" : "")"
                                         fill="@GetFillColor(unit)"
                                         stroke="@GetStrokeColor(unit)"
                                         stroke-width="1.5"
                                         style="@GetFilterInlineStyle(unit)"
                                         tabindex="0"
                                         role="button"
                                         aria-label="@GetTooltip(unit)"
                                         aria-pressed="@(SelectedUnit?.Id == unit.Id)"
                                         @onclick="() => SelectUnit(unit)"
                                         @onclick:stopPropagation="true"
                                         @onkeydown="args => HandleUnitKeyDown(args, unit)">
                                    <title>@GetTooltip(unit)</title>
                                </polygon>
                                <text class="map-label @GetFilterClass(unit)"
                                      x="@labelPosition.X"
                                      y="@labelPosition.Y"
                                      font-size="@(unit.Area < 50 ? "14" : "25")"
                                      text-anchor="middle"
                                      dominant-baseline="central"
                                      style="@GetLabelFilterInlineStyle(unit)"
                                      pointer-events="none">@unit.Id</text>
                            </g>
                        }
                        <polygon points="4,24 1197,24 1203,750 3,750"
                                 class="map-building-outline"
                                 fill="none"
                                 stroke="#707478"
                                 stroke-width="6"
                                 pointer-events="none" />
                    </svg>
                </div>
            </div>
            
            </MudCardContent>
        </MudCard>

        @* Karta szczegółów jest pokazywana dopiero po wybraniu lokalu na rzucie. *@
        @if (SelectedUnit is not null)
        {
            <div class="l75-detail-backdrop"
                 style="position:fixed;inset:0;z-index:1600;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.58);backdrop-filter:blur(4px)"
                 @onclick="ClearSelection">
                <aside class="l75-detail"
                       style="position:relative;display:block;flex:0 1 440px;width:min(440px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow-y:auto;border:1px solid #e4eaf1;border-radius:18px;background:#fff;color:#1d2e46;box-shadow:0 28px 90px rgba(8,20,38,.32)"
                       aria-live="polite"
                       aria-label="Szczegóły wybranego pola"
                       @onclick:stopPropagation="true">
                <div class="detail-card-header" style="display:flex;align-items:center;gap:14px;padding:22px 24px;border-bottom:1px solid #e9edf2;background:linear-gradient(135deg,#fbfcfe,#f1f5f9)">
                    <div class="detail-card-icon @GetStatusClass(SelectedUnit)" style="@($"display:grid;place-items:center;flex:0 0 48px;width:48px;height:48px;border-radius:14px;background:{GetStatusTint(SelectedUnit)};color:{GetStatusColor(SelectedUnit)}")">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Style="font-size:24px" />
                    </div>
                    <div class="detail-card-heading" style="display:flex;flex:1;min-width:0;flex-direction:column;gap:4px">
                        <span style="color:#8290a1;font-size:11px;font-weight:800;letter-spacing:.12em">SZCZEGÓŁY LOKALU</span>
                        <strong style="overflow:hidden;color:#1d2e46;font-size:21px;font-weight:750;line-height:1.2;text-overflow:ellipsis;white-space:nowrap">@SelectedUnit.Name</strong>
                    </div>
                    <button type="button" class="detail-close" style="display:grid;place-items:center;width:36px;height:36px;border:1px solid #e2e8ef;border-radius:10px;background:#fff;color:#66768b;cursor:pointer" aria-label="Zamknij szczegóły pola" @onclick="ClearSelection">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:20px" />
                    </button>
                </div>

                <div class="detail-card-content" style="padding:24px">
                    <div class="l75-detail-status @GetStatusClass(SelectedUnit)" style="@($"display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;padding:7px 12px;border-radius:20px;background:{GetStatusTint(SelectedUnit)};color:{GetStatusColor(SelectedUnit)};font-size:13px;font-weight:750")">
                        <span class="status-dot" style="@($"width:8px;height:8px;border-radius:50%;background:{GetStatusColor(SelectedUnit)}")"></span>
                        @GetStatusLabel(SelectedUnit)
                    </div>
                    <div class="detail-field" style="display:flex;flex-direction:column;gap:6px;padding:0 0 17px;border-bottom:1px solid #edf0f4">
                        <span style="color:#8491a2;font-size:12px;font-weight:600">NAJEMCA</span>
                        <strong style="color:#263d5f;font-size:16px;font-weight:700">@(SelectedUnit.IsRented ? SelectedUnit.Tenant : SelectedUnit.IsReserved ? "Rezerwacja w toku" : "Brak — lokal wolny")</strong>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px">
                        <div style="padding:14px;border:1px solid #e8edf2;border-radius:12px;background:#f8fafc">
                            <span style="display:block;margin-bottom:6px;color:#8491a2;font-size:12px;font-weight:600">POWIERZCHNIA</span>
                            <strong style="color:#263d5f;font-size:18px;font-weight:750">@SelectedUnit.Area.ToString("N0") <small style="font-size:12px">m²</small></strong>
                        </div>
                        <div style="padding:14px;border:1px solid #e8edf2;border-radius:12px;background:#f8fafc">
                            <span style="display:block;margin-bottom:6px;color:#8491a2;font-size:12px;font-weight:600">STAWKA</span>
                            <strong style="color:#263d5f;font-size:16px;font-weight:750">@SelectedUnit.Rate.ToString("N2") <small style="font-size:12px">zł/m²</small></strong>
                        </div>
                    </div>
                    <div class="detail-rent" style="display:flex;flex-direction:column;gap:7px;margin-top:16px;padding:18px;border:1px solid #dbe7f4;border-radius:13px;background:linear-gradient(135deg,#f1f6fc,#eaf2fb)">
                        <span style="color:#6e8096;font-size:12px;font-weight:650">@(SelectedUnit.IsRented ? "CZYNSZ MIESIĘCZNY" : "SZACOWANY CZYNSZ MIESIĘCZNY")</span>
                        <strong style="color:#244f83;font-size:26px;font-weight:800;letter-spacing:-.03em">@SelectedUnit.MonthlyRent.ToString("N2") <small style="font-size:13px;font-weight:600;letter-spacing:0">zł / mies.</small></strong>
                    </div>
                    <p class="l75-disclaimer" style="margin:16px 0 0;color:#8995a4;font-size:11px;line-height:1.5">Dane demonstracyjne — nie pochodzą z bazy umów.</p>
                </div>
                </aside>
            </div>
        }
    </section>
</div>

@code {
    private Unit? SelectedUnit;
    private MapFilter _activeFilter = MapFilter.All;

    // Dane służą wyłącznie do prezentacji rzutu i nie są pobierane z bazy.
    private readonly List<Unit> _units =
    [
        // Kolejność współrzędnych w każdym wielokącie: x,y; punkty podano w układzie SVG.
        new("1", "Pole 1", "Biuro Północ", 126m, 28m, true, "4,24 146,24 146,101 4,101"),
        new("2", "Pole 2", "—", 118m, 27m, false, "149,24 275,24 275,101 149,101"),
        new("3", "Pole 3", "Magazyn Delta", 512m, 24m, true, "4,115 273,115 273,688 138,688 138,746 3,746"),
        new("4", "Pole 4", "—", 72m, 26m, false, "140,692 273,692 273,746 140,746"),
        new("5", "Pole 5", "LogiMax", 294m, 25m, true, "324,110 598,110 598,247 324,247"),
        new("6", "Pole 6", "—", 236m, 25m, false, "324,272 599,272 599,381 324,381"),
        new("7", "Pole 7", "Serwis-Tech", 236m, 24m, true, "324,384 600,384 600,491 324,491"),
        new("8", "Pole 8", "—", 236m, 26m, false, "324,494 602,494 602,605 324,605"),
        new("9", "Pole 9", "Baltic Trade", 92m, 27m, true, "324,632 433,632 433,746 324,746"),
        new("10", "Pole 10", "—", 146m, 27m, false, "436,632 603,632 603,746 436,746"),
        new("11", "Pole 11", "Transport Plus", 222m, 24m, true, "600,110 870,110 870,162 600,162"),
        new("12", "Pole 12", "—", 219m, 26m, false, "600,165 870,165 870,247 600,247"),
        new("13", "Pole 13", "Elektro-Mix", 123m, 29m, true, "602,272 742,272 742,381 602,381"),
        new("14", "Pole 14", "—", 98m, 28m, false, "745,272 870,272 870,381 745,381"),
        new("15", "Pole 15", "Pak-System", 220m, 25m, true, "603,384 870,384 870,491 603,491"),
        new("16", "Pole 16", "—", 232m, 26m, false, "605,494 870,494 870,605 605,605", true),
        new("17", "Pole 17", "Archiwum Północ", 228m, 23m, true, "606,632 870,632 870,746 606,746"),
        new("18", "Pole 18", "Centrum Logistyczne", 862m, 22m, true, "904,24 1197,24 1200,371 904,371"),
        new("19", "Pole 19", "—", 432m, 23m, false, "904,377 1200,377 1203,746 1062,746 1062,688 904,688 904,746"),
        new("20", "Pole 20", "Kurier Gdańsk", 117m, 28m, true, "904,688 1062,688 1062,746 904,746"),
        new("01", "Lokal 01", "—", 18m, 38m, false, "325,24 360,24 360,74 325,74"),
        new("02", "Lokal 02", "Studio Forma", 17m, 39m, true, "363,24 393,24 393,74 363,74"),
        new("03", "Lokal 03", "—", 22m, 38m, false, "396,24 431,24 431,74 396,74"),
        new("04", "Lokal 04", "Krawiectwo Ada", 30m, 37m, true, "434,24 471,24 471,74 434,74"),
        new("05", "Lokal 05", "—", 35m, 38m, false, "474,24 511,24 511,74 474,74"),
        new("06", "Lokal 06", "Punkt Serwisowy", 32m, 38m, true, "514,24 541,24 541,74 514,74"),
        new("07", "Lokal 07", "—", 27m, 39m, false, "544,24 569,24 569,74 544,74"),
        new("08", "Lokal 08", "Kiosk L-75", 24m, 38m, true, "572,24 597,24 597,74 572,74"),
        new("09", "Lokal 09", "—", 26m, 39m, false, "600,24 625,24 625,74 600,74"),
        new("010", "Lokal 010", "—", 32m, 38m, false, "628,24 700,24 700,74 628,74", true),
        new("011", "Lokal 011", "—", 164m, 31m, false, "703,24 870,24 870,74 703,74")
    ];

    private static string GetTooltip(Unit unit)
    {
        // Wolne i zarezerwowane lokale pokazują szacowany czynsz zamiast aktualnego czynszu.
        var status = GetStatusLabel(unit);
        var tenant = unit.IsRented ? unit.Tenant : unit.IsReserved ? "Rezerwacja w toku" : "Brak najemcy";
        var rent = unit.IsRented ? "Czynsz" : "Szacowany czynsz przy wynajmie";
        return $"{unit.Name} · {status} · {tenant}\nPowierzchnia: {unit.Area:N0} m²\nStawka: {unit.Rate:N2} zł/m²/mies.\n{rent}: {unit.MonthlyRent:N2} zł/mies.";
    }

    // Status rezerwacji ma pierwszeństwo przed pozostałymi wartościami statusu.
    private static string GetStatusClass(Unit unit) =>
        unit.IsReserved ? "status-reserved" : unit.IsRented ? "status-rented" : "status-vacant";

    private static string GetStatusLabel(Unit unit) =>
        unit.IsReserved ? "Rezerwacja" : unit.IsRented ? "Wynajęte" : "Wolne";

    private static string GetStatusColor(Unit unit) =>
        unit.IsReserved ? "#b86a13" : unit.IsRented ? "#b83e45" : "#636b73";

    private static string GetStatusTint(Unit unit) =>
        unit.IsReserved ? "#fff0dd" : unit.IsRented ? "#fde9e9" : "#eceff2";

    private static string GetFillColor(Unit unit) =>
        unit.IsReserved ? "#f3ad59" : unit.IsRented ? "#df7777" : "#d8dadd";

    private static string GetStrokeColor(Unit unit) =>
        unit.IsReserved ? "#d17b1f" : unit.IsRented ? "#be4848" : "#ffffff";

    private void SetFilter(MapFilter filter) => _activeFilter = filter;

    private string GetFilterButtonStyle(MapFilter filter)
    {
        var isActive = _activeFilter == filter;
        var (border, background, color) = filter switch
        {
            MapFilter.Rented => ("#e6a2a2", isActive ? "#fff1f1" : "#ffffff", "#a33e43"),
            MapFilter.Vacant => ("#c5cbd0", isActive ? "#f0f2f3" : "#ffffff", "#535e68"),
            MapFilter.Reserved => ("#efc184", isActive ? "#fff5e7" : "#ffffff", "#a86517"),
            _ => ("#a8c2dc", isActive ? "#eef5fc" : "#ffffff", "#315f8c")
        };

        return $"display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:7px 12px;border:1px solid {border};border-radius:9px;background:{background};color:{color};font:inherit;font-size:13px;font-weight:{(isActive ? "700" : "500")};cursor:pointer;box-shadow:{(isActive ? "0 2px 7px rgba(30,48,70,.10)" : "none")};";
    }

    private string GetFilterClass(Unit unit) =>
        _activeFilter == MapFilter.All
            ? ""
            : IsInActiveFilter(unit) ? "status-highlighted" : "status-muted";

    private string GetFilterInlineStyle(Unit unit)
    {
        if (_activeFilter == MapFilter.All)
        {
            return string.Empty;
        }

        if (!IsInActiveFilter(unit))
        {
            return "opacity:.14;";
        }

        var (stroke, width) = _activeFilter switch
        {
            MapFilter.Rented => ("#a92e35", "4"),
            MapFilter.Vacant => ("#68727b", "4"),
            MapFilter.Reserved => ("#a95e0b", "4"),
            _ => ("#ffffff", "1.5")
        };

        return $"opacity:1;filter:saturate(1.25) brightness(1.04);stroke:{stroke};stroke-width:{width};";
    }

    private string GetLabelFilterInlineStyle(Unit unit) =>
        _activeFilter == MapFilter.All || IsInActiveFilter(unit) ? "" : "opacity:.14;";

    private bool IsInActiveFilter(Unit unit) =>
        _activeFilter switch
        {
            MapFilter.Rented => unit.IsRented,
            MapFilter.Vacant => !unit.IsRented && !unit.IsReserved,
            MapFilter.Reserved => unit.IsReserved,
            _ => true
        };

    // Te metody obsługują otwieranie karty przez kliknięcie lub klawiaturę oraz jej zamknięcie.
    private void SelectUnit(Unit unit) => SelectedUnit = unit;
    private void ClearSelection() => SelectedUnit = null;

    private void HandleUnitKeyDown(KeyboardEventArgs args, Unit unit)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectUnit(unit);
        }
    }

    private static (string X, string Y) GetLabelPosition(string points)
    {
        var vertices = points.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(point => point.Split(','))
            .Select(point => (X: double.Parse(point[0], System.Globalization.CultureInfo.InvariantCulture),
                              Y: double.Parse(point[1], System.Globalization.CultureInfo.InvariantCulture)))
            .ToArray();

        // Środek ciężkości wielokąta umieszcza etykietę także w nieregularnych lokalach.
        var areaTwice = 0d;
        var xSum = 0d;
        var ySum = 0d;

        for (var index = 0; index < vertices.Length; index++)
        {
            var current = vertices[index];
            var next = vertices[(index + 1) % vertices.Length];
            var cross = current.X * next.Y - next.X * current.Y;
            areaTwice += cross;
            xSum += (current.X + next.X) * cross;
            ySum += (current.Y + next.Y) * cross;
        }

        if (Math.Abs(areaTwice) < 0.001)
        {
            // Dla zdegenerowanego wielokąta użyj średniej wierzchołków jako zapasowego położenia.
            return (
                vertices.Average(point => point.X).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
                vertices.Average(point => point.Y).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }

        return (
            (xSum / (3 * areaTwice)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            (ySum / (3 * areaTwice)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
    }

    private sealed record Unit(
        string Id,
        string Name,
        string Tenant,
        decimal Area,
        decimal Rate,
        bool IsRented,
        string Points,
        bool IsReserved = false)
    {
        public decimal MonthlyRent => Area * Rate;
    }

    private enum MapFilter
    {
        All,
        Rented,
        Vacant,
        Reserved
    }
}
