@page "/rzut-l75"
@page "/rzut-h74"
@attribute [Authorize(Policy = "Lokale.Odczyt")]
@implements IDisposable
@using MudBlazor
@using System.Data.Common
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@inject ILokalWynajemService LokalService
@inject IObiektService ObiektService
@inject ILogger<RzutL75> Logger
@inject NavigationManager NavigationManager

<PageTitle>Rzut budynku @BuildingTitle</PageTitle>

<div class="l75-page">
    <header class="l75-header">
        <div class="l75-title-block">
            <div class="l75-eyebrow"><span>Nieruchomości</span><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /><span>Budynki</span></div>
            <h1>Rzut budynku <span>@BuildingTitle</span></h1>
            <p>Wybierz lokal na planie, aby sprawdzić szczegóły najmu i powierzchnię.</p>
        </div>
        @if (_selectedBuilding is not null)
        {
            <div class="l75-demo-badge">
                <MudIcon Icon="@Icons.Material.Filled.Domain" />
                <span>@(_isH74 ? "H-74/1 i H-74/2" : _selectedBuilding.Nazwa) · dane z Wynajmu</span>
            </div>
        }
    </header>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
    }
    else
    {
    @if (_unmatchedMapNumbers.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
            Brak lokalu w Wynajmie dla numerów na rzucie: @string.Join(", ", _unmatchedMapNumbers).
        </MudAlert>
    }
    @if (_unplacedRentalNumbers.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
            Lokale z Wynajmu bez pola na tym rzucie: @string.Join(", ", _unplacedRentalNumbers).
        </MudAlert>
    }

    @* Liczniki statusów są jednocześnie przełącznikami podświetlania lokali na rzucie. *@
    <section class="l75-summary" aria-label="Wyróżnij lokale na rzucie">
        <span class="summary-prompt" style="display:block;margin:0 0 7px;color:#52657b;font-size:13px;font-weight:700;">Wyróżnij na rzucie</span>
        <div class="summary-filters" style="display:flex;flex-wrap:wrap;gap:8px;">
            <button type="button" class="summary-filter filter-all @(_activeFilter == MapFilter.All ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.All)"
                    aria-pressed="@(_activeFilter == MapFilter.All)" @onclick="() => SetFilter(MapFilter.All)">
                <span>Wszystkie</span><strong>@_units.Count(unit => unit.IsMapped)</strong>
            </button>
            <button type="button" class="summary-filter filter-rented @(_activeFilter == MapFilter.Rented ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Rented)"
                    aria-pressed="@(_activeFilter == MapFilter.Rented)" @onclick="() => SetFilter(MapFilter.Rented)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#df7777;"></i><span>Wynajęte</span><strong>@_units.Count(unit => unit.IsMapped && unit.IsRented)</strong>
            </button>
            <button type="button" class="summary-filter filter-vacant @(_activeFilter == MapFilter.Vacant ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Vacant)"
                    aria-pressed="@(_activeFilter == MapFilter.Vacant)" @onclick="() => SetFilter(MapFilter.Vacant)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#b5bbc1;"></i><span>Wolne</span><strong>@_units.Count(unit => unit.IsMapped && unit.HasAvailableArea && !unit.IsReserved)</strong>
            </button>
            <button type="button" class="summary-filter filter-reserved @(_activeFilter == MapFilter.Reserved ? "filter-active" : "")"
                    style="@GetFilterButtonStyle(MapFilter.Reserved)"
                    aria-pressed="@(_activeFilter == MapFilter.Reserved)" @onclick="() => SetFilter(MapFilter.Reserved)">
                <i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#f3ad59;"></i><span>Rezerwacje</span><strong>@_units.Count(unit => unit.IsMapped && unit.IsReserved)</strong>
            </button>
        </div>
    </section>

    <section class="l75-workspace">
        <MudCard Class="l75-plan-card" Elevation="1" Outlined="true"
                 Style="width: min(100%, 900px); margin: 20px auto 0;">
            <MudCardContent Class="pa-3">
            <div class="l75-plan-scroll" style="overflow: hidden;">
                <div class="l75-plan" style="@($"width: min(100%, 900px); margin: 0 auto; aspect-ratio: {(_isH74 ? "1635 / 768" : "1221 / 768")};")">
                    @* Geometria jest stała; status i szczegóły są powiązane z Wynajmem po numerze lokalu. *@
                    <svg viewBox="@(_isH74 ? "0 0 1635 768" : "0 0 1221 768")" role="group" aria-label="Klikalne pola budynku @BuildingTitle"
                         style="display: block; width: 100%; height: auto;">
                        <polygon points="@(_isH74 ? "26,44 1585,44 1585,746 26,746" : "4,24 1197,24 1203,750 3,750")"
                                 fill="#fff"
                                 stroke="none" />
                        @if (_isH74)
                        {
                            @((MarkupString)"<text x=\"28\" y=\"36\" font-size=\"18\" font-weight=\"700\">Rzut budynku H-74/1</text>")
                            @((MarkupString)"<text x=\"820\" y=\"36\" font-size=\"18\" font-weight=\"700\">Rzut budynku H-74/2</text>")
                        }
                        @foreach (var unit in _units)
                        {
                            var labelPosition = GetLabelPosition(unit.Points);
                            <g class="map-unit @GetStatusClass(unit)">
                                <polygon points="@unit.Points"
                                         class="map-area @GetStatusClass(unit) @GetFilterClass(unit) @(SelectedUnit?.Id == unit.Id ? "map-selected" : "")"
                                         fill="@GetBaseFillColor(unit)"
                                         stroke="@GetStrokeColor(unit)"
                                         stroke-width="1.5"
                                         style="@GetFilterInlineStyle(unit)"
                                         tabindex="@(unit.IsMapped ? 0 : -1)"
                                         role="@(unit.IsMapped ? "button" : "img")"
                                         aria-disabled="@(!unit.IsMapped)"
                                         aria-label="@GetTooltip(unit)"
                                         aria-pressed="@(SelectedUnit?.Id == unit.Id)"
                                         @onclick="() => SelectUnit(unit)"
                                         @onclick:stopPropagation="true"
                                         @onkeydown="args => HandleUnitKeyDown(args, unit)">
                                    <title>@GetTooltip(unit)</title>
                                </polygon>
                                @if (unit.IsPartiallyRented)
                                {
                                    var split = GetRentedSplit(unit);
                                    var clipId = $"unit-clip-{NormalizeNumber(unit.Id)}";
                                    <defs>
                                        <clipPath id="@clipId" clipPathUnits="userSpaceOnUse">
                                            <polygon points="@unit.Points" />
                                        </clipPath>
                                    </defs>
                                    <rect x="@split.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                          y="@split.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                          width="@split.Width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                          height="@split.Height.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                          fill="#df7777"
                                          clip-path="@($"url(#{clipId})")"
                                          style="@GetFilterInlineStyle(unit)"
                                          pointer-events="none" />
                                    <polygon points="@unit.Points"
                                             fill="none"
                                             stroke="@GetStrokeColor(unit)"
                                             stroke-width="1.5"
                                             style="@GetFilterInlineStyle(unit)"
                                             pointer-events="none" />
                                }
                                <text class="map-label @GetFilterClass(unit)"
                                      x="@labelPosition.X"
                                      y="@labelPosition.Y"
                                      font-size="@(unit.Area < 50 ? "14" : "25")"
                                      text-anchor="middle"
                                      dominant-baseline="central"
                                      style="@GetLabelFilterInlineStyle(unit)"
                                      pointer-events="none">@unit.Label</text>
                            </g>
                        }
                        @if (_isH74)
                        {
                            <rect x="989" y="98" width="427" height="26"
                                  fill="@(_hasH74Part2Corridor ? "#9384cf" : "#fff")"
                                  pointer-events="none" />
                            <rect x="1244" y="45" width="44" height="53" fill="#fff" pointer-events="none" />
                            <path d="M817 44 V746 M26 149 H160 M26 330 H160 M26 407 H160 M26 537 H160 M26 615 H160 M160 44 V746 M203 149 H631 M203 253 H631 M203 330 H631 M203 435 H631 M203 537 H631 M203 746 H631 M203 149 V746 M418 149 V176 M503 149 V330 M503 539 V746 M631 149 V746 M676 44 V746 M676 537 H817 M820 44 V746 M1201 124 V746 M1201 537 H1585" fill="none" stroke="#707478" stroke-width="1.5" pointer-events="none" />
                            <path d="M1244 44 V98 M1288 44 V98" fill="none" stroke="#707478" stroke-width="1.5" pointer-events="none" />
                            <path d="M989 98 H1416 V124 H989 Z" fill="none" stroke="#707478" stroke-width="1.5" pointer-events="none" />
                        }
                        <polygon points="@(_isH74 ? "26,44 1585,44 1585,746 26,746" : "4,24 1197,24 1203,750 3,750")"
                                 class="map-building-outline"
                                 fill="none"
                                 stroke="#707478"
                                 stroke-width="@(_isH74 ? "10" : "6")"
                                 pointer-events="none" />
                    </svg>
                </div>
            </div>
            
            </MudCardContent>
        </MudCard>

        @* Karta szczegółów jest pokazywana dopiero po wybraniu lokalu na rzucie. *@
        @if (SelectedUnit is not null)
        {
            <div class="l75-detail-backdrop"
                 style="position:fixed;inset:0;z-index:1600;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.58);backdrop-filter:blur(4px)"
                 @onclick="ClearSelection">
                <aside class="l75-detail"
                       style="position:relative;display:block;flex:0 1 440px;width:min(440px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow-y:auto;border:1px solid #e4eaf1;border-radius:18px;background:#fff;color:#1d2e46;box-shadow:0 28px 90px rgba(8,20,38,.32)"
                       aria-live="polite"
                       aria-label="Szczegóły wybranego pola"
                       @onclick:stopPropagation="true">
                <div class="detail-card-header" style="display:flex;align-items:center;gap:14px;padding:22px 24px;border-bottom:1px solid #e9edf2;background:linear-gradient(135deg,#fbfcfe,#f1f5f9)">
                    <div class="detail-card-icon @GetStatusClass(SelectedUnit)" style="@($"display:grid;place-items:center;flex:0 0 48px;width:48px;height:48px;border-radius:14px;background:{GetStatusTint(SelectedUnit)};color:{GetStatusColor(SelectedUnit)}")">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Style="font-size:24px" />
                    </div>
                    <div class="detail-card-heading" style="display:flex;flex:1;min-width:0;flex-direction:column;gap:4px">
                        <span style="color:#8290a1;font-size:11px;font-weight:800;letter-spacing:.12em">@(SelectedUnit.IsCommonArea ? "SZCZEGÓŁY POMIESZCZENIA" : "SZCZEGÓŁY LOKALU")</span>
                        <strong style="overflow:hidden;color:#1d2e46;font-size:21px;font-weight:750;line-height:1.2;text-overflow:ellipsis;white-space:nowrap">@GetUnitDisplayName(SelectedUnit)</strong>
                    </div>
                    <button type="button" class="detail-close" style="display:grid;place-items:center;width:36px;height:36px;border:1px solid #e2e8ef;border-radius:10px;background:#fff;color:#66768b;cursor:pointer" aria-label="Zamknij szczegóły pola" @onclick="ClearSelection">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:20px" />
                    </button>
                </div>

                <div class="detail-card-content" style="padding:24px">
                    <div class="l75-detail-status @GetStatusClass(SelectedUnit)" style="@($"display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;padding:7px 12px;border-radius:20px;background:{GetStatusTint(SelectedUnit)};color:{GetStatusColor(SelectedUnit)};font-size:13px;font-weight:750")">
                        <span class="status-dot" style="@($"width:8px;height:8px;border-radius:50%;background:{GetStatusColor(SelectedUnit)}")"></span>
                        @GetStatusLabel(SelectedUnit)
                    </div>
                    <div class="detail-field" style="display:flex;flex-direction:column;gap:6px;padding:0 0 17px;border-bottom:1px solid #edf0f4">
                        <span style="color:#8491a2;font-size:12px;font-weight:600">@(SelectedUnit.IsCommonArea ? "RODZAJ" : "NAJEMCA")</span>
                        <strong style="color:#263d5f;font-size:16px;font-weight:700;white-space:pre-line">@(SelectedUnit.IsCommonArea ? SelectedUnit.Rental!.TypLokalu : SelectedUnit.IsRented ? SelectedUnit.Tenant : SelectedUnit.IsReserved ? "Rezerwacja w toku" : "Brak — lokal wolny")</strong>
                    </div>
                    <div style="@($"display:grid;grid-template-columns:{(SelectedUnit.IsCommonArea ? "1fr" : "1fr 1fr")};gap:12px;margin-top:16px")">
                        <div style="padding:14px;border:1px solid #e8edf2;border-radius:12px;background:#f8fafc">
                            <span style="display:block;margin-bottom:6px;color:#8491a2;font-size:12px;font-weight:600">POWIERZCHNIA</span>
                            <strong style="color:#263d5f;font-size:18px;font-weight:750">@SelectedUnit.Area.ToString("N2") <small style="font-size:12px">m²</small></strong>
                        </div>
                        @if (!SelectedUnit.IsCommonArea)
                        {
                            <div style="padding:14px;border:1px solid #e8edf2;border-radius:12px;background:#f8fafc">
                                <span style="display:block;margin-bottom:6px;color:#8491a2;font-size:12px;font-weight:600">STAWKA</span>
                                <strong style="color:#263d5f;font-size:16px;font-weight:750">@SelectedUnit.Rate.ToString("N2") <small style="font-size:12px">zł/m²</small></strong>
                            </div>
                        }
                    </div>
                    @if (!SelectedUnit.IsCommonArea)
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
                            <div style="padding:14px;border:1px solid #f0d1d1;border-radius:12px;background:#fff7f7">
                                <span style="display:block;margin-bottom:6px;color:#9b6666;font-size:12px;font-weight:600">POWIERZCHNIA WYNAJĘTA</span>
                                <strong style="color:#a33e43;font-size:16px;font-weight:750">@SelectedUnit.RentedArea.ToString("N2") <small style="font-size:12px">m²</small></strong>
                            </div>
                            <div style="padding:14px;border:1px solid #dfe3e6;border-radius:12px;background:#f6f7f8">
                                <span style="display:block;margin-bottom:6px;color:#73808a;font-size:12px;font-weight:600">POWIERZCHNIA WOLNA</span>
                                <strong style="color:#535e68;font-size:16px;font-weight:750">@SelectedUnit.AvailableArea.ToString("N2") <small style="font-size:12px">m²</small></strong>
                            </div>
                        </div>
                    }
                    @if (!SelectedUnit.IsCommonArea)
                    {
                        <div class="detail-rent" style="display:flex;flex-direction:column;gap:7px;margin-top:16px;padding:18px;border:1px solid #dbe7f4;border-radius:13px;background:linear-gradient(135deg,#f1f6fc,#eaf2fb)">
                            <span style="color:#6e8096;font-size:12px;font-weight:650">@(SelectedUnit.IsRented ? "CZYNSZ MIESIĘCZNY" : "SZACOWANY CZYNSZ MIESIĘCZNY")</span>
                            <strong style="color:#244f83;font-size:26px;font-weight:800;letter-spacing:-.03em">@SelectedUnit.MonthlyRent.ToString("N2") <small style="font-size:13px;font-weight:600;letter-spacing:0">zł / mies.</small></strong>
                        </div>
                    }
                    <p class="l75-disclaimer" style="margin:16px 0 0;color:#8995a4;font-size:11px;line-height:1.5">Dane lokalu i najmu pochodzą z Wynajmu dla budynku @(_isH74 ? SelectedUnit.BuildingName : _selectedBuilding?.Nazwa).</p>
                </div>
                </aside>
            </div>
        }
    </section>
    }
</div>

