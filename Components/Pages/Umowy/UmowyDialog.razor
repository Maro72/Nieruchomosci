@page "/umowy-dialog"
@attribute [Authorize(Policy = "Umowy.Zarzadzanie")]
@inherits UmowyDialogBase
@using MudBlazor
@using Mieszkaniec.Model.Entities
@using Microsoft.AspNetCore.Components.Forms

<MudDialog Class="contract-editor-dialog">
    <TitleContent>
        <div class="d-flex align-items-center px-2 pt-2 mb-2">
            <div class="bg-light shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center">
                <i class="bi bi-file-earmark-text text-primary fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">@(Model?.Id == 0 ? "Nowa umowa najmu" : "Edycja parametrów umowy")</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Ustaw ramy czasowe, przypisz lokale i zarządzaj aneksami</small>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (Model != null)
        {
            <EditForm Model="@Model" OnValidSubmit="Zapisz" id="umowaForm">
                <DataAnnotationsValidator />

                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToInnerViews="true" Class="mt-1" Color="Color.Transparent" TabHeaderClass="border-bottom">

                    @* ======================================================= *@
                    @* ZAKŁADKA 1: DANE PODSTAWOWE                             *@
                    @* ======================================================= *@
                    <MudTabPanel Text="Dane Podstawowe" Icon="@Icons.Material.Filled.Info" Class="py-3">
                        <div class="row g-2 px-1">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Numer Umowy</label>
                                <div class="input-group input-group-sm shadow-sm">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                                    <input type="text" class="form-control" @bind="Model.NumerUmowy" required placeholder="np. UM/2026/06/01" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Kontrahent / Najemca</label>
                                <div class="input-group input-group-sm shadow-sm">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                                    <select class="form-select" value="@Model.NajemcaId" @onchange="OnNajemcaChanged" required>
                                        <option value="0" disabled>Wybierz najemcę...</option>
                                        @foreach (var n in ListaNajemcow)
                                        {
                                            <option value="@n.Id">@n.NazwaFirmyOsoby</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Data rozpoczęcia</label>
                                <div class="input-group input-group-sm shadow-sm">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-check"></i></span>
                                    <input type="date" class="form-control" @bind="Model.DataOd" required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-1">Data zakończenia</label>
                                <div class="input-group input-group-sm shadow-sm">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-x"></i></span>
                                    <input type="date" class="form-control" @bind="Model.DataDo" />
                                </div>
                            </div>

                            <div class="col-12 mt-3 pt-3 border-top">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-calendar-event text-warning"></i>
                                    <span class="small fw-bold text-secondary">Wypowiedzenie umowy</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label small text-secondary mb-1">Data wypowiedzenia</label>
                                        <input type="date" class="form-control form-control-sm" @bind="Model.DataWypowiedzenia" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-secondary mb-1">Okres wypowiedzenia (dni)</label>
                                        <input type="number" min="0" class="form-control form-control-sm" @bind="Model.OkresWypowiedzeniaDni" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-secondary mb-1">Planowane zakończenie</label>
                                        <input type="text" class="form-control form-control-sm bg-light" readonly value="@(Model.WyliczonaDataZakonczeniaWypowiedzenia?.ToString("yyyy-MM-dd") ?? "zostanie wyliczone przy zapisie")" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small text-secondary mb-1">Powód wypowiedzenia (opcjonalnie)</label>
                                        <input type="text" class="form-control form-control-sm" @bind="Model.PowodWypowiedzenia" />
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">Po zapisaniu umowa otrzyma status „Wypowiedziana”. Wyczyszczenie daty anuluje wypowiedzenie.</small>
                            </div>

                            <div class="col-12 mt-3">
                                <MudCheckBox @bind-Value="Model.CzyAktywna" Color="Color.Success" Dense="true">
                                    <b>Umowa oznaczona jako aktywna</b>
                                </MudCheckBox>
                            </div>
                        </div>
                    </MudTabPanel>

                    @* ======================================================= *@
                    @* ZAKŁADKA 2: WYNAJMOWANE LOKALE                          *@
                    @* ======================================================= *@
                    <MudTabPanel Text="Wynajmowane Lokale" Icon="@Icons.Material.Filled.Business" Class="py-3">
                        <div class="row g-2 px-1">

                            @* Formularz wyboru pomieszczenia *@
                            <div class="col-12 rental-assignment-host">
                                <MudPaper Class="rental-assignment-card pa-4 mb-3" Outlined="true" Elevation="0">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="4">
                                            <MudSelect T="int?" Value="@(WybranyLokalId > 0 ? WybranyLokalId : null)"
                                                       ValueChanged="OnLokalChanged"
                                                       Label="Lokal do wynajęcia" Variant="Variant.Outlined"
                                                       Margin="Margin.Dense" Dense="true" FullWidth="true"
                                                       Placeholder="Wybierz lokal">
                                                @foreach (var lokal in DostepneLokaleDoWyboru)
                                                {
                                                    <MudSelectItem T="int?" Value="@lokal.Id">
                                                        @($"[{lokal.Obiekt?.Nazwa ?? "Budynek"}] {lokal.NumerLokalu} · {lokal.TypLokalu} · dostępne {PowierzchniaDostepnaDlaUmowy(lokal):N2} m²")
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="6" sm="4" md="2">
                                            <MudNumericField T="decimal" @bind-Value="WybranaPowierzchniaM2"
                                                             Label="Powierzchnia (m²)" Variant="Variant.Outlined"
                                                             Margin="Margin.Dense" FullWidth="true"
                                                             Min="0.01m" Max="@WybranaDostepnaPowierzchniaM2"
                                                             Format="N2" HideSpinButtons="true" />
                                            @if (WybranyLokalId > 0)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="assignment-hint">
                                                    Dostępne: @WybranaDostepnaPowierzchniaM2.ToString("N2") m²
                                                </MudText>
                                            }
                                        </MudItem>

                                        <MudItem xs="6" sm="4" md="2">
                                            <MudNumericField T="decimal" @bind-Value="WybranaCena"
                                                             Label="Stawka (zł)" Variant="Variant.Outlined"
                                                             Margin="Margin.Dense" FullWidth="true"
                                                             Min="0m" Format="N2" HideSpinButtons="true" />
                                        </MudItem>

                                        <MudItem xs="6" sm="2" md="2" Class="assignment-checkbox">
                                            <MudCheckBox T="bool" @bind-Value="NowyCzyRyczalt"
                                                         Color="Color.Primary" Dense="true">
                                                Ryczałt
                                            </MudCheckBox>
                                        </MudItem>

                                        <MudItem xs="6" sm="2" md="2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="DodajLokalDoUmowy"
                                                       FullWidth="true" Class="assignment-button">
                                                Przypisz
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </div>

                            <div class="col-12 mt-2 assigned-locals-host">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Lokale przypisane do tej umowy:</MudText>

                                @if (Model.WynajmowaneLokale != null && Model.WynajmowaneLokale.Any())
                                {
                                    <div class="overflow-auto border rounded shadow-sm assigned-locals-scroll" style="max-height: 250px;">
                                        <table class="table table-sm table-bordered table-hover align-middle mb-0 assigned-locals-table">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>Budynek</th>
                                                    <th>Numer Lokalu</th>
                                                    <th>Typ</th>
                                                    <th>Wynajęte (m²)</th>
                                                    <th>Stawka</th>
                                                    <th>Rozliczenie</th>
                                                    <th>Suma (mies.)</th>
                                                    <th class="assigned-actions-column" aria-label="Akcje"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var rel in Model.WynajmowaneLokale)
                                                {
                                                    <tr>
                                                        <td class="text-secondary">@(rel.LokalWynajem?.Obiekt?.Nazwa ?? "-")</td>
                                                        <td class="fw-bold text-primary">@(rel.LokalWynajem?.NumerLokalu ?? $"ID: {rel.LokalWynajemId}")</td>
                                                        <td>@(rel.LokalWynajem?.TypLokalu ?? "-")</td>
                                                        <td class="assigned-area-column">
                                                            <input type="number" step="0.01" min="0.01"
                                                                   max="@PowierzchniaDostepnaDlaUmowy(rel.LokalWynajem!)"
                                                                   class="form-control-plaintext assigned-area-input"
                                                                   @bind="rel.PowierzchniaWynajetaM2" />
                                                        </td>
                                                        <td class="fw-bold text-success">@($"{rel.WynegocjowanaCenaZaM2:N2} zł")</td>
                                                        <td>
                                                            <span class="badge @(rel.CzyRyczalt ? "bg-info text-dark" : "bg-secondary text-white")">
                                                                @(rel.CzyRyczalt ? "Ryczałt" : "Za m²")
                                                            </span>
                                                        </td>
                                                        <td class="fw-bold">@($"{rel.WartoscCzynszuMiesiecznego:N2} zł")</td>
                                                        <td class="text-center">
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="@(() => UsunLokalZUmowy(rel))" title="Usuń lokal z umowy">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small mt-1 fst-italic py-2 border-dashed rounded text-center bg-light">Brak przypisanych lokali. Dodaj pomieszczenie powyżej.</div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>

                    @* ======================================================= *@
                    @* ZAKŁADKA 3: ANEKSY                                      *@
                    @* ======================================================= *@
                    <MudTabPanel Text="Aneksy" Icon="@Icons.Material.Filled.PostAdd" Class="py-3">
                        <div class="row g-2 px-1">
                            @if (Model.Id > 0)
                            {
                                <div class="col-12 bg-light p-3 rounded border border-light shadow-sm mb-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-secondary mb-1">Numer Aneksu</label>
                                            <input type="text" class="form-control form-control-sm" @bind="NowyAneks.NumerAneksu" placeholder="np. 1/2026" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-secondary mb-1">Data Zawarcia</label>
                                            <input type="date" class="form-control form-control-sm" @bind="NowyAneks.DataZawarcia" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-secondary mb-1">Nowa Stawka (zł)</label>
                                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="NowyAneks.NowaStawkaCzynszu" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-secondary w-100 fw-bold shadow-sm" @onclick="ZapiszAneks">
                                                <i class="bi bi-plus-circle me-1"></i> Dodaj Aneks
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small fw-bold text-secondary mb-1">Opis zmian (opcjonalnie)</label>
                                            <input type="text" class="form-control form-control-sm" @bind="NowyAneks.OpisZmian" placeholder="Czego dotyczy zmiana..." />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-2">
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Rejestr aneksów do umowy:</MudText>

                                    @if (Model.Aneksy != null && Model.Aneksy.Any())
                                    {
                                        <div class="overflow-auto border rounded shadow-sm contract-amendments-scroll" style="max-height: 200px;">
                                            <table class="table table-sm table-bordered table-hover align-middle mb-0 contract-amendments-table" style="font-size: 0.85rem;">
                                                <thead class="table-light sticky-top">
                                                    <tr>
                                                        <th style="min-width: 80px;">Numer</th>
                                                        <th style="min-width: 100px;">Data</th>
                                                        <th style="min-width: 100px;">Stawka</th>
                                                        <th>Opis</th>
                                                        <th style="width: 40px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var aneks in Model.Aneksy)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">@aneks.NumerAneksu</td>
                                                            <td>@aneks.DataZawarcia.ToShortDateString()</td>
                                                            <td>@(aneks.NowaStawkaCzynszu.HasValue ? $"{aneks.NowaStawkaCzynszu:N2} zł" : "-")</td>
                                                            <td>@aneks.OpisZmian</td>
                                                            <td class="text-center">
                                                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="@(() => UsunAneks(aneks))">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small mt-1 fst-italic">Brak zarejestrowanych aneksów.</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="alert alert-info small py-2 mb-0 border-0 shadow-sm" role="alert">
                                        <i class="bi bi-info-circle me-1"></i> Zapisz nową umowę w bazie (przycisk na dole), aby odblokować możliwość dodawania do niej aneksów.
                                    </div>
                                </div>
                            }
                        </div>
                    </MudTabPanel>

                    @* ======================================================= *@
                    @* ZAKŁADKA 4: SKANY                                       *@
                    @* ======================================================= *@
                    <MudTabPanel Text="Skany" Icon="@Icons.Material.Filled.AttachFile" Class="py-3">
                        <div class="row g-2 px-1">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-secondary mb-1">Dodaj skan umowy (PDF, JPG)</label>
                                <div class="input-group input-group-sm shadow-sm">
                                    <span class="input-group-text bg-light text-success"><i class="bi bi-file-earmark-arrow-up"></i></span>
                                    <InputFile OnChange="@OnInputFileChange" class="form-control" style="line-height:21px;" />
                                </div>
                                @if (!string.IsNullOrEmpty(WybranyPlikNazwa))
                                {
                                    <div class="text-success small mt-2 fw-bold d-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i> Przygotowano do zapisu: @WybranyPlikNazwa (@WybranyPlikRozmiarKB KB)
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small mt-2 fst-italic">
                                        Wybierz plik z dysku. Zostanie on wgrany na serwer po kliknięciu przycisku "Zapisz Umowę".
                                    </div>
                                }
                            </div>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <div class="contract-dialog-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">
                Zamknij
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       ButtonType="ButtonType.Submit" form="umowaForm">
                Zapisz umowę
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
