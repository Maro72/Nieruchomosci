@page "/uprawnienia"
@attribute [Authorize(Policy = "Uprawnienia.Nadawanie")]
@using MudBlazor
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@inject IUzytkownikService UzytkownikService
@inject ISnackbar Snackbar

<PageTitle>Nadawanie Uprawnień</PageTitle>

<div class="d-flex flex-column" style="min-height: calc(100vh - 64px); background-color: #f8fafc; overflow-y: auto;">

    <!-- NAGŁÓWEK STRONY -->
    <div class="px-4 pt-4 pb-2 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="bg-white shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center" style="color: #4f46e5;">
                <i class="bi bi-shield-lock-fill fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">Zarządzanie Rolami i Dostępem</h5>
                <small class="text-muted">Konfiguracja ról i szczegółowych uprawnień użytkowników systemu</small>
            </div>
        </div>
    </div>

    <div class="px-4 py-3">
        <MudPaper Class="pa-6 shadow-sm border mb-4" Elevation="0" Style="border-radius: 12px; border-color: #e2e8f0; background-color: #ffffff;">

            @if (WszyscyUzytkownicy == null || !WszyscyUzytkownicy.Any())
            {
                <div class="d-flex align-center gap-2 py-4">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                    <MudText>Ładowanie danych użytkowników z bazy...</MudText>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <!-- 1. WYBÓR UŻYTKOWNIKA -->
                    <div class="col-12 border-bottom pb-4">
                        <MudSelect T="Uzytkownik" Label="1. Wybierz użytkownika do konfiguracji"
                                   Value="WybranyUzytkownik" ValueChanged="OnUzytkownikChanged"
                                   Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                   ToStringFunc="@(u => u == null ? "-- Wybierz użytkownika --" : $"{u.Login} ({u.Imie} {u.Nazwisko})")">
                            <MudSelectItem T="Uzytkownik" Value="null" Disabled="true">-- Wybierz użytkownika --</MudSelectItem>
                            @foreach (var user in WszyscyUzytkownicy)
                            {
                                <MudSelectItem T="Uzytkownik" Value="user">
                                    @user.Login (@user.Imie @user.Nazwisko) @(!user.CzyAktywny ? "[KONTO ZABLOKOWANE]" : "")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    @if (WybranyUzytkownik != null)
                    {
                        <!-- PANEL INFORMACYJNY UŻYTKOWNIKA -->
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between p-3 rounded border bg-light">
                                <div class="d-flex align-items-center gap-3">
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                        @(string.IsNullOrEmpty(WybranyUzytkownik.Imie) ? "U" : WybranyUzytkownik.Imie.Substring(0, 1))
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@WybranyUzytkownik.Imie @WybranyUzytkownik.Nazwisko</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@WybranyUzytkownik.Login</MudText>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <MudSwitch T="bool" Value="@WybranyUzytkownik.CzyAktywny" ValueChanged="OnAktywnoscChanged" Color="Color.Success" />
                                    <span class="small fw-bold @(WybranyUzytkownik.CzyAktywny ? "text-success" : "text-danger")">
                                        @(WybranyUzytkownik.CzyAktywny ? "Konto Aktywne" : "Konto Zablokowane")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. SZABLONY RÓL -->
                        <div class="col-12">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-secondary mb-2 text-uppercase" Style="letter-spacing: 0.5px;">Szybkie Szablony Ról</MudText>
                            <div class="d-flex flex-wrap gap-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Build" Size="Size.Small" OnClick='() => ZastosujSzablon("Konserwator")' Disabled="CzyJestAdminem()">
                                    Szablon: Konserwator / Technik
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Business" Size="Size.Small" OnClick='() => ZastosujSzablon("Zarządca")' Disabled="CzyJestAdminem()">
                                    Szablon: Zarządca Nieruchomości
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Description" Size="Size.Small" OnClick='() => ZastosujSzablon("Agent")' Disabled="CzyJestAdminem()">
                                    Szablon: Agent Najmu
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Star" Size="Size.Small" OnClick='() => ZastosujSzablon("Admin")'>
                                    Szablon: Administrator
                                </MudButton>
                            </div>
                        </div>

                        @if (CzyJestAdminem())
                        {
                            <div class="col-12">
                                <MudAlert Severity="Severity.Info" Class="my-1 py-2">
                                    <span class="fw-bold">Rola Administratora:</span> Dostęp do wszystkich stron i funkcji systemu przyznany automatycznie.
                                </MudAlert>
                            </div>
                        }

                        <!-- 3. SEKCJE UPRAWNIEŃ -->
                        <div class="col-12">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-secondary mb-3 text-uppercase" Style="letter-spacing: 0.5px;">Szczegółowe Uprawnienia Funkcjonalne</MudText>

                            <MudGrid>
                                <!-- GRUPA 1: NIERUCHOMOŚCI I LOKALE -->
                                <MudItem xs="12" md="6">
                                    <MudPaper Outlined="true" Class="pa-4 border h-100" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-primary d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Apartment" Class="me-2" Size="Size.Small" />
                                                NIERUCHOMOŚCI I LOKALE
                                            </MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick='() => PrzelaczSekcje("Budynki")' Disabled="CzyJestAdminem()">
                                                Zaznacz sekcję
                                            </MudButton>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var upr in PobierzUprawnieniaZSekcji("Budynki", "Lokale"))
                                            {
                                                var u = upr;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneUprawnienia.Any(x => x.Id == u.Id))"
                                                             ValueChanged="@(val => OnUprawnienieCheckboxChanged(u, val))"
                                                             Color="Color.Primary"
                                                             Disabled="CzyJestAdminem()"
                                                             Class="my-0">
                                                    <span class="small fw-medium text-dark">@u.Opis</span>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@u.NazwaSystemowa</MudText>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </MudItem>

                                <!-- GRUPA 2: OBSŁUGA TECHNICZNA -->
                                <MudItem xs="12" md="6">
                                    <MudPaper Outlined="true" Class="pa-4 border h-100" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-warning d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Build" Class="me-2" Size="Size.Small" />
                                                OBSŁUGA TECHNICZNA I AWARIE
                                            </MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick='() => PrzelaczSekcje("Awarie", "Przeglady", "Remonty")' Disabled="CzyJestAdminem()">
                                                Zaznacz sekcję
                                            </MudButton>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var upr in PobierzUprawnieniaZSekcji("Awarie", "Przeglady", "Remonty"))
                                            {
                                                var u = upr;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneUprawnienia.Any(x => x.Id == u.Id))"
                                                             ValueChanged="@(val => OnUprawnienieCheckboxChanged(u, val))"
                                                             Color="Color.Warning"
                                                             Disabled="CzyJestAdminem()"
                                                             Class="my-0">
                                                    <span class="small fw-medium text-dark">@u.Opis</span>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@u.NazwaSystemowa</MudText>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </MudItem>

                                <!-- GRUPA 3: NAJEM I UMOWY -->
                                <MudItem xs="12" md="6">
                                    <MudPaper Outlined="true" Class="pa-4 border h-100" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-success d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Description" Class="me-2" Size="Size.Small" />
                                                NAJEM I UMOWY
                                            </MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick='() => PrzelaczSekcje("Najemcy", "Umowy")' Disabled="CzyJestAdminem()">
                                                Zaznacz sekcję
                                            </MudButton>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var upr in PobierzUprawnieniaZSekcji("Najemcy", "Umowy"))
                                            {
                                                var u = upr;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneUprawnienia.Any(x => x.Id == u.Id))"
                                                             ValueChanged="@(val => OnUprawnienieCheckboxChanged(u, val))"
                                                             Color="Color.Success"
                                                             Disabled="CzyJestAdminem()"
                                                             Class="my-0">
                                                    <span class="small fw-medium text-dark">@u.Opis</span>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@u.NazwaSystemowa</MudText>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </MudItem>

                                <!-- GRUPA 4: ADMINISTRACJA -->
                                <MudItem xs="12" md="6">
                                    <MudPaper Outlined="true" Class="pa-4 border h-100" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-danger d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="me-2" Size="Size.Small" />
                                                ADMINISTRACJA SYSTEMU
                                            </MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick='() => PrzelaczSekcje("Uzytkownicy", "Uprawnienia")' Disabled="CzyJestAdminem()">
                                                Zaznacz sekcję
                                            </MudButton>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var upr in PobierzUprawnieniaZSekcji("Uzytkownicy", "Uprawnienia"))
                                            {
                                                var u = upr;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneUprawnienia.Any(x => x.Id == u.Id))"
                                                             ValueChanged="@(val => OnUprawnienieCheckboxChanged(u, val))"
                                                             Color="Color.Error"
                                                             Disabled="CzyJestAdminem()"
                                                             Class="my-0">
                                                    <span class="small fw-medium text-dark">@u.Opis</span>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@u.NazwaSystemowa</MudText>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </div>

                        <!-- PRZYCISK ZAPISU -->
                        <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="ZapiszUprawnienia">
                                Zapisz zmiany uprawnień
                            </MudButton>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </div>
</div>

@code {
    private List<Uzytkownik> WszyscyUzytkownicy = new();
    private List<Rola> WszystkieRole = new();
    private List<Uprawnienie> WszystkieUprawnienia = new();

    private Uzytkownik? WybranyUzytkownik { get; set; }

    private IReadOnlyCollection<Rola> WybraneRole { get; set; } = new HashSet<Rola>();
    private IReadOnlyCollection<Uprawnienie> WybraneUprawnienia { get; set; } = new HashSet<Uprawnienie>();

    protected override async Task OnInitializedAsync()
    {
        WszystkieRole = await UzytkownikService.PobierzRoleAsync();
        WszystkieUprawnienia = await UzytkownikService.PobierzUprawnieniaAsync();
        WszyscyUzytkownicy = await UzytkownikService.PobierzUzytkownikowAsync();
    }

    private void OnUzytkownikChanged(Uzytkownik user)
    {
        WybranyUzytkownik = user;

        if (WybranyUzytkownik != null)
        {
            WybraneRole = WszystkieRole
                .Where(r => WybranyUzytkownik.Role.Any(ur => ur.Id == r.Id))
                .ToHashSet();

            ZastosujLogikeUprawnien();
        }
    }

    private void OnAktywnoscChanged(bool aktywny)
    {
        if (WybranyUzytkownik != null)
        {
            WybranyUzytkownik.CzyAktywny = aktywny;
        }
    }

    private void OnUprawnienieCheckboxChanged(Uprawnienie upr, bool isChecked)
    {
        if (CzyJestAdminem()) return;

        var tempUprawnienia = WybraneUprawnienia.ToList();
        if (isChecked)
        {
            if (!tempUprawnienia.Any(u => u.Id == upr.Id))
            {
                tempUprawnienia.Add(upr);
            }
        }
        else
        {
            tempUprawnienia.RemoveAll(u => u.Id == upr.Id);
        }
        WybraneUprawnienia = tempUprawnienia.ToHashSet();
    }

    private bool CzyJestAdminem()
    {
        return WybraneRole.Any(r => r.Nazwa.Equals("Administrator", StringComparison.OrdinalIgnoreCase));
    }

    private void ZastosujLogikeUprawnien()
    {
        if (CzyJestAdminem())
        {
            WybraneUprawnienia = WszystkieUprawnienia.ToHashSet();
        }
        else
        {
            if (WybranyUzytkownik != null && WybranyUzytkownik.Uprawnienia != null)
            {
                WybraneUprawnienia = WszystkieUprawnienia
                    .Where(u => WybranyUzytkownik.Uprawnienia.Any(uu => uu.Id == u.Id))
                    .ToHashSet();
            }
            else
            {
                WybraneUprawnienia = new HashSet<Uprawnienie>();
            }
        }
    }

    private IEnumerable<Uprawnienie> PobierzUprawnieniaZSekcji(params string[] prefiksy)
    {
        return WszystkieUprawnienia.Where(u => prefiksy.Any(p => u.NazwaSystemowa.StartsWith(p, StringComparison.OrdinalIgnoreCase)));
    }

    private void PrzelaczSekcje(params string[] prefiksy)
    {
        if (CzyJestAdminem()) return;

        var uprawnieniaSekcji = PobierzUprawnieniaZSekcji(prefiksy).ToList();
        var temp = WybraneUprawnienia.ToList();

        bool wszystkieZaznaczone = uprawnieniaSekcji.All(u => temp.Any(tu => tu.Id == u.Id));

        if (wszystkieZaznaczone)
        {
            temp.RemoveAll(tu => uprawnieniaSekcji.Any(u => u.Id == tu.Id));
        }
        else
        {
            foreach (var u in uprawnieniaSekcji)
            {
                if (!temp.Any(tu => tu.Id == u.Id))
                {
                    temp.Add(u);
                }
            }
        }

        WybraneUprawnienia = temp.ToHashSet();
    }

    private void ZastosujSzablon(string nazwaSzablonu)
    {
        var tempRole = new List<Rola>();
        var tempUprawnienia = new List<Uprawnienie>();

        switch (nazwaSzablonu)
        {
            case "Admin":
                var rolaAdmin = WszystkieRole.FirstOrDefault(r => r.Nazwa.Equals("Administrator", StringComparison.OrdinalIgnoreCase));
                if (rolaAdmin != null) tempRole.Add(rolaAdmin);
                tempUprawnienia = WszystkieUprawnienia.ToList();
                break;

            case "Zarządca":
                var rolaZarzadca = WszystkieRole.FirstOrDefault(r => r.Nazwa.Contains("Zarządca", StringComparison.OrdinalIgnoreCase));
                if (rolaZarzadca != null) tempRole.Add(rolaZarzadca);
                tempUprawnienia = PobierzUprawnieniaZSekcji("Budynki", "Lokale", "Awarie", "Przeglady", "Remonty", "Najemcy", "Umowy").ToList();
                break;

            case "Konserwator":
                var rolaKonserwator = WszystkieRole.FirstOrDefault(r => r.Nazwa.Contains("Konserwator", StringComparison.OrdinalIgnoreCase));
                if (rolaKonserwator != null) tempRole.Add(rolaKonserwator);
                tempUprawnienia = PobierzUprawnieniaZSekcji("Awarie", "Przeglady", "Remonty").ToList();
                // Dodajemy też podgląd budynków
                var budynkiOdczyt = WszystkieUprawnienia.FirstOrDefault(u => u.NazwaSystemowa == "Budynki.Odczyt");
                if (budynkiOdczyt != null && !tempUprawnienia.Any(u => u.Id == budynkiOdczyt.Id)) tempUprawnienia.Add(budynkiOdczyt);
                break;

            case "Agent":
                var rolaAgent = WszystkieRole.FirstOrDefault(r => r.Nazwa.Contains("Agent", StringComparison.OrdinalIgnoreCase));
                if (rolaAgent != null) tempRole.Add(rolaAgent);
                tempUprawnienia = PobierzUprawnieniaZSekcji("Lokale", "Najemcy", "Umowy").ToList();
                var budynkiOdczytAgent = WszystkieUprawnienia.FirstOrDefault(u => u.NazwaSystemowa == "Budynki.Odczyt");
                if (budynkiOdczytAgent != null && !tempUprawnienia.Any(u => u.Id == budynkiOdczytAgent.Id)) tempUprawnienia.Add(budynkiOdczytAgent);
                break;
        }

        WybraneRole = tempRole.ToHashSet();
        WybraneUprawnienia = tempUprawnienia.ToHashSet();
        Snackbar.Add($"Wczytano szablon ról i uprawnień dla: {nazwaSzablonu}", Severity.Info);
    }

    private async Task ZapiszUprawnienia()
    {
        if (WybranyUzytkownik == null) return;

        var doceloweUprawnienia = CzyJestAdminem() ? WszystkieUprawnienia : WybraneUprawnienia;

        await UzytkownikService.ZapiszUzytkownikaAsync(WybranyUzytkownik, WybraneRole, doceloweUprawnienia);

        WszyscyUzytkownicy = await UzytkownikService.PobierzUzytkownikowAsync();

        Snackbar.Add($"Pomyślnie zaktualizowano role i uprawnienia dla: {WybranyUzytkownik.Login}", Severity.Success);
    }
}
