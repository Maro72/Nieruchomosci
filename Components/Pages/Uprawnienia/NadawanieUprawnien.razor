@page "/uprawnienia"
@attribute [Authorize(Policy = "ZarzadzanieUzytkownikami")]
@using MudBlazor
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Services.Interfaces
@* @attribute [Authorize(Roles = "Administrator")] *@
@inject IUzytkownikService UzytkownikService
@inject ISnackbar Snackbar

<PageTitle>Nadawanie Uprawnień</PageTitle>

<div class="d-flex flex-column" style="height: calc(100vh - 64px); background-color: #f8fafc; overflow-y: auto;">

    <div class="px-4 pt-4 pb-2 d-flex align-items-center">
        <div class="bg-white shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center" style="color: #4f46e5;">
            <i class="bi bi-shield-lock-fill fs-4"></i>
        </div>
        <div>
            <h5 class="fw-bold mb-0 text-dark">Nadawanie ról i uprawnień</h5>
            <small class="text-muted">Zarządzaj dostępem poszczególnych użytkowników do stron systemu</small>
        </div>
    </div>

    <div class="px-4 py-3">
        <MudPaper Class="pa-6 shadow-sm border" Elevation="0" Style="border-radius: 12px; border-color: #e2e8f0; background-color: #ffffff; max-width: 800px;">

            @if (WszyscyUzytkownicy == null || !WszyscyUzytkownicy.Any())
            {
                <div class="d-flex align-center gap-2">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                    <MudText>Ładowanie danych z bazy...</MudText>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @* 1. WYBÓR UŻYTKOWNIKA *@
                    <div class="col-12 border-bottom pb-4">
                        <MudSelect T="Uzytkownik" Label="1. Wybierz użytkownika do edycji"
                                   Value="WybranyUzytkownik" ValueChanged="OnUzytkownikChanged"
                                   Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                   ToStringFunc="@(u => u == null ? "-- Wybierz z listy --" : $"{u.Login} ({u.Imie} {u.Nazwisko})")">
                            <MudSelectItem T="Uzytkownik" Value="null" Disabled="true">-- Wybierz z listy --</MudSelectItem>
                            @foreach (var user in WszyscyUzytkownicy)
                            {
                                <MudSelectItem T="Uzytkownik" Value="user">@user.Login (@user.Imie @user.Nazwisko)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    @if (WybranyUzytkownik != null)
                    {
                        <div class="col-12 pt-2">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-secondary mb-3 text-uppercase" Style="letter-spacing: 0.5px;">2. Konfiguracja dostępu</MudText>

                            @if (CzyJestAdminem())
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-4 py-2" Elevation="1">
                                    <span class="fw-bold">Tryb Administratora:</span> Użytkownik posiada najwyższe uprawnienia. Dostęp do wszystkich stron został przyznany automatycznie i nie można go ograniczyć.
                                </MudAlert>
                            }

                            <div class="row g-4">
                                @* 2. WYBÓR ROLI (CHECKBOXES) *@
                                <div class="col-md-6">
                                    <MudPaper Outlined="true" Class="pa-4 border" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-3 d-flex align-center text-secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.People" Class="me-2" Color="Color.Primary" Size="Size.Small" />
                                            PRZYPISANE ROLE (GRUPY)
                                        </MudText>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var rola in WszystkieRole)
                                            {
                                                var r = rola;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneRole.Any(x => x.Id == r.Id))"
                                                             ValueChanged="@(val => OnRoleCheckboxChanged(r, val))"
                                                             Color="Color.Primary"
                                                             Class="my-0">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi @(r.Nazwa == "Administrator" ? "bi-star-fill text-warning" : "bi-person-badge text-primary") me-2"></i>
                                                        @r.Nazwa
                                                    </div>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </div>

                                @* 3. WYBÓR STRON / UPRAWNIEŃ (CHECKBOXES) *@
                                <div class="col-md-6">
                                    <MudPaper Outlined="true" Class="pa-4 border" Style="border-radius: 8px; border-color: #e2e8f0; background-color: #f8fafc;">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold mb-3 d-flex align-center text-secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.Security" Class="me-2" Color="Color.Primary" Size="Size.Small" />
                                            DOSTĘP DO STRON (UPRAWNIENIA)
                                        </MudText>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var upr in WszystkieUprawnienia)
                                            {
                                                var u = upr;
                                                <MudCheckBox T="bool"
                                                             Value="@(WybraneUprawnienia.Any(x => x.Id == u.Id))"
                                                             ValueChanged="@(val => OnUprawnienieCheckboxChanged(u, val))"
                                                             Color="Color.Primary"
                                                             Disabled="CzyJestAdminem()"
                                                             Class="my-0">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-file-earmark-lock text-secondary me-2"></i> @u.Opis
                                                    </div>
                                                </MudCheckBox>
                                            }
                                        </div>
                                    </MudPaper>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="ZapiszUprawnienia">
                                Zapisz zmiany dla użytkownika
                            </MudButton>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </div>
</div>

@code {
    // Listy pobrane z bazy danych
    private List<Uzytkownik> WszyscyUzytkownicy = new();
    private List<Rola> WszystkieRole = new();
    private List<Uprawnienie> WszystkieUprawnienia = new();

    // Stan formularza
    private Uzytkownik? WybranyUzytkownik { get; set; }

    // POPRAWKA: Zmiana z IEnumerable na IReadOnlyCollection, wymagana przez najnowszy MudBlazor
    private IReadOnlyCollection<Rola> WybraneRole { get; set; } = new HashSet<Rola>();
    private IReadOnlyCollection<Uprawnienie> WybraneUprawnienia { get; set; } = new HashSet<Uprawnienie>();

    protected override async Task OnInitializedAsync()
    {
        // Pobieramy wszystkie dane słownikowe na start
        WszystkieRole = await UzytkownikService.PobierzRoleAsync();
        WszystkieUprawnienia = await UzytkownikService.PobierzUprawnieniaAsync();
        WszyscyUzytkownicy = await UzytkownikService.PobierzUzytkownikowAsync();
    }

    // Wywoływane, gdy wybierzesz użytkownika z pierwszego ComboBoxa
    private void OnUzytkownikChanged(Uzytkownik user)
    {
        WybranyUzytkownik = user;

        if (WybranyUzytkownik != null)
        {
            // Ładujemy jego dotychczasowe role z bazy (ToHashSet rzutuje bezpiecznie do IReadOnlyCollection)
            WybraneRole = WszystkieRole
                .Where(r => WybranyUzytkownik.Role.Any(ur => ur.Id == r.Id))
                .ToHashSet();

            // Uruchamiamy logikę uprawnień
            ZastosujLogikeUprawnien();
        }
    }

    private void OnRoleCheckboxChanged(Rola rola, bool isChecked)
    {
        var tempRole = WybraneRole.ToList();
        if (isChecked)
        {
            if (!tempRole.Any(r => r.Id == rola.Id))
            {
                tempRole.Add(rola);
            }
        }
        else
        {
            tempRole.RemoveAll(r => r.Id == rola.Id);
        }
        WybraneRole = tempRole.ToHashSet();
        ZastosujLogikeUprawnien();
    }

    private void OnUprawnienieCheckboxChanged(Uprawnienie upr, bool isChecked)
    {
        if (CzyJestAdminem()) return;

        var tempUprawnienia = WybraneUprawnienia.ToList();
        if (isChecked)
        {
            if (!tempUprawnienia.Any(u => u.Id == upr.Id))
            {
                tempUprawnienia.Add(upr);
            }
        }
        else
        {
            tempUprawnienia.RemoveAll(u => u.Id == upr.Id);
        }
        WybraneUprawnienia = tempUprawnienia.ToHashSet();
    }

    // Sprawdza, czy w wybranych rolach jest "Administrator"
    private bool CzyJestAdminem()
    {
        return WybraneRole.Any(r => r.Nazwa.Equals("Administrator", StringComparison.OrdinalIgnoreCase));
    }

    // Główna logika biznesowa ComboBoxa ze stronami
    private void ZastosujLogikeUprawnien()
    {
        if (CzyJestAdminem())
        {
            // Administrator automatycznie otrzymuje wszystkie strony i blokuje ComboBox
            WybraneUprawnienia = WszystkieUprawnienia.ToHashSet();
        }
        else
        {
            // Zwykły użytkownik ładuje strony, które miał w bazie (pozwala na ręczną edycję)
            if (WybranyUzytkownik != null && WybranyUzytkownik.Uprawnienia != null)
            {
                WybraneUprawnienia = WszystkieUprawnienia
                    .Where(u => WybranyUzytkownik.Uprawnienia.Any(uu => uu.Id == u.Id))
                    .ToHashSet();
            }
            else
            {
                WybraneUprawnienia = new HashSet<Uprawnienie>();
            }
        }
    }

    // Zapisywanie do bazy
    private async Task ZapiszUprawnienia()
    {
        if (WybranyUzytkownik == null) return;

        // Upewniamy się, że przy zapisie Admin na pewno dostanie wszystkie rekordy
        var doceloweUprawnienia = CzyJestAdminem() ? WszystkieUprawnienia : WybraneUprawnienia;

        // Wywołujemy nasz serwis
        await UzytkownikService.ZapiszUzytkownikaAsync(WybranyUzytkownik, WybraneRole, doceloweUprawnienia);

        // Odświeżamy listę użytkowników, aby zaktualizować dane w pamięci
        WszyscyUzytkownicy = await UzytkownikService.PobierzUzytkownikowAsync();

        Snackbar.Add($"Pomyślnie zaktualizowano uprawnienia dla: {WybranyUzytkownik.Login}", Severity.Success);
    }
}
}
