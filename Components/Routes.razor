@using Microsoft.AspNetCore.Components.Authorization
@using Mieszkaniec.Components.Layout @* Dopasuj, jeśli Twój RedirectToLogin jest w innym folderze *@

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">

        @* Używamy AuthorizeRouteView zamiast zwykłego RouteView *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                @* Jeśli niezalogowany - wywołujemy nasz komponent z Kroku 1 *@
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Nie znaleziono strony</PageTitle>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p role="alert">Przepraszamy, pod tym adresem nie ma niczego.</p>
        </LayoutView>
    </NotFound>
</Router>