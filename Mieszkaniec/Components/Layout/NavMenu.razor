@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
<MudNavMenu Class="pt-4">

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Ripple="false">
        Strona Główna
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavGroup Title="Nieruchomości" Expanded="false" Icon="@Icons.Material.Filled.Domain">
                <MudNavLink Href="fprzeglady" Icon="@Icons.Material.Filled.EventNote" Ripple="false">Przeglądy</MudNavLink>
                <MudNavLink Href="fbudynki" Icon="@Icons.Material.Filled.DomainAdd">Budynki</MudNavLink>
                <MudNavLink Href="fawarie" Icon="@Icons.Material.Filled.WarningAmber" Ripple="false">Zgłoszenia usterek</MudNavLink>
                <MudNavLink Href="historiausterek" Icon="@Icons.Material.Filled.ManageHistory" Ripple="false">Historia usterek</MudNavLink>
                <MudNavLink Href="fremonbud" Icon="@Icons.Material.Filled.Handyman" Ripple="false">Prace remontowe</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="ZarzadzanieBudynkami">
        <Authorized>
            <MudNavGroup Title="Słowniki" Expanded="false" Icon="@Icons.Material.Filled.MenuBook">
                <MudNavLink Href="fterminy/terminy" Icon="@Icons.Material.Filled.MoreTime" Ripple="false">
                    Definicje Terminów
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="ZarzadzanieUmowami">
        <Authorized>
            <MudNavGroup Title="Wynajmy" Expanded="false" Icon="@Icons.Material.Filled.CorporateFare">
                <MudNavLink Href="wynajem" Icon="@Icons.Material.Filled.Apartment" Ripple="false">Pomieszczenia</MudNavLink>
                <MudNavLink Href="najemcy" Icon="@Icons.Material.Filled.People" Ripple="false">Najemcy</MudNavLink>
                <MudNavLink Href="umowy" Icon="@Icons.Material.Filled.Description" Ripple="false">Umowy</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="ZarzadzanieUzytkownikami">
        <Authorized>
            <MudNavGroup Title="Administracja" Expanded="false" Icon="@Icons.Material.Filled.AddHome">
                <MudNavLink Href="uzytkownicy" Icon="@Icons.Material.Filled.People" Ripple="false">Lista użytkowników</MudNavLink>
                <MudNavLink Href="role" Icon="@Icons.Material.Filled.Security" Ripple="false">Role</MudNavLink>
                <MudNavLink Href="uprawnienia" Icon="@Icons.Material.Filled.VerifiedUser" Ripple="false">Uprawnienia</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>
