@namespace Mieszkaniec.Components.Pages.FAwarie
@using Mieszkaniec.Model.Entities
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using System.IO

<MudDialog @bind-Visible="IsVisible" Options="DialogOptions" Class="modern-dialog-window">
    <TitleContent>
        <div class="d-flex align-items-center px-2 pt-2 mb-2">
            <div class="bg-light shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center">
                <i class="bi bi-tools text-success fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">@(Model?.Id == 0 ? "Rejestracja Awarii" : "Edycja Zgłoszenia")</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Szczegóły usterki i informacje konserwatora</small>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (Model != null)
        {
            <EditForm Model="@Model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                
                @* Usunięto max-height, zmieniono gapy na g-2, żeby wszystko było bardziej zwarte *@
                <div class="row g-2 px-3 pb-2">
                    
                    @* --- ROW 1 --- *@
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary mb-1">Nieruchomość / Budynek</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-building"></i></span>
                            <select class="form-select" @bind="Model.ObiektId" disabled="@Model.CzyArchiwum">
                                <option value="0">Wybierz budynek...</option>
                                @foreach (var ob in ListaObiektow) { <option value="@ob.Id">@ob.Nazwa</option> }
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary mb-1">Kategoria usterki</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-wrench"></i></span>
                            <select class="form-select" @bind="Model.RodzajUsterkiId" disabled="@Model.CzyArchiwum">
                                <option value="0">Wybierz kategorię...</option>
                                @foreach (var r in ListaRodzajow) { <option value="@r.Id">@r.Nazwa</option> }
                            </select>
                        </div>
                    </div>

                    @* --- ROW 2 --- *@
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary mb-1">Status zgłoszenia</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-clipboard-check"></i></span>
                            <select class="form-select" @bind="Model.Status" disabled="@Model.CzyArchiwum">
                                <option value="@((string)null)">Wybierz status...</option>
                                @foreach (var st in OpcjeStatusow) { <option value="@st">@st</option> }
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary mb-1">Priorytet (SLA)</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-exclamation-triangle"></i></span>
                            <select class="form-select" @bind="Model.PriorytetUsterkiId" disabled="@Model.CzyArchiwum">
                                <option value="0">Wybierz priorytet...</option>
                                @foreach (var p in ListaPriorytetow) { <option value="@p.Id">@p.Nazwa</option> }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-secondary mb-1">Data wpłynięcia</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar3"></i></span>
                            @* Używamy natywnego kalendarza HTML5 podpiętego pod C# DateTime *@
                            <input type="date" class="form-control" @bind="DataZgloszeniaMud" @bind:format="yyyy-MM-dd" disabled="@Model.CzyArchiwum" />
                        </div>
                    </div>

                    @* --- ROW 3 --- *@
                    <div class="col-12">
                        <label class="form-label small fw-bold text-secondary mb-1">Lokator / Osoba zgłaszająca</label>
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" @bind="Model.OsobaZglaszajaca" placeholder="np. Jan Kowalski" disabled="@Model.CzyArchiwum" />
                        </div>
                    </div>

                    @* --- ROW 4 --- *@
                    <div class="col-12">
                        <label class="form-label small fw-bold text-secondary mb-1">Szczegóły problemu (opis mieszkańca)</label>
                        <textarea class="form-control form-control-sm shadow-sm" @bind="Model.OpisZgłoszenia" rows="2" placeholder="Wpisz treść zgłoszenia..." disabled="@Model.CzyArchiwum"></textarea>
                    </div>

                    @* --- ROW 5 (REALIZACJA) --- *@
                    <div class="col-12 mt-3">
                        <div class="p-2 border rounded bg-light">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-shield-check text-success me-2"></i>
                                <span class="fw-bold small text-dark" style="font-size: 0.8rem;">Realizacja i zamknięcie</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-secondary mb-1">Data usunięcia awarii</label>
                                    <div class="input-group input-group-sm shadow-sm">
                                        <span class="input-group-text bg-white text-muted"><i class="bi bi-calendar-check"></i></span>
                                        <input type="date" class="form-control bg-white" @bind="DataZakonczeniaMud" @bind:format="yyyy-MM-dd" disabled="@Model.CzyArchiwum" />
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold text-secondary mb-1">Uwagi konserwatora / Zużyte materiały</label>
                                    <input type="text" class="form-control form-control-sm bg-white shadow-sm" @bind="Model.UwagiKonserwatora" placeholder="Zapisz komentarz z naprawy..." disabled="@Model.CzyArchiwum" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- ROW 6 (PLIKI) --- *@
                    <div class="col-12 mt-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Dołącz Protokół / Skan (PDF, JPG)</label>
                        
                        @* Czysty HTML/CSS do ułożenia MudFileUpload *@
                        <div class="input-group input-group-sm shadow-sm">
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnUploadFiles" Accept=".pdf" Disabled="Model.CzyArchiwum" Class="m-0 p-0 w-100" Style="display:block;">
                                <ActivatorContent>
                                    <div class="d-flex w-100">
                                        <button type="button" class="btn btn-sm btn-outline-success border-end-0 rounded-start" disabled="@Model.CzyArchiwum" style="z-index: 1;">
                                            <i class="bi bi-upload me-1"></i> Wybierz plik
                                        </button>
                                        <input type="text" class="form-control form-control-sm bg-white" readonly value="@(Model.Zalaczniki?.Any() == true ? $"{Model.Zalaczniki.Count} plik(ów)" : "Nie wybrano pliku")" style="cursor: default;" />
                                    </div>
                                </ActivatorContent>
                            </MudFileUpload>
                        </div>
                        
                        @if(Model.Zalaczniki != null && Model.Zalaczniki.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach(var z in Model.Zalaczniki)
                                {
                                    <span class="badge bg-white border text-dark p-1 d-inline-flex align-items-center shadow-sm" style="font-weight: 500;">
                                        <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>
                                        @z.NazwaPliku
                                        @if (!Model.CzyArchiwum)
                                        {
                                            <i class="bi bi-x text-muted ms-2 fs-6" style="cursor: pointer;" @onclick="() => UsunZalacznik(z)"></i>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>

                </div>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <div class="w-100 px-3 pb-2 d-flex justify-content-end gap-2 mt-1">
            <button type="button" class="btn btn-sm btn-light fw-bold px-3 shadow-sm border" @onclick="Cancel">
                <i class="bi bi-x me-1"></i> Anuluj
            </button>
            @if (Model != null && !Model.CzyArchiwum)
            {
                <button type="button" class="btn btn-sm fw-bold px-4 shadow-sm" style="background-color: #5a4bda; color: white;" @onclick="Save">
                    <i class="bi bi-save me-1"></i> Zapisz
                </button>
            }
        </div>
    </DialogActions>
</MudDialog>

<style>
    .modern-dialog-window .mud-dialog {
        border-radius: 12px !important;
    }
    
    .form-select, .form-control {
        border-color: #cbd5e1;
        font-size: 0.9rem;
    }
    .input-group-text {
        border-color: #cbd5e1;
    }
    
    textarea.form-control {
        min-height: 50px;
    }
</style>