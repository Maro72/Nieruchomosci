@page "/fbudynki"
@namespace Mieszkaniec.Components.Pages.Obiekty
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Components.UI
@using MudBlazor

<FGrid TItem="Obiekt"
       Title="Nieruchomości i Budynki"
       Items="@FiltrowanaListaObiektow"
       GridKey="@gridKey"
       @bind-SelectedItem="WybranyObiekt"
       SearchText="@TekstFiltru"
       SearchTextChanged="OnSearchInput"
       OnAdd="OpenCreateDialog"
       OnEdit="OpenEditDialog"
       OnDelete="RequestDelete"
       OnExportToExcel="EksportujDoExcela">

    @* LEWA STRONA TOOLBARU: Przełącznik Widoku (Aktualne / Archiwalne) oraz Ikona Odświeżania *@
    <ToolbarLeftContent>
        <div class="d-inline-flex align-items-center me-2" style="height: 30px;">
            <span class="me-2 small fw-bold @(!PokazujArchiwum ? "text-primary" : "text-muted")"
                  style="transition: color 0.15s; cursor: pointer; user-select: none; font-size: 0.85rem;"
                  @onclick="() => PrzelaczWidokArchiwum(false)">
                Aktualne
            </span>

            <MudSwitch T="bool"
                       Value="@PokazujArchiwum"
                       ValueChanged="PrzelaczWidokArchiwum"
                       Color="Color.Error"
                       UncheckedColor="Color.Primary" />

            <span class="ms-2 small fw-bold @(PokazujArchiwum ? "text-danger" : "text-muted")"
                  style="transition: color 0.15s; cursor: pointer; user-select: none; font-size: 0.85rem;"
                  @onclick="() => PrzelaczWidokArchiwum(true)">
                Archiwalne
            </span>
        </div>

        <div class="toolbar-separator mx-1"></div>

        <button type="button" class="btn btn-sm btn-link text-secondary p-1 border-0 d-flex align-items-center justify-content-center rounded-circle custom-refresh-circle d-print-none" @onclick="OdswiezDane" title="Odśwież dane">
            <i class="bi bi-arrow-clockwise fs-5"></i>
        </button>
    </ToolbarLeftContent>

    @* Sekcja ExtraActions jest pusta, ponieważ Drukuj i Excel są już wbudowane w FGrid! *@

    @* STRUKTURA KOLUMN TABELI *@
    <GridColumns>
        <PropertyColumn T="Obiekt" TProperty="string" Property="x => x.Nazwa" Title="Nazwa Obiektu">
            <CellTemplate>
                <div class="d-flex align-items-center w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    @context.Item.Nazwa
                </div>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Obiekt" TProperty="string" Property="x => x.NumerEwidencyjny" Title="Nr Ewidencyjny" HeaderClass="justify-center" CellClass="justify-center text-center">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    @context.Item.NumerEwidencyjny
                </div>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Obiekt" TProperty="string" Property="x => x.Adres" Title="Adres lokalizacji">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    @context.Item.Adres
                </div>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Obiekt" TProperty="int?" Property="x => x.RokBudowy" Title="Rok budowy" HeaderClass="justify-center" CellClass="justify-center text-center">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    @context.Item.RokBudowy
                </div>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn T="Obiekt" Title="Kond." HeaderClass="justify-center" CellClass="justify-center text-center">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    <span class="badge bg-light text-dark border px-2 py-1">@context.Item.LiczbaKondygnacji</span>
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn T="Obiekt" Title="Pow. Użytkowa" HeaderClass="justify-end" CellClass="justify-end text-end">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    <span class="fw-medium">@context.Item.PowUzytkowa.ToString("N2") m²</span>
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn T="Obiekt" Title="Kubatura" HeaderClass="justify-end" CellClass="justify-end text-end">
            <CellTemplate>
                <div class="w-100" style="cursor: pointer; min-height: 25px;" @onclick="@(() => WybierzWiersz(context.Item))">
                    <span class="text-secondary">@context.Item.Kubatura.ToString("N2") m³</span>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </GridColumns>

</FGrid>

<PotwierdzenieDialog IsVisible="@IsConfirmVisible"
                     Title="@ConfirmTitle"
                     Message="@ConfirmMessage"
                     ThemeClass="@ConfirmTheme"
                     IconClass="@ConfirmIcon"
                     OnAnswer="@HandleConfirmationAnswer" />
