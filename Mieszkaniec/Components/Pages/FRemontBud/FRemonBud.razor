@page "/fremonbud"
@attribute [Authorize(Policy = "OdczytBudynkow")]
@rendermode InteractiveServer
@namespace Mieszkaniec.Components.Pages.FRemonBud
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Components.UI
@using MudBlazor

@if (!CzyWidokKanban)
{
    @* --- WIDOK 1: KLASYCZNA TABELA (FGRID) --- *@
    <FGrid TItem="PraceRemontowe"
           Title="Prace Remontowe"
           Items="@ListaPrac"
           GridKey="@gridKey"
           @bind-SelectedItem="WybranyRemont"
           OnAdd="OpenCreateDialog"
           OnEdit="OpenEditDialog"
           OnDelete="RequestDelete">

        @* --- FILTRY INLINE --- *@
        <ToolbarLeftContent>
            <div class="filter-container d-flex align-items-center gap-2 flex-wrap ms-3">
                <MudSelect T="int?" Label="Budynek" Value="@FiltreObiektId" ValueChanged="OnObiektFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="filter-item" Clearable="true">
                    <MudSelectItem T="int?" Value="@null">Wszystkie budynki</MudSelectItem>
                    @foreach (var ob in ListaObiektow)
                    {
                        <MudSelectItem T="int?" Value="@ob.Id">@ob.Nazwa</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?" Label="Typ / Branża" Value="@FiltreRodzajId" ValueChanged="OnRodzajFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="filter-item" Clearable="true">
                    <MudSelectItem T="int?" Value="@null">Wszystkie </MudSelectItem>
                    @foreach (var def in ListaRodzajow)
                    {
                        <MudSelectItem T="int?" Value="@def.Id">@def.Nazwa</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" Label="Status" Value="@FiltreStatus" ValueChanged="OnStatusFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="filter-item" Clearable="true">
                    <MudSelectItem T="string" Value="@null">Wszystkie </MudSelectItem>
                    @foreach (var st in OpcjeStatusow)
                    {
                        <MudSelectItem T="string" Value="@st">@st</MudSelectItem>
                    }
                </MudSelect>

                @if (FiltreObiektId.HasValue || FiltreRodzajId.HasValue || !string.IsNullOrEmpty(FiltreStatus))
                {
                    <button type="button" class="btn btn-sm text-secondary border-0 bg-transparent px-2" @onclick="ResetujFiltry">
                        <i class="bi bi-x-circle"></i> Wyczyść
                    </button>
                }
            </div>
        </ToolbarLeftContent>

        @* --- PRZYCISKI AKCJI / PRZEŁĄCZNIK WIDOKU --- *@
        <ExtraActions>
            <MudToggleGroup T="bool" Value="CzyWidokKanban" ValueChanged="OnWidokChanged" Color="Color.Default" Size="Size.Small" Dense="true" Class="me-2">
                <MudToggleItem Value="false"><MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" /> Lista</MudToggleItem>
                <MudToggleItem Value="true"><MudIcon Icon="@Icons.Material.Filled.Abc" Size="Size.Small" /> Kanban</MudToggleItem>
            </MudToggleGroup>

            <button type="button" class="btn btn-sm btn-link text-secondary p-1 border-0 d-flex align-items-center justify-content-center rounded-circle me-2" @onclick="RefreshGridAsync" title="Odśwież listę">
                <i class="bi bi-arrow-clockwise fs-5"></i>
            </button>
        </ExtraActions>

        @* --- KOLUMNY GRIDA --- *@
        <GridColumns>
            <PropertyColumn T="PraceRemontowe" TProperty="string" Property="x => x.Status" Title="Status" Width="140px" CellClass="justify-center text-center">
                <CellTemplate Context="wiersz">
                    <span class="custom-badge @WyznaczKlasuStatusu(wiersz.Item.Status)" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>
                        @wiersz.Item.Status
                    </span>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="string" Property="x => x.Obiekt.Nazwa" Title="Budynek" Width="80px">
                <CellTemplate Context="wiersz">
                    <div class="w-100 fw-medium" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        @(wiersz.Item.Obiekt?.Nazwa ?? "-")
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="string" Property="x => x.RodzajUsterki.Nazwa" Title="Typ / Branża" Width="80px">
                <CellTemplate Context="wiersz">
                    <div class="w-100 text-muted" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        @(wiersz.Item.RodzajUsterki?.Nazwa ?? "-")
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="string" Property="x => x.Nazwa" Title="Opis zadania">
                <CellTemplate Context="wiersz">
                    <div class="w-100" title="@wiersz.Item.Nazwa" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        @wiersz.Item.Nazwa
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="DateTime" Property="x => x.DataRozpoczeciaPlanowana" Title="Plan. Start" Format="yyyy-MM-dd" Width="100px" HeaderClass="justify-center" CellClass="justify-center text-center">
                <CellTemplate Context="wiersz">
                    <div class="w-100" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        @wiersz.Item.DataRozpoczeciaPlanowana.ToString("yyyy-MM-dd")
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="DateTime" Property="x => x.DataZakonczeniaPlanowana" Title="Plan. Koniec" Format="yyyy-MM-dd" Width="100px" HeaderClass="justify-center" CellClass="justify-center text-center">
                <CellTemplate Context="wiersz">
                    <div class="w-100" @onclick="@(() => WybierzWiersz(wiersz.Item))" style="cursor:pointer;">
                        @wiersz.Item.DataZakonczeniaPlanowana.ToString("yyyy-MM-dd")
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="decimal" Property="x => x.KosztCalkowityRobocizny" Title="Robocizna" Width="100px" HeaderClass="justify-end" CellClass="text-end fw-bold text-secondary">
                <CellTemplate Context="wiersz">
                    @wiersz.Item.KosztCalkowityRobocizny.ToString("N2") zł
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="decimal" Property="x => x.Materialy.Sum(m => m.WartoscCalkowita)" Title="Materiały" Width="100px" HeaderClass="justify-end" CellClass="text-end fw-bold text-muted">
                <CellTemplate Context="wiersz">
                    @((wiersz.Item.Materialy?.Sum(m => m.WartoscCalkowita) ?? 0).ToString("N2")) zł
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="PraceRemontowe" TProperty="decimal"
                            Property="x => x.KosztCalkowityRobocizny + (x.Materialy != null ? x.Materialy.Sum(m => m.WartoscCalkowita) : 0)"
                            Title="Razem"
                            Width="100px"
                            HeaderClass="justify-end"
                            CellClass="text-end fw-bold text-primary bg-light-strip">
                <CellTemplate Context="wiersz">
                    @{
                        var sumaRobocizny = wiersz.Item.KosztCalkowityRobocizny;
                        var sumaMaterialow = wiersz.Item.Materialy?.Sum(m => m.WartoscCalkowita) ?? 0;
                        var lacznie = sumaRobocizny + sumaMaterialow;
                    }
                    <span class="text-primary" style="font-size: 0.9rem;">
                        @lacznie.ToString("N2") zł
                    </span>
                </CellTemplate>
            </PropertyColumn>
        </GridColumns>
    </FGrid>
}
else
{
    @* --- WIDOK 2: NATIVE KANBAN BOARD --- *@
    <MudPaper Elevation="1" Class="pa-4 rounded-lg bg-light bg-opacity-50">

        @* Nagłówek i filtry widoku Kanban *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 flex-wrap gap-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-grow-1 flex-wrap">
                <MudText Typo="Typo.h6" Color="Color.Default" Class="fw-bold">Tablica Kanban</MudText>

                @* Klony selektorów filtrowania dla zachowania spójności stanów *@
                <MudSelect T="int?" Label="Budynek" Value="@FiltreObiektId" ValueChanged="OnObiektFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:180px; background-color: white;" Clearable="true">
                    <MudSelectItem T="int?" Value="@null">Wszystkie budynki</MudSelectItem>
                    @foreach (var ob in ListaObiektow)
                    {
                        <MudSelectItem T="int?" Value="@ob.Id">@ob.Nazwa</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?" Label="Typ / Branża" Value="@FiltreRodzajId" ValueChanged="OnRodzajFilterChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:180px; background-color: white;" Clearable="true">
                    <MudSelectItem T="int?" Value="@null">Wszystkie </MudSelectItem>
                    @foreach (var def in ListaRodzajow)
                    {
                        <MudSelectItem T="int?" Value="@def.Id">@def.Nazwa</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudToggleGroup T="bool" Value="CzyWidokKanban" ValueChanged="OnWidokChanged" Color="Color.Default" Size="Size.Small" Dense="true">
                    <MudToggleItem Value="false"><MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" /> Lista</MudToggleItem>
                    <MudToggleItem Value="true"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Kanban</MudToggleItem>
                </MudToggleGroup>

                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small" OnClick="OpenCreateDialog">
                    Dodaj
                </MudButton>

                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RefreshGridAsync" Title="Odśwież" />
            </MudStack>
        </MudStack>

        @* Kontener Drag & Drop *@
        <MudDropContainer T="PraceRemontowe"
                          Items="@ListaPrac"
                          ItemsSelector="@((item, column) => item.Status == column)"
                          ItemDropped="ObslugaPrzeniesieniaKartyKanban"
                          Class="d-flex flex-row gap-3 w-100 overflow-x-auto pa-1"
                          Style="min-height: 65vh; align-items: stretch;">

            <ChildContent>
                @foreach (var status in OpcjeStatusow)
                {
                    <MudPaper Elevation="0" Width="280px" Class="pa-3 d-flex flex-column rounded-lg" Style="background-color: #f4f5f7; flex-shrink: 0; border: 1px solid #e1e4e8;">

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 px-1">
                            <MudText Typo="Typo.body2" Class="fw-bold text-secondary">@status</MudText>
                            @* ZMIANA: T="string" dla bezbłędnego renderowania wewnętrznego tekstu licznika *@
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="fw-bold px-2 m-0 bg-white border">
                                @ListaPrac.Count(x => x.Status == status)
                            </MudChip>
                        </MudStack>

                        <MudDropZone T="PraceRemontowe" Identifier="@status" Class="d-flex flex-column gap-2 flex-grow-1 rounded" Style="min-height: 450px;" />
                    </MudPaper>
                }
            </ChildContent>

            <ItemRenderer>
                @{
                    var sumaRobocizny = context.KosztCalkowityRobocizny;
                    var sumaMaterialow = context.Materialy?.Sum(m => m.WartoscCalkowita) ?? 0;
                    var lacznyKoszt = sumaRobocizny + sumaMaterialow;
                }
                <MudPaper Elevation="1" Class="pa-3 rounded-lg border-l-4"
                          Style="@($"border-left-color: {GetHexColorDlaStatusu(context.Status)}; cursor: grab; background-color: white; border-top: 1px solid #f1f1f1; border-right: 1px solid #f1f1f1; border-bottom: 1px solid #e2e2e2;")"
                          @onclick="@(() => OpenEditDialog(context))">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2" Class="fw-bold text-dark text-truncate" Style="max-width: 240px;" title="@context.Nazwa">
                            @context.Nazwa
                        </MudText>

                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Spacing="1"
                                  Class="text-muted">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Style="font-size:0.9rem;" />
                            <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 220px;">
                                @(context.Obiekt?.Nazwa ?? "Brak budynku")
                            </MudText>
                        </MudStack>

                        @if (context.RodzajUsterki != null)
                        {
                            <MudText Typo="Typo.caption" Class="text-muted italic px-1 bg-light rounded d-inline-block text-truncate align-self-start" Style="max-width: 240px; font-size: 0.75rem;">
                                @context.RodzajUsterki.Nazwa
                            </MudText>
                        }

                        <MudDivider Class="my-2" />

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="text-muted">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="font-size:0.85rem;" />
                                <MudText Typo="Typo.caption" Style="font-size:0.75rem;">
                                    @context.DataZakonczeniaPlanowana.ToString("MM-dd")
                                </MudText>
                            </MudStack>

                            <MudText Typo="Typo.caption" Class="fw-bold text-primary">
                                @lacznyKoszt.ToString("N0") zł
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </ItemRenderer>

        </MudDropContainer>
    </MudPaper>
}

@* --- MODALE SYSTEMOWE (DODAWANIE / EDYCJA / POTWIERDZENIA) --- *@
<FRemonBudDialog @bind-IsVisible="IsDialogVisible"
                 Model="EdytowanyRemont"
                 ListaObiektow="ListaObiektow"
                 ListaRodzajow="ListaRodzajow"
                 ListaPriorytetow="ListaPriorytetow"
                 OpcjeStatusow="OpcjeStatusow"
                 OnSave="ZazadajPotwierdzeniaZapisu"
                 OnCancel="CloseDialog" />

<PotwierdzenieDialog IsVisible="IsConfirmVisible"
                     Title="@ConfirmTitle"
                     Message="@ConfirmMessage"
                     ThemeClass="@ConfirmTheme"
                     IconClass="@ConfirmIcon"
                     OnAnswer="HandleConfirmationAnswer" />
