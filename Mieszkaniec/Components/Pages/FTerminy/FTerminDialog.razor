@namespace Mieszkaniec.Components.Pages.FTerminy
@using Mieszkaniec.Model.Entities
@using MudBlazor

<MudDialog>
    <TitleContent>
        @* Standardowe, jasne tło z dopasowanymi ciemnymi kolorami napisów *@
        <div class="d-flex align-items-center gap-3 custom-dialog-header">
            <div class="p-2 rounded bg-light border text-primary">
                <i class="bi bi-gear-wide-connected fs-4"></i>
            </div>
            <div>
                <h5 class="m-0 fw-bold text-dark">@(Model.Id == 0 ? "Nowa Definicja" : "Edycja Definicji")</h5>
                <small class="text-muted">Parametry i okresowość przeglądów technicznych</small>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <div class="container-fluid pt-2">
                <div class="row g-3">

                    @* Pole 1: Nazwa Typu Przeglądu *@
                    <div class="col-12">
                        <label class="form-label small fw-bold text-secondary mb-1">Nazwa Typu Przeglądu</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                            <input type="text" class="form-control" @bind="Model.NazwaTypu" placeholder="np. Przegląd Kominiarski" required />
                        </div>
                        <ValidationMessage For="@(() => Model.NazwaTypu)" class="text-danger small mt-1" />
                    </div>

                    @* Pole 2: Częstotliwość *@
                    <div class="col-12">
                        <label class="form-label small fw-bold text-secondary mb-1">Częstotliwość (w miesiącach)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-range"></i></span>
                            <input type="number" class="form-control" @bind="Model.CzestoscMiesiace" min="1" required />
                        </div>
                        <ValidationMessage For="@(() => Model.CzestoscMiesiace)" class="text-danger small mt-1" />
                    </div>

                    @* Pole 3: Dni powiadomienia *@
                    <div class="col-12">
                        <label class="form-label small fw-bold text-secondary mb-1">Wyprzedzenie powiadomienia (dni)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-bell"></i></span>
                            <input type="number" class="form-control" @bind="Model.DniPowiadomienia" min="0" required />
                        </div>
                        <ValidationMessage For="@(() => Model.DniPowiadomienia)" class="text-danger small mt-1" />
                    </div>

                </div>
            </div>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-content-end gap-2 pe-4 pb-3">
            @* Przycisk Anuluj jako czysty komponent MudBlazor *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       Class="border text-dark px-3"
                       OnClick="Cancel">
                Anuluj
            </MudButton>

            @* Przycisk Zapisz jako czysty komponent MudBlazor *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Size="Size.Small"
                       Class="px-4"
                       OnClick="Submit">
                Zapisz
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TerminDefinicja Model { get; set; } = new();

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(Model.NazwaTypu) && Model.CzestoscMiesiace > 0 && Model.DniPowiadomienia >= 0)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

<style>
    /* Przywrócenie domyślnego, ciemniejszego wyglądu systemowego przycisku zamykania */
    ::deep .mud-dialog-title .mud-button-root {
        color: rgba(0, 0, 0, 0.54) !important;
        margin-top: 8px !important;
        margin-right: 8px !important;
        transition: color 0.15s;
    }

        ::deep .mud-dialog-title .mud-button-root:hover {
            color: rgba(0, 0, 0, 0.87) !important;
            background-color: rgba(0, 0, 0, 0.04) !important;
        }
</style>