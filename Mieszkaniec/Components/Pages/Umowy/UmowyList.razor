@page "/umowy"
@attribute [Authorize(Policy = "ZarzadzanieUmowami")]
@inherits UmowyListBase
@using MudBlazor
@using Mieszkaniec.Model.Entities
@using Mieszkaniec.Components.UI

<div class="d-flex flex-column" style="height: calc(100vh - 64px); background-color: #f8fafc;">

    @if (Umowy == null)
    {
        @* Stan ładowania *@
        <div class="flex-grow-1 d-flex flex-column align-center justify-center gap-3">
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="text-muted">Wczytywanie rejestru umów...</MudText>
        </div>
    }
    else
    {
        @* Tabela z danymi *@
        <div class="flex-grow-1 overflow-auto px-4 modern-grid-scroll">
            <FGrid TItem="UmowaNajmu"
                   Items="@Umowy"
                   Title="Rejestr Umów Najmu"
                   ShowToolbar="true"
                   ShowSearch="true"
                   OnAdd="OpenDodajDialog"
                   OnEdit="OpenEdytujDialog">
                <ToolbarLeftContent>
                    <div class="flex-shrink-0 pa-2 pb-0">
                        <div class="d-flex flex-wrap align-center gap-4 mb-2">

                            @* Kafelki ze statystykami *@
                            <div class="d-flex gap-2">
                                <MudPaper Class="pa-2 d-flex flex-column align-center justify-center mud-theme-primary"
                                          Style="width: 150px; height: 60px; border-radius: 8px;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@WszystkieUmowy</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Wszystkie Umowy</MudText>
                                </MudPaper>

                                <MudPaper Class="pa-2 d-flex flex-column align-center justify-center"
                                          Style="background-color: #4caf50; color: white; width: 150px; height: 60px; border-radius: 8px;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@AktywneUmowy</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Aktywne</MudText>
                                </MudPaper>

                                <MudPaper Class="pa-2 d-flex flex-column align-center justify-center"
                                          Style="background-color: #f44336; color: white; width: 150px; height: 60px; border-radius: 8px;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@NieaktywneUmowy</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Archiwalne</MudText>
                                </MudPaper>
                                <MudPaper Class="pa-2 d-flex flex-column align-center justify-center"
                                          Style="background-color: #ff9800; color: white; width: 150px; height: 60px; border-radius: 8px;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@WygasajaceUmowy</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Wygasa (30 dni)</MudText>
                                </MudPaper>
                            </div>

                            @* PRZEŁĄCZNIK FILTRU STATUSU *@
                            <MudPaper Class="pa-2 px-4 d-flex align-items-center" Elevation="0" Style="background-color: transparent; border: 1px solid #e0e0e0; border-radius: 8px; min-width: 250px;">
                                <MudSwitch T="bool"
                                           Value="@PokazTylkoAktywne"
                                           ValueChanged="OnPokazTylkoAktywneChanged"
                                           Color="@(PokazTylkoAktywne ? Color.Success : Color.Error)"
                                           Class="mb-0"
                                           Label="@(PokazTylkoAktywne ? "Wyświetlam: Aktywne" : "Wyświetlam: Archiwalne")" />
                                @if (NajemcaId.HasValue && NajemcaId.Value > 0)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               OnClick="WyczyscFiltrNajemcy"
                                               StartIcon="@Icons.Material.Filled.Clear">
                                        Usuń filtr
                                    </MudButton>
                                }
                            </MudPaper>

                        </div>
                    </div>
                </ToolbarLeftContent>
                <GridColumns>
                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="string" Property="x => x.NumerUmowy" Title="Numer Umowy" />

                    <MudBlazor.TemplateColumn T="UmowaNajmu" Title="Najemca">
                        <CellTemplate Context="ctx">
                            @(ctx.Item?.Najemca?.NazwaFirmyOsoby ?? "-")
                        </CellTemplate>
                    </MudBlazor.TemplateColumn>

                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="DateTime" Property="x => x.DataOd" Title="Od" Format="yyyy-MM-dd" />

                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="DateTime?" Property="x => x.DataDo"  Title="Do">
                        <CellTemplate Context="ctx">
                            @if (ctx.Item.DataDo.HasValue)
                            {
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <span>@ctx.Item.DataDo.Value.ToString("yyyy-MM-dd")</span>

                                    @if (ctx.Item.CzyPrzeterminowana)
                                    {
                                        <span class="badge bg-danger text-white ms-2 px-2 py-1 shadow-sm" style="font-size: 0.75rem; border-radius: 4px;">
                                            Po terminie!
                                      </span>
                                    }
                                    else if (ctx.Item.CzyWygasaWkrotce)
                                    {
                                        <span class="badge bg-warning text-dark ms-2 px-2 py-1 shadow-sm" style="font-size: 0.75rem; border-radius: 4px; font-weight: 600;">
                                            Za @ctx.Item.DniDoKonca dni
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">nieokreślony</span>
                            }
                        </CellTemplate>
                    </MudBlazor.PropertyColumn>

                    @* KOLUMNA METRAŻ *@
                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="decimal" Property="x => x.CalkowitaPowierzchniaM2" Title="Metraż">
                        <CellTemplate Context="ctx">
                            @if (ctx.Item.CalkowitaPowierzchniaM2 > 0)
                            {
                                <span class="text-dark fw-bold">@($"{ctx.Item.CalkowitaPowierzchniaM2:N2} m²")</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </CellTemplate>
                    </MudBlazor.PropertyColumn>

                    @* KOLUMNA AKTUALNY CZYNZ MIESIĘCZNY *@
                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="decimal" Property="x => x.AktualnyCzynszMiesieczny" Title="Czynsz (msc)">
                        <CellTemplate Context="ctx">
                            @if (ctx.Item.AktualnyCzynszMiesieczny > 0)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fw-bold text-success">@($"{ctx.Item.AktualnyCzynszMiesieczny:N2} zł")</span>

                                    @if (ctx.Item.Aneksy != null && ctx.Item.Aneksy.Any(a => a.NowaStawkaCzynszu.HasValue))
                                    {
                                        <MudTooltip Text="Zmieniono aneksem">
                                            <i class="bi bi-arrow-up-right-circle text-warning small"></i>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </CellTemplate>
                    </MudBlazor.PropertyColumn>

                    <MudBlazor.TemplateColumn T="UmowaNajmu" Title="Status">
                        <CellTemplate Context="ctx">
                            <MudChip T="string" Color="@((ctx.Item?.CzyAktywna ?? false) ? Color.Success : Color.Error)" Size="Size.Small">
                                @((ctx.Item?.CzyAktywna ?? false) ? "Aktywna" : "Nieaktywna")
                            </MudChip>
                        </CellTemplate>
                    </MudBlazor.TemplateColumn>

                    <MudBlazor.PropertyColumn T="UmowaNajmu" TProperty="int" Property="x => x.Zalaczniki.Count" Title="Załączniki" Width="100px" HeaderClass="justify-center" CellClass="justify-center text-center">
                        <CellTemplate Context="wiersz">
                            @if (wiersz.Item.Zalaczniki != null && wiersz.Item.Zalaczniki.Any())
                            {
                                <div @onclick:stopPropagation="true" class="d-flex justify-content-center">
                                    <div class="badge bg-light text-danger border p-2 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm hover-primary"
                                         style="cursor: pointer; transition: 0.2s;"
                                         title="Kliknij, aby zobaczyć załączniki"
                                         @onclick="() => PokazZalacznikiDialog(wiersz.Item.Zalaczniki)">
                                        <i class="bi bi-file-earmark-pdf-fill fs-6"></i>
                                        @if (wiersz.Item.Zalaczniki.Count > 1)
                                        {
                                            <span class="fw-bold ms-1" style="font-size: 0.85rem;">@wiersz.Item.Zalaczniki.Count</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </CellTemplate>
                    </MudBlazor.PropertyColumn>

                    <MudBlazor.TemplateColumn T="UmowaNajmu" Width="50px" HeaderClass="justify-center" CellClass="justify-center text-center" title="Szczegóły">
                        <CellTemplate Context="ctx">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           Title="Podgląd szczegółów"
                                           OnClick="@(() => OtworzSzczegoly(ctx.Item))" />
                        </CellTemplate>
                    </MudBlazor.TemplateColumn>

                </GridColumns>
            </FGrid>
        </div>
    }
</div>

<style>
    .modern-grid-scroll .mud-table-container {
        max-height: calc(100vh - 300px) !important;
        min-height: 250px !important;
        overflow-y: auto !important;
    }

    .modern-grid-scroll .mud-table-head {
        position: sticky !important;
        top: 0 !important;
        z-index: 2 !important;
        background-color: #ffffff !important;
    }

    .hover-primary:hover {
        color: #0d6efd !important;
    }

    @@media (max-height: 768px) {
        .modern-grid-scroll .mud-table-container {
            max-height: calc(100vh - 270px) !important;
        }
    }
</style>

@* ========================================== *@
@* BOCZNY PANEL SZCZEGÓŁÓW UMOWY (DRAWER)     *@
@* ========================================== *@
<MudDrawer @bind-Open="@CzyOtwartoSzczegoly" Anchor="Anchor.Right" Elevation="3" Variant="@DrawerVariant.Temporary" Width="450px" Style="background-color: #ffffff;">
    @if (WybranaUmowa != null)
    {
        @* Nagłówek panelu *@
        <div class="pa-4 d-flex align-items-center border-bottom bg-light">
            <div class="bg-white shadow-sm rounded p-2 me-3 border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-file-earmark-text text-primary fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-0" Style="color: #2c3e50;">@WybranaUmowa.NumerUmowy</MudText>
                <small class="text-muted">Szczegółowy podgląd parametrów</small>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="@(() => CzyOtwartoSzczegoly = false)" Size="Size.Small" />
        </div>

        @* Zawartość panelu *@
        <div class="pa-4 overflow-auto" style="height: calc(100vh - 75px);">

            @* SEKCJA 1: GŁÓWNE PARAMETRY *@
            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold text-secondary text-uppercase" Style="letter-spacing: 0.5px;">Dane podstawowe</MudText>
                <MudPaper Variant="Variant.Outlined" Class="pa-3 mt-1 bg-light border-light shadow-sm">
                    <div class="mb-2">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Najemca / Kontrahent</small>
                        <span class="fw-bold text-dark">@(WybranaUmowa.Najemca?.NazwaFirmyOsoby ?? "-")</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Data rozpoczęcia</small>
                            <span class="small fw-bold"><i class="bi bi-calendar-check me-1 text-success"></i> @WybranaUmowa.DataOd.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Data zakończenia</small>
                            <span class="small fw-bold">
                                @if (WybranaUmowa.DataDo.HasValue)
                                {
                                    <i class="bi bi-calendar-x me-1 text-danger"></i>
                                    @WybranaUmowa.DataDo.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">nieokreślony</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                        <small class="text-muted">Status systemowy</small>
                        <MudChip T="string" Color="@(WybranaUmowa.CzyAktywna? Color.Success: Color.Error)" Size="Size.Small" Class="ma-0">
                            @(WybranaUmowa.CzyAktywna ? "Umowa Aktywna" : "Archiwalna")
                        </MudChip>
                    </div>
                </MudPaper>
            </div>

            @* NOWA SEKCJA: WYNAJMOWANE POMIESZCZENIA (DYNAMICZNY PODGLĄD) *@
            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold text-secondary text-uppercase" Style="letter-spacing: 0.5px;">Wynajmowane lokale (@(WybranaUmowa.WynajmowaneLokale?.Count ?? 0))</MudText>
                <div class="mt-1">
                    @if (WybranaUmowa.WynajmowaneLokale != null && WybranaUmowa.WynajmowaneLokale.Any())
                    {
                        @foreach (var rl in WybranaUmowa.WynajmowaneLokale)
                        {
                            <div class="p-2 mb-2 bg-white border rounded shadow-sm d-flex justify-content-between align-items-center" style="font-size: 0.85rem;">
                                <div>
                                    <span class="fw-bold text-primary">Lokal @(rl.LokalWynajem?.NumerLokalu ?? "-")</span>
                                    <small class="text-muted d-block">@(rl.LokalWynajem?.TypLokalu ?? "LokWyn") • @($"{rl.LokalWynajem?.PowierzchniaM2:N2} m²")</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-success">@($"{rl.WynegocjowanaCenaZaM2:N2} zł")</span>
                                    <small class="text-muted d-block">@(rl.CzyRyczalt ? "ryczałt" : "za m²")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small fst-italic py-2 border-dashed rounded text-center bg-light">Brak przypisanych lokali.</div>
                    }
                </div>
            </div>

            @* SEKCJA 3: SKANY I ZAŁĄCZNIKI *@
            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold text-secondary text-uppercase" Style="letter-spacing: 0.5px;">Dokumentacja i Skany (@(WybranaUmowa.Zalaczniki?.Count ?? 0))</MudText>
                <div class="mt-1">
                    @if (WybranaUmowa.Zalaczniki != null && WybranaUmowa.Zalaczniki.Any())
                    {
                        @foreach (var zal in WybranaUmowa.Zalaczniki)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 mb-2 bg-white border rounded shadow-sm hover-light" style="font-size: 0.85rem;">
                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-5 flex-shrink-0"></i>
                                    <span class="text-truncate" title="@zal.NazwaPliku">@zal.NazwaPliku</span>
                                </div>
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           OnClick="@(() => PodgladPlikuPdf(zal.NazwaPliku))" Class="text-none flex-shrink-0 ms-2">
                                    Otwórz
                                </MudButton>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small fst-italic py-2 border-dashed rounded text-center bg-light">Brak wgranych załączników.</div>
                    }
                </div>
            </div>

            @* SEKCJA 4: HISTORIA ANEKSÓW *@
            <div class="mb-2">
                <MudText Typo="Typo.caption" Class="fw-bold text-secondary text-uppercase" Style="letter-spacing: 0.5px;">Rejestr Aneksów (@(WybranaUmowa.Aneksy?.Count ?? 0))</MudText>
                <div class="mt-1">
                    @if (WybranaUmowa.Aneksy != null && WybranaUmowa.Aneksy.Any())
                    {
                        @foreach (var aneks in WybranaUmowa.Aneksy.OrderByDescending(a => a.DataZawarcia))
                        {
                            <div class="p-3 mb-2 bg-white border rounded shadow-sm">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <span class="fw-bold text-primary" style="font-size: 0.9rem;">Aneks nr @aneks.NumerAneksu</span>
                                    <span class="text-muted small">@aneks.DataZawarcia.ToShortDateString()</span>
                                </div>
                                <div class="small text-dark mb-1">
                                    <b>Nowa stawka:</b> @(aneks.NowaStawkaCzynszu.HasValue ? $"{aneks.NowaStawkaCzynszu:N2} zł" : "-")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(aneks.OpisZmian))
                                {
                                    <div class="text-muted fst-italic border-top pt-1 mt-1" style="font-size: 0.78rem;">
                                        @aneks.OpisZmian
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small fst-italic py-2 border-dashed rounded text-center bg-light">Do tej umowy nie dodano jeszcze żadnych aneksów.</div>
                    }
                </div>
            </div>

        </div>
    }
</MudDrawer>
