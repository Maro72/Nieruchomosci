 *@
<div class="modern-grid-scroll">
    <FGrid TItem="Najemca"
           Items="@FiltrowaniNajemcy"
           Title="Wykaz Najemców"
           ShowToolbar="true"
           ShowSearch="false"
           OnEdit="OpenEdytujDialog"
           OnAdd="OpenDodajDialog">
        <ToolbarLeftContent>
            <div class="d-flex align-items-center gap-2 flex-wrap ms-3">

                <MudSelect T="string" Label="Pokazuj firmy" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Value="@WybranyWidok" ValueChanged="OnWidokChanged"
                           Style="width: 320px; background-color: white;">
                    <MudSelectItem Value="@("Aktywni")">Tylko aktywni</MudSelectItem>
                    <MudSelectItem Value="@("Archiwum")">Archiwum (byli dzierżawcy)</MudSelectItem>
                </MudSelect>

                <MudTooltip Text="Odśwież listę">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   OnClick="OdswiezListew" />
                </MudTooltip>

                
               
            </div>
        </ToolbarLeftContent>

        @* --- PRZEŁĄCZNIK WIDOKU + REFRESH (W SEKCJI EXTRAACTIONS) --- *@
       
        <GridColumns>
            <MudBlazor.PropertyColumn T="Najemca" TProperty="string" Property="x => x.NazwaFirmyOsoby" Title="Nazwa firmy / Kontrahent" />
            <MudBlazor.PropertyColumn T="Najemca" TProperty="string" Property="x => x.OsobaKontaktowa" Title="Osoba kontaktowa" />
            <MudBlazor.PropertyColumn T="Najemca" TProperty="string" Property="x => x.Telefon" Title="Telefon" />
            <MudBlazor.PropertyColumn T="Najemca" TProperty="string" Property="x => x.Email" Title="E-mail" />

            <MudBlazor.TemplateColumn T="Najemca" Title="Status">
                <CellTemplate Context="ctx">
                    @if (ctx.Item.CzyArchiwalny)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">Archiwum</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Aktywny</MudChip>
                    }
                </CellTemplate>
            </MudBlazor.TemplateColumn>

            <MudBlazor.TemplateColumn T="Najemca" Title="Akcje">
                <CellTemplate Context="ctx">
                    <div class="d-flex gap-1">
                        <MudTooltip Text="Dane najemcy">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenPodgladDialog(ctx.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Umowy najemcy">
                            <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Secondary" Href="@($"/umowy?najemcaId={ctx.Item.Id}")" />
                        </MudTooltip>
                        @if (!ctx.Item.CzyArchiwalny)
                        {
                            <MudTooltip Text="Przenieś do archiwum">
                                <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Warning" OnClick="@(() => ZarchiwizujNajemce(ctx.Item))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Przywróć z archiwum">
                                <MudIconButton Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" Color="Color.Success" OnClick="@(() => PrzywrocNajemce(ctx.Item))" />
                            </MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </MudBlazor.TemplateColumn>
        </GridColumns>
    </FGrid>
</div>
<style>
    /* Ponieważ uwalniamy górną przestrzeń, możemy powiększyć wysokość samej tabeli */
    .modern-grid-scroll .mud-table-container {
        max-height: calc(100vh - 300px) !important;
        min-height: 250px !important;
        overflow-y: auto !important;
    }

    .modern-grid-scroll .mud-table-head {
        position: sticky !important;
        top: 0 !important;
        z-index: 2 !important;
        background-color: #ffffff !important;
    }

    @@media (max-height: 768px) {
        .modern-grid-scroll .mud-table-container {
            max-height: calc(100vh - 270px) !important;
        }
    }

</style>
